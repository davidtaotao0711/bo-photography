---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean;
}

const {
  title = `${site.name} — Photography`,
  description = `${site.tagline} Photography by ${site.name}, based in ${site.location}.`,
  transparentHeader = false,
} = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showBackToTop = normalizedPath !== '/' && normalizedPath !== '/editor';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body id="top">
    <Header transparent={transparentHeader} />
    <main><slot /></main>
    {showBackToTop && <BackToTop />}
    <Footer />
  </body>
</html>
