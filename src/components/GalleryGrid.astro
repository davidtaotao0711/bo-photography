---
import PhotoCard from './PhotoCard.astro';
import { normalizeCollageLayout } from '../utils/collage-layout.js';

interface Props {
  photos: any[];
  class?: string;
  reveal?: boolean;
}

const { photos, class: className, reveal = true } = Astro.props;
---

<div class:list={['collage-gallery', className]} data-masonry-gallery>
  {photos.map((photo, index) => (
    <PhotoCard
      photo={photo}
      eager={index < 3}
      layoutScope="none"
      layout={normalizeCollageLayout(photo)}
      collage
      reveal={reveal}
    />
  ))}
</div>

<script>
  const mobileLayout = window.matchMedia('(max-width: 720px)');

  function packGallery(gallery) {
    const cards = Array.from(gallery.querySelectorAll(':scope > .photo-card'));
    cards.forEach((card) => card.style.removeProperty('grid-row-end'));

    if (mobileLayout.matches) {
      gallery.classList.add('is-packed');
      return;
    }

    void gallery.offsetWidth;
    // The editor reserves a small control area below each photograph. Reserve
    // the same footprint here so its saved 12-column composition packs into
    // the exact same grid cells on the public pages.
    const editorChrome = Number.parseFloat(getComputedStyle(gallery).getPropertyValue('--gallery-editor-chrome')) || 0;
    const rowSize = Number.parseFloat(getComputedStyle(gallery).gridAutoRows) || 1;
    const rowSpans = cards.map((card) => Math.max(1, Math.ceil((card.offsetHeight + editorChrome) / rowSize)));
    cards.forEach((card, index) => {
      card.style.gridRowEnd = `span ${rowSpans[index]}`;
    });
    gallery.classList.add('is-packed');
  }

  function setupGallery(gallery) {
    const cards = Array.from(gallery.querySelectorAll(':scope > .photo-card'));
    let frame = 0;
    let debounceTimer = 0;
    let lastWidth = Math.round(gallery.getBoundingClientRect().width);
    let lastBreakpoint = mobileLayout.matches ? 'mobile' : 'desktop';
    const schedule = (debounced = false) => {
      window.cancelAnimationFrame(frame);
      window.clearTimeout(debounceTimer);
      const run = () => {
        frame = window.requestAnimationFrame(() => packGallery(gallery));
      };
      if (debounced) debounceTimer = window.setTimeout(run, 120);
      else run();
    };

    const resizeObserver = new ResizeObserver((entries) => {
      let shouldRepack = false;
      entries.forEach((entry) => {
        if (entry.target === gallery) {
          const width = Math.round(entry.contentRect.width);
          if (width === lastWidth) return;
          lastWidth = width;
        }
        shouldRepack = true;
      });
      if (shouldRepack) schedule(true);
    });
    resizeObserver.observe(gallery);
    cards.forEach((card) => resizeObserver.observe(card));
    gallery.querySelectorAll('img').forEach((image) => {
      if (image.complete || image.dataset.masonryBound === 'true') return;
      image.dataset.masonryBound = 'true';
      image.addEventListener('load', () => schedule(), { once: true });
      image.addEventListener('error', () => schedule(), { once: true });
    });
    const onBreakpointChange = () => {
      const nextBreakpoint = mobileLayout.matches ? 'mobile' : 'desktop';
      if (nextBreakpoint === lastBreakpoint) return;
      lastBreakpoint = nextBreakpoint;
      schedule(true);
    };
    mobileLayout.addEventListener('change', onBreakpointChange);
    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frame);
      window.clearTimeout(debounceTimer);
      resizeObserver.disconnect();
      mobileLayout.removeEventListener('change', onBreakpointChange);
    }, { once: true });
    schedule();
  }

  function initializeGalleries() {
    document.querySelectorAll('[data-masonry-gallery]:not([data-masonry-ready])').forEach((gallery) => {
      gallery.setAttribute('data-masonry-ready', 'true');
      setupGallery(gallery);
    });
  }

  initializeGalleries();
  document.addEventListener('astro:page-load', initializeGalleries);
</script>
