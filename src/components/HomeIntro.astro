---
import ResponsiveImage from './ResponsiveImage.astro';

interface IntroImage {
  src: string;
  mobileSrc?: string;
  mobileSrcset?: string;
  alt: string;
}

interface Props {
  images: IntroImage[];
  name: string;
  tagline: string;
}

const { images, name, tagline } = Astro.props;
---

<section
  class="home-intro"
  data-home-intro
  data-state="pending"
  aria-label={`${name} photography introduction`}
>
  <div class="home-intro__images" aria-hidden="true">
    {images.map((image, index) => (
      <div class:list={['home-intro__slide', { 'is-active': index === 0 }]} data-intro-slide>
        <ResponsiveImage
          src={image.src}
          mobileSrc={image.mobileSrc}
          mobileSrcset={image.mobileSrcset}
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          sizes="100vw"
          defer={index > 0}
        />
      </div>
    ))}
  </div>

  <div class="home-intro__wash"></div>

  <div class="home-intro__dots" role="group" aria-label="Intro image navigation">
    {images.map((_, index) => (
      <button
        class:list={['home-intro__dot', { 'is-active': index === 0 }]}
        type="button"
        data-intro-dot
        data-slide-index={index}
        aria-label={`Show intro image ${index + 1}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <span aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div class="home-intro__content">
    <div class="home-intro__identity">
      <p class="home-intro__name">{name}</p>
      <h1>{tagline}</h1>
    </div>

    <button class="home-intro__enter" type="button" data-intro-enter>
      <span>Enter</span>
    </button>
  </div>
</section>

<noscript>
  <style>html { overflow: auto !important; }</style>
</noscript>

<script>
  const FIRST_SLIDE_DELAY = 3500;
  const SLIDE_INTERVAL = 5500;
  const ENTER_SCROLL_DURATION = 820;
  const WHEEL_THRESHOLD = 48;
  const SWIPE_THRESHOLD = 44;
  const SEEN_KEY = 'boHomeIntroSeen';
  const isHomePath = () => (window.location.pathname.replace(/\/+$/, '') || '/') === '/';
  const HOME_INTRO_CLEANUP_KEY = '__boHomeIntroCleanup';
  const HOME_INTRO_INIT_KEY = '__boHomeIntroInitialize';
  const HOME_INTRO_PAGESHOW_KEY = '__boHomeIntroPageshow';
  const HOME_INTRO_PAGELOAD_KEY = '__boHomeIntroPageload';

  const releaseStaleHomeLock = () => {
    document.documentElement.classList.remove('home-intro-locked');
    if ('scrollRestoration' in history && history.scrollRestoration === 'manual') {
      history.scrollRestoration = 'auto';
    }
  };

  const getSeenState = () => {
    try {
      return window.localStorage.getItem(SEEN_KEY) === 'true';
    } catch {
      return false;
    }
  };

  const markIntroSeen = () => {
    try {
      window.localStorage.setItem(SEEN_KEY, 'true');
    } catch {
      // Private browsing may deny localStorage; the current visit still works.
    }
  };

  const clearIntroSeen = () => {
    try {
      window.localStorage.removeItem(SEEN_KEY);
    } catch {
      // Ignore storage restrictions and let the replay navigation continue.
    }
  };

  const runExistingHomeCleanup = () => {
    const existingCleanup = window[HOME_INTRO_CLEANUP_KEY];
    if (typeof existingCleanup === 'function') existingCleanup();
    delete window[HOME_INTRO_CLEANUP_KEY];
  };

  const initializeHomeIntro = () => {
    if (!isHomePath()) {
      runExistingHomeCleanup();
      releaseStaleHomeLock();
      return;
    }

    const intro = document.querySelector('[data-home-intro]');
    if (!(intro instanceof HTMLElement)) return;
    if (intro.dataset.ready === 'true') return;

    runExistingHomeCleanup();

    const replayRequested = new URLSearchParams(window.location.search).get('replay') === '1';
    if (replayRequested) {
      clearIntroSeen();
      window.history.replaceState({}, '', `${window.location.pathname}${window.location.hash}`);
    }

    intro.dataset.ready = 'true';

    const root = document.documentElement;
    const enter = intro.querySelector('[data-intro-enter]');
    const slides = Array.from(intro.querySelectorAll('[data-intro-slide]'));
    const dots = Array.from(intro.querySelectorAll('[data-intro-dot]'));
    const selectedWork = document.querySelector('#selected-work');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!replayRequested && getSeenState()) {
      intro.dataset.state = 'dismissed';
      releaseStaleHomeLock();

      if (!window.location.hash && window.scrollY < 2 && selectedWork) {
        window.requestAnimationFrame(() => {
          if (window.scrollY < 2) selectedWork.scrollIntoView({ block: 'start', behavior: 'auto' });
        });
      }
      return;
    }

    intro.dataset.state = 'locked';
    let activeIndex = 0;
    let rotationId;
    let manualTransitionId;
    let enterScrollFrameId;
    let disposed = false;
    let isEntering = false;
    let wheelDistance = 0;
    let touchStartY = null;
    const interactionController = new AbortController();
    const previousScrollRestoration = 'scrollRestoration' in history
      ? history.scrollRestoration
      : null;

    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
    root.classList.add('home-intro-locked');

    const ensureSlideLoaded = (slide) => {
      if (!slide || slide.dataset.imageLoaded === 'true') return;
      slide.querySelectorAll('source[data-srcset]').forEach((source) => {
        source.setAttribute('srcset', source.dataset.srcset || '');
        source.removeAttribute('data-srcset');
      });
      slide.querySelectorAll('img[data-src]').forEach((image) => {
        image.setAttribute('src', image.dataset.src || '');
        image.removeAttribute('data-src');
      });
      slide.dataset.imageLoaded = 'true';
    };

    const showSlide = (nextIndex, immediate = false) => {
      if (nextIndex < 0 || nextIndex >= slides.length) return;
      ensureSlideLoaded(slides[nextIndex]);

      if (immediate && nextIndex !== activeIndex) {
        if (manualTransitionId) window.clearTimeout(manualTransitionId);
        intro.classList.add('is-manual-switch');
        manualTransitionId = window.setTimeout(() => {
          intro.classList.remove('is-manual-switch');
          manualTransitionId = undefined;
        }, 650);
      }

      slides[activeIndex]?.classList.remove('is-active');
      dots[activeIndex]?.classList.remove('is-active');
      dots[activeIndex]?.setAttribute('aria-pressed', 'false');

      activeIndex = nextIndex;

      slides[activeIndex]?.classList.add('is-active');
      dots[activeIndex]?.classList.add('is-active');
      dots[activeIndex]?.setAttribute('aria-pressed', 'true');
    };

    const clearRotation = () => {
      if (!rotationId) return;
      window.clearTimeout(rotationId);
      rotationId = undefined;
    };

    const releaseScrollLock = () => {
      root.classList.remove('home-intro-locked');
      if (previousScrollRestoration !== null && 'scrollRestoration' in history) {
        history.scrollRestoration = previousScrollRestoration;
      }
    };

    const completeIntro = () => {
      intro.dataset.state = 'dismissed';
      intro.classList.remove('is-entering');
    };

    const cleanupHomeIntro = () => {
      if (disposed) return;
      disposed = true;
      clearRotation();
      if (manualTransitionId) window.clearTimeout(manualTransitionId);
      if (enterScrollFrameId) window.cancelAnimationFrame(enterScrollFrameId);
      interactionController.abort();
      intro.classList.remove('is-manual-switch');
      intro.dataset.ready = 'false';
      releaseScrollLock();
      window.removeEventListener('pagehide', cleanupHomeIntro);
      document.removeEventListener('astro:before-swap', cleanupHomeIntro);
      if (window[HOME_INTRO_CLEANUP_KEY] === cleanupHomeIntro) {
        delete window[HOME_INTRO_CLEANUP_KEY];
      }
    };

    window[HOME_INTRO_CLEANUP_KEY] = cleanupHomeIntro;
    window.addEventListener('pagehide', cleanupHomeIntro);
    document.addEventListener('astro:before-swap', cleanupHomeIntro);
    document.addEventListener('astro:page-load', initializeHomeIntro);

    const scheduleNextSlide = (delay) => {
      clearRotation();
      if (reduceMotion || slides.length < 2 || intro.dataset.state !== 'locked') return;

      rotationId = window.setTimeout(() => {
        showSlide((activeIndex + 1) % slides.length);
        scheduleNextSlide(SLIDE_INTERVAL);
      }, delay);
    };

    const enterIntro = () => {
      if (disposed || isEntering || intro.dataset.state !== 'locked') return;
      isEntering = true;
      markIntroSeen();
      clearRotation();
      if (manualTransitionId) window.clearTimeout(manualTransitionId);
      interactionController.abort();
      intro.dataset.state = 'entering';
      intro.classList.add('is-entering');

      const targetTop = selectedWork
        ? selectedWork.getBoundingClientRect().top + window.scrollY
        : 0;
      releaseScrollLock();

      if (reduceMotion || !selectedWork) {
        window.scrollTo({ top: targetTop, left: 0, behavior: 'auto' });
        completeIntro();
        return;
      }

      const startTop = window.scrollY;
      const distance = targetTop - startTop;
      const startedAt = performance.now();
      const previousScrollBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';

      const scrollFrame = (now) => {
        if (disposed || !isHomePath()) return;
        const progress = Math.min((now - startedAt) / ENTER_SCROLL_DURATION, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        window.scrollTo(0, startTop + distance * eased);

        if (progress < 1) {
          enterScrollFrameId = window.requestAnimationFrame(scrollFrame);
        } else {
          enterScrollFrameId = undefined;
          root.style.scrollBehavior = previousScrollBehavior;
          completeIntro();
        }
      };

      enterScrollFrameId = window.requestAnimationFrame(scrollFrame);
    };

    const onWheel = (event) => {
      if (intro.dataset.state !== 'locked') return;
      event.preventDefault();
      if (event.deltaY <= 0) {
        wheelDistance = 0;
        return;
      }
      wheelDistance += event.deltaY;
      if (wheelDistance >= WHEEL_THRESHOLD) enterIntro();
    };

    const onTouchStart = (event) => {
      if (intro.dataset.state === 'locked') touchStartY = event.touches[0]?.clientY ?? null;
    };

    const onTouchMove = (event) => {
      if (intro.dataset.state === 'locked') event.preventDefault();
    };

    const onTouchEnd = (event) => {
      if (intro.dataset.state !== 'locked' || touchStartY === null) return;
      const endY = event.changedTouches[0]?.clientY ?? touchStartY;
      const distance = touchStartY - endY;
      touchStartY = null;
      if (distance > SWIPE_THRESHOLD) {
        event.preventDefault();
        enterIntro();
      }
    };

    const onKeyDown = (event) => {
      if (intro.dataset.state !== 'locked') return;
      const shouldEnter = event.key === 'ArrowDown'
        || event.key === 'PageDown'
        || event.key === 'Enter'
        || event.code === 'Space';
      if (!shouldEnter) return;
      event.preventDefault();
      enterIntro();
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const nextIndex = Number(dot.getAttribute('data-slide-index'));
        if (!Number.isInteger(nextIndex)) return;
        showSlide(nextIndex, true);
        scheduleNextSlide(SLIDE_INTERVAL);
      }, { signal: interactionController.signal });
    });

    enter?.addEventListener('click', enterIntro, { signal: interactionController.signal });
    window.addEventListener('wheel', onWheel, { passive: false, signal: interactionController.signal });
    window.addEventListener('touchstart', onTouchStart, { passive: true, signal: interactionController.signal });
    window.addEventListener('touchmove', onTouchMove, { passive: false, signal: interactionController.signal });
    window.addEventListener('touchend', onTouchEnd, { passive: false, signal: interactionController.signal });
    window.addEventListener('keydown', onKeyDown, { signal: interactionController.signal });
    scheduleNextSlide(FIRST_SLIDE_DELAY);
  };

  window[HOME_INTRO_INIT_KEY] = initializeHomeIntro;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHomeIntro, { once: true });
  } else {
    initializeHomeIntro();
  }

  if (!window[HOME_INTRO_PAGESHOW_KEY]) {
    window[HOME_INTRO_PAGESHOW_KEY] = () => {
      const initialize = window[HOME_INTRO_INIT_KEY];
      if (typeof initialize === 'function') initialize();
      else releaseStaleHomeLock();
    };
    window.addEventListener('pageshow', window[HOME_INTRO_PAGESHOW_KEY]);
  }

  if (!window[HOME_INTRO_PAGELOAD_KEY]) {
    window[HOME_INTRO_PAGELOAD_KEY] = () => {
      const initialize = window[HOME_INTRO_INIT_KEY];
      if (typeof initialize === 'function') initialize();
    };
    document.addEventListener('astro:page-load', window[HOME_INTRO_PAGELOAD_KEY]);
  }
</script>

<style>
  :global(html:has(.home-intro[data-state='locked'])),
  :global(html.home-intro-locked) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(body:has(.home-intro[data-state='locked'])) {
    height: 100svh;
    overflow: hidden;
  }

  :global(.site-header--overlay) {
    z-index: 40;
    pointer-events: auto;
  }

  .home-intro {
    min-height: 100vh;
    height: 100svh;
    position: relative;
    overflow: hidden;
    color: #fff;
    background: #161615;
    transition: opacity 820ms cubic-bezier(.22, .61, .36, 1);
  }

  .home-intro[data-state='entering'],
  .home-intro[data-state='dismissed'] {
    opacity: 0;
    pointer-events: none;
  }

  .home-intro__images,
  .home-intro__slide,
  .home-intro__slide :global(.responsive-image),
  .home-intro__slide :global(img),
  .home-intro__wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-intro__images {
    z-index: 1;
    pointer-events: none;
  }

  .home-intro__slide {
    opacity: 0;
    transition: opacity 4500ms cubic-bezier(.22, .61, .36, 1);
  }

  .home-intro__slide.is-active {
    opacity: 1;
  }

  .home-intro.is-manual-switch .home-intro__slide {
    transition-duration: 550ms;
  }

  .home-intro__slide :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .home-intro__wash {
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, .24), transparent 28%),
      linear-gradient(0deg, rgba(0, 0, 0, .42), transparent 45%);
  }

  .home-intro__content {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 8rem var(--pad) clamp(2rem, 5vw, 4.5rem);
    pointer-events: none;
  }

  .home-intro__dots {
    position: absolute;
    left: clamp(1.5rem, 3vw, 3rem);
    top: 50%;
    z-index: 31;
    display: flex;
    flex-direction: column;
    transform: translateY(-50%);
    pointer-events: auto;
  }

  .home-intro__dot {
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .home-intro__dot span {
    width: .25rem;
    height: .25rem;
    display: block;
    border-radius: 50%;
    background: currentColor;
    opacity: .34;
    transform: scale(.78);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .home-intro__dot:hover span,
  .home-intro__dot:focus-visible span {
    opacity: .68;
  }

  .home-intro__dot.is-active span {
    opacity: .92;
    transform: scale(1);
  }

  .home-intro__dot:focus-visible {
    outline: 1px solid rgba(255, 255, 255, .7);
    outline-offset: -3px;
  }

  .home-intro__identity {
    max-width: min(48rem, 76vw);
  }

  .home-intro__name {
    margin-bottom: 1.15rem;
    font-size: .66rem;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: .19em;
  }

  .home-intro h1 {
    max-width: 11ch;
    font-family: var(--serif);
    font-size: clamp(3rem, 6.4vw, 6.75rem);
    font-weight: 400;
    line-height: .94;
    letter-spacing: -.035em;
  }

  .home-intro__enter {
    flex: 0 0 auto;
    padding: .7rem 0 .55rem;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .72);
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .2em;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 220ms ease, border-color 220ms ease;
  }

  .home-intro__enter:hover,
  .home-intro__enter:focus-visible {
    opacity: .64;
    border-color: currentColor;
  }

  .home-intro__enter:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: .65rem;
  }

  @media (max-width: 720px) {
    .home-intro__slide :global(.responsive-image),
    .home-intro__slide :global(img) {
      width: 100%;
      height: 100svh;
    }

    .home-intro__slide :global(img) {
      object-fit: cover;
      object-position: center center;
    }

    .home-intro__content {
      align-items: flex-start;
      flex-direction: column;
      justify-content: flex-end;
      padding: 7rem var(--pad) 2rem;
    }

    .home-intro__identity {
      max-width: 100%;
    }

    .home-intro h1 {
      font-size: clamp(3.1rem, 15vw, 5rem);
    }

    .home-intro__enter {
      margin-top: 1rem;
      align-self: flex-end;
    }

    .home-intro__dots {
      left: max(.65rem, env(safe-area-inset-left));
    }

    .home-intro__dot {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      transition: none;
    }

    .home-intro__slide {
      transition: none;
    }
  }
</style>
