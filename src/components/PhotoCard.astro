---
import ResponsiveImage from './ResponsiveImage.astro';
import { getResponsiveImage } from '../utils/responsive-image.js';
import { getPhotoCaption, getPhotoTitle } from '../utils/photo-metadata.js';

interface Photo {
  id: string;
  title: string;
  image: string;
  alt: string;
  orientation: string;
  location: string;
  layoutWidth?: number;
  layoutOffsetX?: number;
  layoutOffsetY?: number;
  categoryLayoutWidth?: number;
  categoryLayoutOffsetX?: number;
  categoryLayoutOffsetY?: number;
  homeTitle?: string;
  homeCaption?: string;
  captionText?: string;
}
interface CollageLayout {
  colSpan: number;
  rowSpan: number;
  ratio?: number | null;
  fit: 'cover' | 'contain';
  crop: boolean;
  focalX: number;
  focalY: number;
}
interface Props {
  photo: Photo;
  eager?: boolean;
  layoutScope?: 'home' | 'category' | 'none';
  reveal?: boolean;
  homeCaptionMode?: boolean;
  collage?: boolean;
  layout?: CollageLayout;
}
const {
  photo,
  eager = false,
  layoutScope = 'home',
  reveal = false,
  homeCaptionMode = false,
  collage = false,
  layout,
} = Astro.props;
const photoTitle = getPhotoTitle(photo);
const explicitHomeTitle = getPhotoTitle({ title: photo.homeTitle });
const homeTitle = explicitHomeTitle || photoTitle;
const homeCaption = getPhotoCaption(photo);
const hasHomeCaption = Boolean(homeTitle || homeCaption);
const accessibleTitle = homeTitle || photoTitle;
const responsiveMeta = getResponsiveImage(photo.image);
const naturalAspect = responsiveMeta?.width && responsiveMeta?.height
  ? `${responsiveMeta.width} / ${responsiveMeta.height}`
  : '4 / 3';
const imageSizes = photo.orientation === 'portrait'
  ? '(max-width: 720px) 78vw, (max-width: 1100px) 42vw, 32vw'
  : '(max-width: 720px) 100vw, (max-width: 1100px) 62vw, 56vw';
const widthValue = layoutScope === 'category' ? photo.categoryLayoutWidth : photo.layoutWidth;
const offsetXValue = layoutScope === 'category' ? photo.categoryLayoutOffsetX : photo.layoutOffsetX;
const offsetYValue = layoutScope === 'category' ? photo.categoryLayoutOffsetY : photo.layoutOffsetY;
const layoutWidth = Number.isFinite(widthValue)
  ? Math.min(200, Math.max(45, Number(widthValue)))
  : null;
const offsetX = Number.isFinite(offsetXValue) ? Math.min(80, Math.max(-80, Number(offsetXValue))) : 0;
const offsetY = Number.isFinite(offsetYValue) ? Math.min(80, Math.max(-80, Number(offsetYValue))) : 0;
const layoutStyle = layoutScope !== 'none' ? [
  layoutWidth ? `width: ${layoutWidth}%` : '',
  layoutWidth ? 'justify-self: center' : '',
  offsetX || offsetY ? `transform: translate(${offsetX}%, ${offsetY}%)` : '',
].filter(Boolean).join('; ') : '';
const collageStyle = collage && layout ? [
  `--collage-col-span: ${layout.colSpan}`,
  `--collage-aspect: ${layout.colSpan} / ${layout.rowSpan}`,
  `--collage-natural-aspect: ${naturalAspect}`,
  layout.ratio ? `--collage-display-aspect: 1 / ${layout.ratio}` : '',
  `--collage-fit: ${layout.fit}`,
  `--collage-focal-x: ${layout.focalX}%`,
  `--collage-focal-y: ${layout.focalY}%`,
].join('; ') : '';
const useCrop = collage && layout?.crop === true;
const isRatioAdjusted = collage && Boolean(layout?.ratio);
---

<article
  class:list={[
    "photo-card",
    `photo-card--${photo.orientation}`,
    {
      "photo-card--collage": collage,
      "photo-card--cropped": useCrop,
      "photo-card--ratio-adjusted": isRatioAdjusted,
    },
  ]}
  data-photo-id={photo.id}
  data-home-caption={homeCaptionMode && hasHomeCaption ? '' : undefined}
  data-home-title={homeCaptionMode && hasHomeCaption ? homeTitle : undefined}
  data-home-caption-text={homeCaptionMode && hasHomeCaption ? homeCaption : undefined}
  data-scroll-reveal={reveal ? '' : undefined}
  style={collageStyle || layoutStyle || undefined}
>
  {homeCaptionMode ? (
    <>
      <button class="photo-card__trigger" type="button" aria-expanded="false" aria-label={hasHomeCaption ? (accessibleTitle ? `Show caption for ${accessibleTitle}` : 'Show caption') : 'View photograph'}>
        <div class="photo-card__image">
          <ResponsiveImage src={photo.image} alt={photo.alt} loading="lazy" sizes={imageSizes} />
        </div>
      </button>
      {hasHomeCaption && <div class="photo-card__home-caption" aria-hidden="true" aria-live="polite">
        <p class="photo-card__home-title"></p>
        <p class="photo-card__home-copy"></p>
      </div>}
    </>
  ) : (
    <a href={`/photo/${photo.id}`} aria-label={photoTitle ? `View ${photoTitle}` : 'View photograph'}>
      <div class="photo-card__image">
        <ResponsiveImage src={photo.image} alt={photo.alt} loading="lazy" sizes={imageSizes} />
      </div>
    </a>
  )}
</article>
