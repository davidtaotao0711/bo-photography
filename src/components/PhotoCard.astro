---
import ResponsiveImage from './ResponsiveImage.astro';

interface Photo {
  id: string;
  title: string;
  image: string;
  alt: string;
  orientation: string;
  location: string;
  layoutWidth?: number;
  layoutOffsetX?: number;
  layoutOffsetY?: number;
  categoryLayoutWidth?: number;
  categoryLayoutOffsetX?: number;
  categoryLayoutOffsetY?: number;
  homeTitle?: string;
  homeCaption?: string;
}
interface CollageLayout {
  colSpan: number;
  rowSpan: number;
  ratio?: number | null;
  fit: 'cover' | 'contain';
  crop: boolean;
  focalX: number;
  focalY: number;
}
interface Props {
  photo: Photo;
  eager?: boolean;
  number?: number;
  layoutScope?: 'home' | 'category' | 'none';
  reveal?: boolean;
  homeCaptionMode?: boolean;
  collage?: boolean;
  layout?: CollageLayout;
}
const {
  photo,
  eager = false,
  number,
  layoutScope = 'home',
  reveal = false,
  homeCaptionMode = false,
  collage = false,
  layout,
} = Astro.props;
const label = number ? `No. ${String(number).padStart(2, '0')}` : photo.title;
const homeTitle = photo.homeTitle ?? photo.title ?? '';
const homeCaption = photo.homeCaption ?? '';
const imageSizes = collage && layout
  ? [
    '(max-width: 720px) calc(100vw - 2rem)',
    `(max-width: 1200px) calc(${Math.round((layout.colSpan / 12) * 100)}vw - 2.5rem)`,
    `${Math.round((layout.colSpan / 12) * 100)}vw`,
  ].join(', ')
  : photo.orientation === 'portrait'
  ? '(max-width: 720px) 78vw, (max-width: 1100px) 42vw, 32vw'
  : '(max-width: 720px) 100vw, (max-width: 1100px) 62vw, 56vw';
const imageLoading = eager ? 'eager' : 'lazy';
const imageFetchPriority = eager && number === 1 ? 'high' : undefined;
const widthValue = layoutScope === 'category' ? photo.categoryLayoutWidth : photo.layoutWidth;
const offsetXValue = layoutScope === 'category' ? photo.categoryLayoutOffsetX : photo.layoutOffsetX;
const offsetYValue = layoutScope === 'category' ? photo.categoryLayoutOffsetY : photo.layoutOffsetY;
const layoutWidth = Number.isFinite(widthValue)
  ? Math.min(200, Math.max(45, Number(widthValue)))
  : null;
const offsetX = Number.isFinite(offsetXValue) ? Math.min(80, Math.max(-80, Number(offsetXValue))) : 0;
const offsetY = Number.isFinite(offsetYValue) ? Math.min(80, Math.max(-80, Number(offsetYValue))) : 0;
const layoutStyle = layoutScope !== 'none' ? [
  layoutWidth ? `width: ${layoutWidth}%` : '',
  layoutWidth ? 'justify-self: center' : '',
  offsetX || offsetY ? `transform: translate(${offsetX}%, ${offsetY}%)` : '',
].filter(Boolean).join('; ') : '';
const collageStyle = collage && layout ? [
  `--collage-col-span: ${layout.colSpan}`,
  `--collage-aspect: ${layout.colSpan} / ${layout.rowSpan}`,
  layout.ratio ? `--collage-display-aspect: 1 / ${layout.ratio}` : '',
  `--collage-fit: ${layout.fit}`,
  `--collage-focal-x: ${layout.focalX}%`,
  `--collage-focal-y: ${layout.focalY}%`,
].join('; ') : '';
---

<article
  class:list={[
    "photo-card",
    `photo-card--${photo.orientation}`,
    {
      "photo-card--collage": collage,
      "photo-card--cropped": collage && layout?.crop,
      "photo-card--ratio-adjusted": collage && Boolean(layout?.ratio),
    },
  ]}
  data-photo-id={photo.id}
  data-home-caption={homeCaptionMode ? '' : undefined}
  data-home-title={homeCaptionMode ? homeTitle : undefined}
  data-home-caption-text={homeCaptionMode ? homeCaption : undefined}
  data-scroll-reveal={reveal ? '' : undefined}
  style={collageStyle || layoutStyle || undefined}
>
  {homeCaptionMode ? (
    <>
      <button class="photo-card__trigger" type="button" aria-expanded="false" aria-label={`Show caption for ${label}`}>
        <div class="photo-card__image">
          <ResponsiveImage
            src={photo.image}
            alt={photo.alt}
            loading={imageLoading}
            fetchpriority={imageFetchPriority}
            sizes={imageSizes}
          />
        </div>
        <div class="photo-card__meta">
          <span>{label}</span>
          <span>{photo.location}</span>
        </div>
      </button>
      <div class="photo-card__home-caption" hidden aria-live="polite">
        <p class="photo-card__home-title"></p>
        <p class="photo-card__home-copy"></p>
      </div>
    </>
  ) : (
    <a href={`/photo/${photo.id}`} aria-label={`View ${label}, ${photo.location}`}>
      <div class="photo-card__image">
        <ResponsiveImage
          src={photo.image}
          alt={photo.alt}
          loading={imageLoading}
          fetchpriority={imageFetchPriority}
          sizes={imageSizes}
        />
      </div>
      <div class="photo-card__meta">
        <span>{label}</span>
        <span>{photo.location}</span>
      </div>
    </a>
  )}
</article>
