---
import ResponsiveImage from './ResponsiveImage.astro';

interface Entry {
  id: string;
  title: string;
  description: string;
  href: string;
  coverImage: string;
  order: number;
}

interface Props {
  entry: Entry;
  number: number;
}

const { entry, number } = Astro.props;
const label = String(number).padStart(2, '0');
---

<a class="category-card" href={entry.href} data-category-card>
  <span class="category-card__number">{label}</span>

  <div class="category-card__copy">
    <h2>{entry.title}</h2>
    <p>{entry.description}</p>
  </div>

  <figure class="category-card__media" data-category-media>
    <ResponsiveImage
      src={entry.coverImage}
      alt={`${entry.title} photography`}
      loading={number < 3 ? 'eager' : 'lazy'}
      sizes="(max-width: 768px) 100vw, 46vw"
    />
      <span
        class="category-card__magnifier"
        data-category-magnifier
        aria-hidden="true"
      ></span>
  </figure>

  <span class="category-card__arrow" aria-hidden="true">↗</span>
</a>

<script>
  const magnifierQuery = window.matchMedia('(min-width: 769px) and (hover: hover) and (pointer: fine)');

  const initializeCategoryMagnifiers = () => {
    document.querySelectorAll('[data-category-card]').forEach((card) => {
      if (!(card instanceof HTMLAnchorElement) || card.dataset.magnifierReady === 'true') return;

      const media = card.querySelector('[data-category-media]');
      const image = media?.querySelector('img');
      const magnifier = media?.querySelector('[data-category-magnifier]');
      if (!(media instanceof HTMLElement) || !(image instanceof HTMLImageElement) || !(magnifier instanceof HTMLElement)) return;

      card.dataset.magnifierReady = 'true';
      const zoom = 2.2;
      const lensSize = 100;
      let frameId = 0;
      let pointerX = 0;
      let pointerY = 0;

      const updateMagnifierSource = () => {
        const source = image.currentSrc || image.src;
        if (!source || magnifier.dataset.source === source) return;

        magnifier.dataset.source = source;
        magnifier.style.backgroundImage = `url("${source.replace(/"/g, '%22')}")`;
      };

      const renderMagnifier = () => {
        frameId = 0;
        const bounds = media.getBoundingClientRect();
        const x = Math.min(bounds.width, Math.max(0, pointerX - bounds.left));
        const y = Math.min(bounds.height, Math.max(0, pointerY - bounds.top));
        const naturalWidth = image.naturalWidth || bounds.width;
        const naturalHeight = image.naturalHeight || bounds.height;
        const coverScale = Math.max(bounds.width / naturalWidth, bounds.height / naturalHeight);
        const renderedWidth = naturalWidth * coverScale;
        const renderedHeight = naturalHeight * coverScale;
        const offsetX = (bounds.width - renderedWidth) / 2;
        const offsetY = (bounds.height - renderedHeight) / 2;

        magnifier.style.left = `${x}px`;
        magnifier.style.top = `${y}px`;
        magnifier.style.backgroundSize = `${renderedWidth * zoom}px ${renderedHeight * zoom}px`;
        magnifier.style.backgroundPosition = [
          `${lensSize / 2 - (x - offsetX) * zoom}px`,
          `${lensSize / 2 - (y - offsetY) * zoom}px`,
        ].join(' ');
      };

      const scheduleMagnifier = (event) => {
        if (!magnifierQuery.matches) return;

        pointerX = event.clientX;
        pointerY = event.clientY;
        if (!frameId) frameId = window.requestAnimationFrame(renderMagnifier);
      };

      media.addEventListener('pointerenter', (event) => {
        if (!magnifierQuery.matches) return;
        updateMagnifierSource();
        card.classList.add('is-magnifying');
        scheduleMagnifier(event);
      });
      media.addEventListener('pointermove', scheduleMagnifier);
      media.addEventListener('pointerleave', () => {
        card.classList.remove('is-magnifying');
        if (frameId) {
          window.cancelAnimationFrame(frameId);
          frameId = 0;
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCategoryMagnifiers, { once: true });
  } else {
    initializeCategoryMagnifiers();
  }

  document.addEventListener('astro:page-load', initializeCategoryMagnifiers);
</script>

<style>
  .category-card {
    min-height: clamp(18rem, 29vw, 27rem);
    position: relative;
    display: grid;
    grid-template-columns: 4.25rem minmax(14rem, .9fr) minmax(24rem, 1.15fr) 2.5rem;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    align-items: center;
    padding: clamp(1.5rem, 2.7vw, 2.6rem) 0;
    border-top: 1px solid var(--line);
    transition: background-color 240ms ease;
  }

  .category-card:last-child {
    border-bottom: 1px solid var(--line);
  }

  .category-card__number {
    align-self: start;
    padding-top: .2rem;
    color: var(--muted);
    font-size: .65rem;
    letter-spacing: .12em;
  }

  .category-card__copy {
    min-width: 0;
  }

  .category-card h2 {
    margin: 0;
    font: 400 clamp(3rem, 6vw, 6.8rem)/.88 var(--serif);
    letter-spacing: -.04em;
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .category-card__copy p {
    max-width: 25rem;
    margin: clamp(1.3rem, 2.2vw, 2rem) 0 0;
    color: var(--muted);
    font-size: .72rem;
    line-height: 1.65;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .category-card__media {
    width: 100%;
    margin: 0;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #e8e5dc;
  }

  .category-card__media :global(.responsive-image),
  .category-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .category-card__media :global(img) {
    object-fit: cover;
    object-position: center;
    transition: transform 420ms cubic-bezier(.22, .61, .36, 1);
  }

  .category-card__arrow {
    align-self: start;
    justify-self: end;
    font-size: 1.25rem;
    transition: transform 240ms ease;
  }

  .category-card__magnifier {
    width: 100px;
    height: 100px;
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    border: 1px solid rgba(255, 255, 255, .72);
    border-radius: 50%;
    background-repeat: no-repeat;
    box-shadow: 0 .5rem 1.6rem rgba(20, 20, 18, .18);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.92);
    transition: opacity 160ms ease, transform 200ms ease;
  }

  .category-card:hover {
    background: rgba(255, 255, 255, .2);
  }

  .category-card:hover h2 {
    opacity: .82;
    transform: translateX(.4rem);
  }

  .category-card:hover .category-card__arrow {
    transform: translate(.25rem, -.25rem);
  }

  .category-card:hover .category-card__media :global(img) {
    transform: scale(1.025);
  }

  .category-card.is-magnifying .category-card__magnifier {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  @media (max-width: 900px) {
    .category-card {
      grid-template-columns: 3rem minmax(11rem, .8fr) minmax(18rem, 1fr) 2rem;
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .category-card {
      min-height: 0;
      grid-template-columns: 2rem 1fr auto;
      gap: 1rem;
      padding: 2rem 0 2.5rem;
    }

    .category-card__number {
      grid-column: 1;
      grid-row: 1;
    }

    .category-card__copy {
      grid-column: 2;
      grid-row: 1;
    }

    .category-card h2 {
      font-size: clamp(2.8rem, 15vw, 4.8rem);
    }

    .category-card__copy p {
      margin-top: 1rem;
      font-size: .64rem;
    }

    .category-card__media {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: .75rem;
      aspect-ratio: 4 / 3;
    }

    .category-card__arrow {
      grid-column: 3;
      grid-row: 1;
    }

    .category-card__magnifier {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card h2,
    .category-card__arrow,
    .category-card__media :global(img) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
