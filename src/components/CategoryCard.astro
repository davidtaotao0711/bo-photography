---
import ResponsiveImage from './ResponsiveImage.astro';

interface Entry {
  id: string;
  title: string;
  description: string;
  href: string;
  coverImage: string;
}

interface Props {
  entry: Entry;
  number: number;
}

const { entry, number } = Astro.props;
const label = String(number).padStart(2, '0');
---

<a class="category-card" href={entry.href} data-category-card>
  <header class="category-card__header">
    <span class="category-card__number">{label}</span>
    <span class="category-card__arrow" aria-hidden="true">↗</span>
    <h2>{entry.title}</h2>
    <p>{entry.description}</p>
  </header>

  <figure class="category-card__media" data-category-media>
    <ResponsiveImage
      src={entry.coverImage}
      alt={`${entry.title} photography`}
      loading={number < 3 ? 'eager' : 'lazy'}
      sizes="(max-width: 520px) 100vw, (max-width: 1050px) 50vw, 25vw"
    />
    <span class="category-card__veil" aria-hidden="true"></span>
    <span class="category-card__focus" data-category-focus aria-hidden="true"></span>
  </figure>
</a>

<script>
  const focusQuery = window.matchMedia('(min-width: 821px) and (hover: hover) and (pointer: fine)');

  const initializeCategoryFocus = () => {
    document.querySelectorAll('[data-category-card]').forEach((card) => {
      if (!(card instanceof HTMLAnchorElement) || card.dataset.focusReady === 'true') return;

      const media = card.querySelector('[data-category-media]');
      const image = media?.querySelector('img');
      const focus = media?.querySelector('[data-category-focus]');
      if (!(media instanceof HTMLElement) || !(image instanceof HTMLImageElement) || !(focus instanceof HTMLElement)) return;

      card.dataset.focusReady = 'true';
      const zoom = 1.72;
      let frameId = 0;
      let pointerX = 0;
      let pointerY = 0;

      const updateSource = () => {
        const source = image.currentSrc || image.src;
        if (!source || focus.dataset.source === source) return;
        focus.dataset.source = source;
        focus.style.backgroundImage = `url("${source.replace(/"/g, '%22')}")`;
      };

      const renderFocus = () => {
        frameId = 0;
        const bounds = media.getBoundingClientRect();
        const x = Math.min(bounds.width, Math.max(0, pointerX - bounds.left));
        const y = Math.min(bounds.height, Math.max(0, pointerY - bounds.top));
        const naturalWidth = image.naturalWidth || bounds.width;
        const naturalHeight = image.naturalHeight || bounds.height;
        const coverScale = Math.max(bounds.width / naturalWidth, bounds.height / naturalHeight);
        const renderedWidth = naturalWidth * coverScale;
        const renderedHeight = naturalHeight * coverScale;
        const offsetX = (bounds.width - renderedWidth) / 2;
        const offsetY = (bounds.height - renderedHeight) / 2;
        const lensWidth = focus.offsetWidth;
        const lensHeight = focus.offsetHeight;

        focus.style.left = `${x}px`;
        focus.style.top = `${y}px`;
        focus.style.backgroundSize = `${renderedWidth * zoom}px ${renderedHeight * zoom}px`;
        focus.style.backgroundPosition = [
          `${lensWidth / 2 - (x - offsetX) * zoom}px`,
          `${lensHeight / 2 - (y - offsetY) * zoom}px`,
        ].join(' ');
      };

      const scheduleFocus = (event) => {
        if (!focusQuery.matches) return;
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (!frameId) frameId = window.requestAnimationFrame(renderFocus);
      };

      media.addEventListener('pointerenter', (event) => {
        if (!focusQuery.matches) return;
        updateSource();
        card.classList.add('is-focusing');
        scheduleFocus(event);
      });
      media.addEventListener('pointermove', (event) => {
        if (!focusQuery.matches) return;
        updateSource();
        card.classList.add('is-focusing');
        scheduleFocus(event);
      });
      media.addEventListener('pointerleave', () => {
        card.classList.remove('is-focusing');
        if (frameId) window.cancelAnimationFrame(frameId);
        frameId = 0;
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCategoryFocus, { once: true });
  } else {
    initializeCategoryFocus();
  }

  document.addEventListener('astro:page-load', initializeCategoryFocus);
</script>

<style>
  .category-card {
    min-width: 0;
    position: relative;
    display: grid;
    grid-template-rows: minmax(6.5rem, 21%) 1fr;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(40, 39, 35, .1);
    color: var(--ink);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, .5), rgba(255, 255, 255, .16)),
      rgba(238, 234, 224, .52);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .75),
      0 .8rem 2.5rem rgba(40, 36, 27, .035);
    backdrop-filter: blur(14px);
    transition: transform 420ms cubic-bezier(.16, 1, .3, 1), box-shadow 420ms ease, border-color 300ms ease;
  }

  .category-card__header {
    min-width: 0;
    position: relative;
    padding: clamp(1rem, 1.45vw, 1.5rem);
  }

  .category-card__number,
  .category-card__arrow {
    position: absolute;
    top: clamp(1rem, 1.45vw, 1.5rem);
    color: rgba(23, 23, 22, .46);
    font-size: .58rem;
    line-height: 1;
    letter-spacing: .12em;
  }

  .category-card__number {
    left: clamp(1rem, 1.45vw, 1.5rem);
  }

  .category-card__arrow {
    right: clamp(1rem, 1.45vw, 1.5rem);
    font-size: .9rem;
    transition: transform 300ms cubic-bezier(.16, 1, .3, 1), color 240ms ease;
  }

  .category-card h2 {
    margin: 1.35rem 0 0;
    font: 400 clamp(1.65rem, 2.45vw, 2.65rem)/.95 var(--serif);
    letter-spacing: -.035em;
  }

  .category-card__header p {
    max-width: 23ch;
    margin: .55rem 0 0;
    color: var(--muted);
    font-size: clamp(.54rem, .55vw, .62rem);
    line-height: 1.5;
    letter-spacing: .075em;
    text-transform: uppercase;
  }

  .category-card__media {
    min-height: 0;
    margin: 0 .45rem .45rem;
    position: relative;
    overflow: hidden;
    background: #dedbd2;
  }

  .category-card__media :global(.responsive-image),
  .category-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .category-card__media :global(img) {
    object-fit: cover;
    object-position: center;
    filter: saturate(.78) contrast(.93) brightness(1.025) blur(.35px);
    transform: scale(1.012);
    transition: filter 420ms ease, transform 700ms cubic-bezier(.16, 1, .3, 1);
  }

  .category-card__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(145deg, rgba(247, 244, 237, .14), rgba(247, 244, 237, .03) 48%, rgba(255, 255, 255, .12)),
      rgba(237, 233, 224, .09);
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .category-card__focus {
    width: clamp(6rem, 8.5vw, 8rem);
    height: clamp(4.8rem, 6.8vw, 6.4rem);
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    border-radius: 48%;
    background-repeat: no-repeat;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, .34),
      0 .8rem 2.4rem rgba(19, 18, 15, .11);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.88);
    transition: opacity 190ms ease, transform 350ms cubic-bezier(.16, 1, .3, 1);
  }

  .category-card:hover,
  .category-card:focus-visible {
    border-color: rgba(40, 39, 35, .16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .84),
      0 1.4rem 4rem rgba(40, 36, 27, .075);
    transform: translateY(-5px);
  }

  .category-card:hover .category-card__arrow,
  .category-card:focus-visible .category-card__arrow {
    color: var(--ink);
    transform: translate(.2rem, -.2rem);
  }

  .category-card:hover .category-card__media :global(img) {
    transform: scale(1.027);
  }

  .category-card.is-focusing .category-card__veil {
    opacity: .82;
  }

  .category-card.is-focusing .category-card__focus {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .category-card:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  @media (max-width: 820px), (hover: none), (pointer: coarse) {
    .category-card__focus {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .category-card {
      min-height: 31rem;
      aspect-ratio: auto;
      grid-template-rows: 7rem 1fr;
    }

    .category-card__media :global(img) {
      filter: none;
      opacity: 1;
      transform: none;
    }

    .category-card__veil {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card__arrow,
    .category-card__media :global(img),
    .category-card__focus {
      transform: none;
      transition: none;
    }
  }
</style>
