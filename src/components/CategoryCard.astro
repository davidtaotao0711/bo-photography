---
import ResponsiveImage from './ResponsiveImage.astro';

interface Entry {
  id: string;
  title: string;
  description: string;
  href: string;
  coverImage: string;
  coverPosition?: string;
}

interface Props {
  entry: Entry;
  number: number;
  priority?: boolean;
}

const { entry, number, priority = false } = Astro.props;
const label = String(number).padStart(2, '0');
const imageStyle = entry.coverPosition ? `object-position: ${entry.coverPosition};` : undefined;
---

<a class="category-card" href={entry.href}>
  <header class="category-card__header">
    <span class="category-card__number">{label}</span>
    <span class="category-card__arrow" aria-hidden="true">→</span>
    <h2>{entry.title}</h2>
    <p>{entry.description}</p>
  </header>

  <figure class="category-card__media">
    <ResponsiveImage
      src={entry.coverImage}
      alt={`${entry.title} photography`}
      loading={priority || number < 3 ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
      sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 33vw"
      style={imageStyle}
    />
    <span class="category-card__veil" aria-hidden="true"></span>
    <span class="category-card__grain" aria-hidden="true"></span>
  </figure>
</a>

<style>
  .category-card {
    min-width: 0;
    position: relative;
    display: grid;
    grid-template-rows: minmax(6.5rem, 21%) 1fr;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(40, 39, 35, .1);
    color: var(--ink);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, .5), rgba(255, 255, 255, .16)),
      rgba(238, 234, 224, .52);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .75),
      0 .8rem 2.5rem rgba(40, 36, 27, .035);
    transition: transform 420ms cubic-bezier(.16, 1, .3, 1), box-shadow 420ms ease, border-color 300ms ease;
  }

  .category-card__header {
    min-width: 0;
    position: relative;
    padding: clamp(1rem, 1.45vw, 1.5rem);
  }

  .category-card__number,
  .category-card__arrow {
    position: absolute;
    top: clamp(1rem, 1.45vw, 1.5rem);
    color: rgba(23, 23, 22, .46);
    font-size: .58rem;
    line-height: 1;
    letter-spacing: .12em;
  }

  .category-card__number {
    left: clamp(1rem, 1.45vw, 1.5rem);
  }

  .category-card__arrow {
    right: clamp(1rem, 1.45vw, 1.5rem);
    font-size: .9rem;
    transition: transform 300ms cubic-bezier(.16, 1, .3, 1), color 240ms ease;
  }

  .category-card h2 {
    margin: 1.35rem 0 0;
    font: 400 clamp(1.65rem, 2.45vw, 2.65rem)/.95 var(--serif);
    letter-spacing: -.035em;
  }

  .category-card__header p {
    max-width: 23ch;
    margin: .55rem 0 0;
    color: var(--muted);
    font-size: clamp(.54rem, .55vw, .62rem);
    line-height: 1.5;
    letter-spacing: .075em;
    text-transform: uppercase;
  }

  .category-card__media {
    min-height: 0;
    margin: 0 .45rem .45rem;
    position: relative;
    overflow: hidden;
    background: #dedbd2;
  }

  .category-card__media :global(.responsive-image),
  .category-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .category-card__media :global(img) {
    object-fit: cover;
    object-position: center;
    filter: saturate(.97) contrast(.99) brightness(1.01);
    transform: scale(1.002);
    transition: filter 420ms ease, transform 700ms cubic-bezier(.16, 1, .3, 1);
  }

  .category-card__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(145deg, rgba(250, 247, 240, .055), rgba(245, 241, 232, .015) 52%, rgba(250, 247, 240, .04)),
      rgba(245, 241, 232, .018);
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .category-card__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    opacity: .05;
    pointer-events: none;
  }

  .category-card__grain::after {
    content: '';
    position: absolute;
    inset: -200%;
    width: 400%;
    height: 400%;
    background-image: url("/images/grain.png");
    background-size: 256px 256px;
    background-repeat: repeat;
    animation: categoryGrainMove 8s steps(10, start) infinite;
  }

  @keyframes categoryGrainMove {
    0% { transform: translate(0%, 0%); }
    10% { transform: translate(-5%, -10%); }
    20% { transform: translate(-15%, 5%); }
    30% { transform: translate(7%, -25%); }
    40% { transform: translate(-5%, 25%); }
    50% { transform: translate(-15%, 10%); }
    60% { transform: translate(15%, 0%); }
    70% { transform: translate(0%, 15%); }
    80% { transform: translate(3%, 35%); }
    90% { transform: translate(-10%, 10%); }
    100% { transform: translate(0%, 0%); }
  }

  .category-card:hover,
  .category-card:focus-visible {
    border-color: rgba(40, 39, 35, .16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .84),
      0 1.4rem 4rem rgba(40, 36, 27, .075);
    transform: translateY(-5px);
  }

  .category-card:hover .category-card__arrow,
  .category-card:focus-visible .category-card__arrow {
    color: var(--ink);
    transform: translate(.2rem, -.2rem);
  }

  .category-card:hover .category-card__media :global(img) {
    transform: scale(1.008);
  }

  .category-card:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  @media (max-width: 520px) {
    .category-card {
      min-height: 31rem;
      aspect-ratio: auto;
      grid-template-rows: 7rem 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card__arrow,
    .category-card__media :global(img) {
      transform: none;
      transition: none;
    }

    .category-card__grain::after {
      animation: none;
    }
  }
</style>
