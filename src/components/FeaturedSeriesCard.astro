---
import ResponsiveImage from './ResponsiveImage.astro';

interface Entry {
  title: string;
  description: string;
  href: string;
  coverImage: string;
  coverImages?: string[];
  coverPosition?: string;
  coverPositions?: string[];
  label?: string;
}

interface Props {
  entry: Entry;
  number: number;
  priority?: boolean;
  compact?: boolean;
}

const { entry, number, priority = false, compact = false } = Astro.props;
const label = String(number).padStart(2, '0');
const imageStyle = entry.coverPosition ? `object-position: ${entry.coverPosition};` : undefined;
const coverImages = Array.isArray(entry.coverImages) && entry.coverImages.length >= 2
  ? entry.coverImages.slice(0, 3)
  : [entry.coverImage];
const hasCoverGrid = coverImages.length >= 2;
---

<a class:list={['series-entry', { 'series-entry--compact': compact }]} href={entry.href}>
  <div class="series-entry__copy">
    <div class="series-entry__meta">
      <span>{label}</span>
      <span>{entry.label || 'Series / Edited stories'}</span>
    </div>
    <div>
      <h2>{entry.title}</h2>
      <p>{entry.description}</p>
    </div>
    <div class="series-entry__footer">
      <span>Open the books</span>
      <span aria-hidden="true">↗</span>
    </div>
  </div>

  <figure class:list={['series-entry__media', { 'series-entry__media--diptych': hasCoverGrid }]}>
    {hasCoverGrid ? (
      <div class="series-entry__media-grid" style={`--cover-count: ${coverImages.length};`}>
        {coverImages.map((src, index) => (
          <span class="series-entry__media-frame">
            <ResponsiveImage
              src={src}
              alt={`${entry.title} portrait ${index + 1}`}
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority && index === 0 ? 'high' : undefined}
              sizes="(max-width: 760px) 30vw, 20vw"
              style={entry.coverPositions?.[index] ? `object-position: ${entry.coverPositions[index]};` : undefined}
            />
          </span>
        ))}
      </div>
    ) : (
      <ResponsiveImage
        src={entry.coverImage}
        alt={`${entry.title} photography books`}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        sizes="(max-width: 760px) 100vw, 62vw"
        style={imageStyle}
      />
    )}
    <span class="series-entry__spine" aria-hidden="true"></span>
    <span class="series-entry__wash" aria-hidden="true"></span>
  </figure>
    <div class="series-entry__grain" aria-hidden="true"></div>
</a>

<style>
  .series-entry {
    height: clamp(28rem, 42vw, 39rem);
    min-height: 0;
    position: relative;
    display: grid;
    grid-template-columns: minmax(17rem, .72fr) minmax(28rem, 1.38fr);
    overflow: hidden;
    border: 1px solid rgba(40, 39, 35, .1);
    color: var(--ink);
    background:
      linear-gradient(132deg, rgba(255, 255, 255, .58), rgba(238, 233, 222, .24)),
      rgba(237, 232, 220, .55);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .78),
      0 1.1rem 3.8rem rgba(40, 36, 27, .05);
    backdrop-filter: blur(16px);
    transition: transform 500ms cubic-bezier(.16, 1, .3, 1), box-shadow 450ms ease, border-color 300ms ease;
  }

  .series-entry--compact {
    height: clamp(28rem, 42vw, 39rem);
  }

  .series-entry__copy {
    min-width: 0;
    min-height: 0;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.6rem, 3.2vw, 3.4rem);
  }

  .series-entry__meta,
  .series-entry__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: .58rem;
    line-height: 1.4;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .series-entry h2 {
    margin: 0;
    font: 400 clamp(4.3rem, 8vw, 8.5rem)/.82 var(--serif);
    letter-spacing: -.065em;
  }

  .series-entry__copy p {
    max-width: 25rem;
    margin: clamp(1.4rem, 2.5vw, 2.4rem) 0 0;
    color: var(--muted);
    font: 400 clamp(1.05rem, 1.55vw, 1.45rem)/1.45 var(--serif);
  }

  .series-entry__footer {
    padding-top: 1.1rem;
    border-top: 1px solid rgba(23, 23, 22, .14);
    color: var(--ink);
  }

  .series-entry__footer span:last-child {
    font-size: 1rem;
    transition: transform 300ms cubic-bezier(.16, 1, .3, 1);
  }

  .series-entry__media {
    min-width: 0;
    min-height: 0;
    margin: .55rem .55rem .55rem 0;
    position: relative;
    overflow: hidden;
    background: #d8d2c6;
    box-shadow: -1rem 0 2.4rem rgba(30, 27, 21, .055);
    transform-origin: left center;
    transition: transform 700ms cubic-bezier(.16, 1, .3, 1);
  }

  .series-entry__media :global(.responsive-image),
  .series-entry__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .series-entry__media-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--cover-count, 2), minmax(0, 1fr));
    gap: clamp(.75rem, 1.6vw, 1.8rem);
    padding: clamp(.75rem, 1.4vw, 1.4rem);
    box-sizing: border-box;
    overflow: hidden;
    background: rgba(247, 244, 237, .72);
  }

  .series-entry__media-frame {
    min-width: 0;
    min-height: 0;
    display: block;
    overflow: hidden;
    background: #d8d2c6;
  }

  .series-entry--compact .series-entry__media-grid {
    align-items: center;
  }

  .series-entry--compact .series-entry__media-frame {
    aspect-ratio: 5 / 8;
  }

  .series-entry__media--diptych .series-entry__spine {
    display: none;
  }

  .series-entry__media :global(img) {
    object-fit: cover;
    object-position: center;
    filter: saturate(.88) contrast(.97);
    transition: transform 900ms cubic-bezier(.16, 1, .3, 1), filter 500ms ease;
  }

  .series-entry__spine {
    width: clamp(.6rem, 1.1vw, 1rem);
    position: absolute;
    z-index: 2;
    inset: 0 auto 0 0;
    background: linear-gradient(90deg, rgba(20, 18, 15, .22), rgba(255, 255, 255, .2) 48%, transparent);
    box-shadow: .5rem 0 1.2rem rgba(20, 18, 15, .09);
    pointer-events: none;
  }

  .series-entry__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, rgba(246, 242, 233, .14), transparent 42%, rgba(255, 255, 255, .05));
    pointer-events: none;
    transition: opacity 450ms ease;
  }

  .series-entry:hover,
  .series-entry:focus-visible {
    border-color: rgba(40, 39, 35, .16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .84),
      0 1.8rem 5rem rgba(40, 36, 27, .085);
    transform: translateY(-4px);
  }

  .series-entry:hover .series-entry__media,
  .series-entry:focus-visible .series-entry__media {
    transform: perspective(1200px) rotateY(-.7deg);
  }

  .series-entry:hover .series-entry__media :global(img),
  .series-entry:focus-visible .series-entry__media :global(img) {
    filter: saturate(.96) contrast(1);
    transform: scale(1.025);
  }

  .series-entry:hover .series-entry__wash,
  .series-entry:focus-visible .series-entry__wash {
    opacity: .62;
  }

  .series-entry:hover .series-entry__footer span:last-child,
  .series-entry:focus-visible .series-entry__footer span:last-child {
    transform: translate(.25rem, -.25rem);
  }

  .series-entry:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .series-entry {
      height: auto;
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .series-entry--compact {
      height: auto;
    }

    .series-entry__copy {
      min-height: 19rem;
      padding: 1.5rem;
    }

    .series-entry__media {
      margin: 0 .45rem .45rem;
      aspect-ratio: 4 / 3;
      box-shadow: none;
    }

    .series-entry--compact .series-entry__media {
      aspect-ratio: 9 / 4;
    }

    .series-entry--compact .series-entry__media-frame {
      aspect-ratio: 3 / 4;
    }

    .series-entry__media-grid {
      gap: .45rem;
      padding: .45rem;
    }

    .series-entry__media :global(img) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .series-entry,
    .series-entry__media,
    .series-entry__media :global(img),
    .series-entry__footer span:last-child {
      transform: none;
      transition: none;
    }
  }

  .series-entry__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: .05;
  }

  .series-entry__grain::after {
    content: '';
    position: absolute;
    inset: -200%;
    width: 400%;
    height: 400%;
    background-image: url("/images/grain.png");
    background-size: 256px 256px;
    background-repeat: repeat;
    animation: seriesGrainMove 8s steps(10, start) infinite;
  }

  @keyframes seriesGrainMove {
    0% { transform: translate(0%, 0%); }
    10% { transform: translate(-5%, -10%); }
    20% { transform: translate(-15%, 5%); }
    30% { transform: translate(7%, -25%); }
    40% { transform: translate(-5%, 25%); }
    50% { transform: translate(-15%, 10%); }
    60% { transform: translate(15%, 0%); }
    70% { transform: translate(0%, 15%); }
    80% { transform: translate(3%, 35%); }
    90% { transform: translate(-10%, 10%); }
    100% { transform: translate(0%, 0%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .series-entry__grain::after {
      animation: none;
    }
  }

</style>
