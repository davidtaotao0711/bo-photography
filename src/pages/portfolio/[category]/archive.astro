---
import GalleryGrid from '../../../components/GalleryGrid.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import { getPhotoCategory } from '../../../data/categories.js';
import { getPortfolioStatus, migratePortfolioPhotos, sortPortfolioPhotos } from '../../../utils/portfolio-status.js';
import { getPhotoMeta } from '../../../utils/photo-metadata.js';
import { visibleCanvasPhotos } from '../../../utils/gallery-canvas.js';

const { photos, site, galleryLayouts } = Astro.locals.editor.data;

const { category } = Astro.params;
const categoryConfig = getPhotoCategory(category);
if (!categoryConfig || category === 'portrait') return new Response(null, { status: 404 });
const title = categoryConfig?.title || '';
const normalizedPhotos = migratePortfolioPhotos(photos);
const archiveItems = visibleCanvasPhotos(galleryLayouts.galleries[`category:${category}:archive`], sortPortfolioPhotos(
  normalizedPhotos.filter((photo) => photo.category === category && getPortfolioStatus(photo, category) === 'archive'),
  'archive',
));
const lightboxData = archiveItems.map((photo) => ({
  id: photo.id,
  image: photo.image,
  alt: photo.alt,
  orientation: photo.orientation,
  ...getPhotoMeta(photo),
}));
---

<BaseLayout title={`${title} Archive - ${site.name}`}>
  <section class="archive-head page-shell">
    <a class="back-link" href={`/portfolio/${category}`}>&larr; Selected {title}</a>
    <div>
      <p class="eyebrow">Archive / {title}</p>
      <h1>{title} Archive</h1>
      <p class="archive-head__count">{archiveItems.length} additional photographs</p>
    </div>
  </section>

  {archiveItems.length ? (
    <section class="gallery gallery--archive page-shell">
      <GalleryGrid photos={archiveItems} galleryKey={`category:${category}:archive`} reveal={false} />
    </section>
  ) : (
    <section class="archive-empty page-shell">
      <p>No additional photographs in this archive.</p>
    </section>
  )}

  <PhotoLightbox photos={lightboxData} gallerySelector=".gallery--archive" />
</BaseLayout>
