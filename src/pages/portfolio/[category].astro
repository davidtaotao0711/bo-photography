---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { getPhotoCategory, photoCategories } from '../../data/categories.js';
import photos from '../../data/photos.json';
import site from '../../data/site.json';
import { buildOrientationRows } from '../../utils/photo-layout.js';

export function getStaticPaths() {
  return photoCategories.map((category) => ({ params: { category: category.slug } }));
}

const { category } = Astro.params;
const categoryConfig = getPhotoCategory(category);
const title = categoryConfig?.title || '';
const items = photos.filter((photo) => photo.category === category);
const useOrientationRows = Boolean(categoryConfig?.rowLayout);
let displayNumber = 0;
const rows = useOrientationRows
  ? buildOrientationRows(items).map((row) => ({
      ...row,
      items: row.items.map((photo) => ({ photo, number: ++displayNumber })),
    }))
  : [];
---

<BaseLayout title={`${title} — ${site.name}`}>
  <section class="category-head page-shell">
    <a class="back-link" href="/portfolio">← Portfolio</a>
    <div>
      <p class="eyebrow">Category</p>
      <h1>{title}</h1>
    </div>
    <p class="category-head__count">{items.length} photographs</p>
  </section>
  <section class:list={["gallery", "page-shell", { "gallery--rows": useOrientationRows }]}>
    {useOrientationRows ? rows.map((row) => (
      <div class:list={["gallery-row", `gallery-row--${row.orientation}`]} style={`--gallery-row-count:${row.items.length}`}>
        {row.items.map(({ photo, number }) => <PhotoCard photo={photo} number={number} eager={number <= 3} layoutScope="category" reveal />)}
      </div>
    )) : items.map((photo, index) => <PhotoCard photo={photo} number={index + 1} eager={index < 3} layoutScope="category" reveal />)}
  </section>
  <ScrollReveal />
</BaseLayout>
