---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { getPhotoCategory, photoCategories } from '../../data/categories.js';
import photos from '../../data/photos.json';
import { getPortfolioStatus, migratePortfolioPhotos, sortPortfolioPhotos } from '../../utils/portfolio-status.js';
import site from '../../data/site.json';
import { getPhotoMeta } from '../../utils/photo-metadata.js';

export function getStaticPaths() {
  return photoCategories.map((category) => ({ params: { category: category.slug } }));
}

const { category } = Astro.params;
const categoryConfig = getPhotoCategory(category);
const title = categoryConfig?.title || '';
const normalizedPhotos = migratePortfolioPhotos(photos);
const allItems = normalizedPhotos.filter((photo) => photo.category === category);
const items = sortPortfolioPhotos(allItems.filter((photo) => getPortfolioStatus(photo, category) === 'selected'), 'selected');
const archiveItems = sortPortfolioPhotos(allItems.filter((photo) => getPortfolioStatus(photo, category) === 'archive'), 'archive');
const lightboxData = items.map((photo) => ({
  id: photo.id,
  image: photo.image,
  alt: photo.alt,
  orientation: photo.orientation,
  ...getPhotoMeta(photo),
}));
---

<BaseLayout title={`${title} - ${site.name}`}>
  <section class="category-head page-shell">
    <a class="back-link" href="/portfolio">&larr; Portfolio</a>
    <div>
      <p class="eyebrow">Category</p>
      <h1>{title}</h1>
    </div>
    <p class="category-head__count">{items.length} selected photographs</p>
  </section>
  <section class="gallery gallery--collage page-shell">
    <GalleryGrid photos={items} />
  </section>
  <section class="category-archive-entry page-shell" aria-labelledby="archive-entry-title">
    <div>
      <p class="eyebrow">Additional edit</p>
      <h2 id="archive-entry-title">{title} Archive</h2>
      <p class="category-archive-entry__count">{archiveItems.length} additional photographs</p>
    </div>
    <a class="text-link" href={`/portfolio/${category}/archive`}>View archive <span aria-hidden="true">↗</span></a>
  </section>
  <PhotoLightbox photos={lightboxData} gallerySelector=".gallery--collage" />
  <ScrollReveal />
</BaseLayout>
