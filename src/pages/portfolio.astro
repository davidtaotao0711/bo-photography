---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import categories from '../data/portfolio-categories.json';
import site from '../data/site.json';

const entries = categories
  .map((entry, index) => ({
    entry,
    index,
    order: Number.isFinite(Number(entry.order)) ? Number(entry.order) : index + 1,
  }))
  .sort((a, b) => a.order - b.order || a.index - b.index)
  .map(({ entry }) => entry);
---

<BaseLayout title={`Portfolio — ${site.name}`}>
  <section class="index-hero page-shell">
    <p class="eyebrow">{site.name} / Archive</p>
    <h1>Portfolio</h1>
    <p class="index-hero__sub">Select a category</p>
  </section>
  <section class="portfolio-cards page-shell" aria-label="Portfolio categories">
    {entries.map((entry, index) => <CategoryCard entry={entry} number={index + 1} />)}
  </section>
</BaseLayout>

<style>
  .portfolio-cards {
    padding-bottom: clamp(8rem, 14vw, 14rem);
  }
</style>
