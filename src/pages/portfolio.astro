---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import FeaturedSeriesCard from '../components/FeaturedSeriesCard.astro';
import categories from '../data/portfolio-categories.json';
import site from '../data/site.json';

const entries = categories
  .map((entry, index) => ({
    entry,
    index,
    order: Number.isFinite(Number(entry.order)) ? Number(entry.order) : index + 1,
  }))
  .sort((a, b) => a.order - b.order || a.index - b.index)
  .map(({ entry }) => entry);

const numberedEntries = entries.map((entry, index) => ({ entry, number: index + 1 }));
const portraitFeature = numberedEntries.find(({ entry }) => entry.id === 'portrait');
const standardEntries = numberedEntries.filter(({ entry }) => ['street', 'scenes', 'nature'].includes(entry.id));
const seriesFeatures = numberedEntries.filter(({ entry }) => entry.id === 'series');
---

<BaseLayout title={`Portfolio — ${site.name}`}>
  <section class="archive-opening page-shell" aria-labelledby="archive-title">
    <header class="archive-intro">
      <h1 id="archive-title">Portfolio</h1>
      <p class="archive-intro__copy">Photographs arranged by subject, then gathered into longer stories.</p>
    </header>

    {portraitFeature && (
      <div class="portfolio-entry__portrait">
        <FeaturedSeriesCard entry={portraitFeature.entry} number={portraitFeature.number} priority compact />
      </div>
    )}
  </section>

  <section class="archive-categories page-shell" aria-label="Portfolio categories">
    <div class="archive-cards">
      {standardEntries.map(({ entry, number }) => (
        <CategoryCard entry={entry} number={number} />
      ))}
    </div>
  </section>

  <section class="archive-series page-shell" aria-label="Photography series">
    {seriesFeatures.map(({ entry, number }) => (
      <div class="portfolio-entry__feature">
        <FeaturedSeriesCard entry={entry} number={number} />
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .archive-opening {
    margin-top: -.75rem;
    padding-top: 0;
    padding-bottom: clamp(2.5rem, 5vh, 4rem);
    display: flex;
    flex-direction: column;
  }

  .archive-opening,
  .archive-categories,
  .archive-series {
    padding-inline: clamp(1.25rem, 2.5vw, 2.75rem);
  }

  .archive-intro {
    flex: 0 0 auto;
  }

  .archive-intro h1 {
    margin-top: 0;
    font: 400 clamp(4.5rem, 7.4vw, 7.25rem)/.84 var(--serif);
    letter-spacing: 0;
  }

  .archive-intro__copy {
    margin-top: clamp(.9rem, 1.8vh, 1.25rem);
    margin-bottom: clamp(1.4rem, 2.5vh, 2rem);
    color: var(--muted);
    font: 400 clamp(1rem, 1.25vw, 1.2rem)/1.5 var(--serif);
    white-space: nowrap;
  }

  .portfolio-entry__portrait {
    margin-top: 0;
  }

  .archive-categories {
    min-height: 100svh;
    padding-block: clamp(3rem, 6vh, 5rem);
    display: grid;
    align-items: center;
    box-sizing: border-box;
  }

  .archive-cards {
    min-height: 0;
    width: min(100%, 94rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3.5rem);
  }

  .archive-cards :global(.category-card) {
    height: auto;
    min-height: 0;
    aspect-ratio: 5 / 8;
    grid-template-rows: clamp(8rem, 9vw, 9.5rem) minmax(0, 1fr);
  }

  .archive-cards :global(.category-card h2) {
    margin-top: 1.4rem;
    font-size: clamp(1.5rem, 2vw, 2.1rem);
    letter-spacing: 0;
  }

  .archive-cards :global(.category-card__header p) {
    max-width: 32ch;
    margin-top: .5rem;
    display: -webkit-box;
    overflow: hidden;
    font-size: clamp(.6rem, .64vw, .68rem);
    line-height: 1.55;
    letter-spacing: .055em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .archive-cards :global(.category-card__header) {
    padding: clamp(1rem, 1.35vw, 1.3rem);
  }

  .archive-cards :global(.category-card__number),
  .archive-cards :global(.category-card__arrow) {
    top: clamp(1rem, 1.35vw, 1.3rem);
  }

  .archive-cards :global(.category-card__number) {
    left: clamp(1rem, 1.35vw, 1.3rem);
  }

  .archive-cards :global(.category-card__arrow) {
    right: clamp(1rem, 1.35vw, 1.3rem);
  }

  .archive-series {
    padding-bottom: clamp(8rem, 14vw, 14rem);
  }

  .portfolio-entry__feature {
    margin-top: clamp(4.5rem, 7vw, 7rem);
  }

  @media (max-width: 900px) {
    .archive-opening,
    .archive-categories,
    .archive-series {
      padding-inline: clamp(1.25rem, 3.5vw, 2.5rem);
    }

    .archive-intro h1 {
      font-size: clamp(4.5rem, 11vw, 6.5rem);
    }

    .archive-intro__copy {
      font-size: 1rem;
    }

    .archive-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1rem, 2.2vw, 1.5rem);
    }

    .archive-cards :global(.category-card) {
      aspect-ratio: 5 / 8;
      grid-template-rows: clamp(7.5rem, 13vw, 8.5rem) minmax(0, 1fr);
    }

    .archive-cards :global(.category-card h2) {
      font-size: clamp(1.6rem, 3vw, 2.15rem);
    }

    .archive-cards :global(.category-card__header p) {
      max-width: 38ch;
      font-size: clamp(.62rem, 1.1vw, .7rem);
    }

    .portfolio-entry__feature {
      margin-top: 4rem;
    }

    .archive-categories {
      padding-block: 4rem;
    }
  }

  @media (max-width: 620px) {
    .archive-opening {
      margin-top: 0;
      padding-top: 1.5rem;
      padding-inline: clamp(1rem, 4.5vw, 1.15rem);
      padding-bottom: 2rem;
    }

    .archive-categories,
    .archive-series {
      padding-inline: clamp(1rem, 4.5vw, 1.15rem);
    }

    .archive-categories {
      min-height: 0;
      padding-block: 4rem;
    }

    .portfolio-entry__portrait {
      margin-top: 1rem;
    }

    .archive-intro h1 {
      font-size: clamp(4rem, 20vw, 6rem);
    }

    .archive-intro__copy {
      white-space: normal;
    }

    .archive-cards {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }

    .archive-cards :global(.category-card) {
      min-height: 0;
      aspect-ratio: auto;
      grid-template-rows: clamp(7.25rem, 31vw, 7.75rem) auto;
    }

    .archive-cards :global(.category-card__media) {
      aspect-ratio: 4 / 3;
    }

    .archive-cards :global(.category-card h2) {
      font-size: clamp(1.65rem, 7vw, 2rem);
    }

    .archive-cards :global(.category-card__header p) {
      font-size: clamp(.62rem, 2.5vw, .68rem);
    }
  }

  @media (max-width: 430px) {
    .archive-intro__copy br {
      display: none;
    }

  }
</style>
