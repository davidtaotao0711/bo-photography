---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { photoCategories } from '../data/categories.js';
import site from '../data/site.json';

const entries = [
  ...photoCategories.map((category) => ({ title: category.title, href: `/portfolio/${category.slug}`, note: category.note })),
  { title: 'Series', href: '/series', note: 'Longer stories, edited as small books.' },
].map((entry, index) => ({ ...entry, number: String(index + 1).padStart(2, '0') }));
---

<BaseLayout title={`Portfolio — ${site.name}`}>
  <section class="index-hero page-shell">
    <p class="eyebrow">{site.name} / Archive</p>
    <h1>Portfolio</h1>
    <p class="index-hero__sub">Select a category</p>
  </section>
  <section class="portfolio-index page-shell" aria-label="Portfolio categories">
    {entries.map((entry) => (
      <a class="index-row" href={entry.href} data-scroll-reveal>
        <span class="index-row__number">{entry.number}</span>
        <h2>{entry.title}</h2>
        <p>{entry.note}</p>
        <span class="index-row__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
  <ScrollReveal />
</BaseLayout>
