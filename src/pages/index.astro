---
import BaseLayout from '../layouts/BaseLayout.astro';
import CanvasGrain from '../components/CanvasGrain.astro';
import HomeIntro from '../components/HomeIntro.astro';
import PhotoCard from '../components/PhotoCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import photos from '../data/photos.json';
import site from '../data/site.json';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

const featured = photos.filter((photo) => photo.featured).slice(0, 12);
const publicDir = fileURLToPath(new URL('../../public/', import.meta.url));
const introImages = site.homeIntroImages
  .map((src, index) => {
    const photo = photos.find((item) => item.image === src);
    const mobileFilename = `mobile-${String(index + 1).padStart(2, '0')}.jpg`;
    const mobileSrc = `/images/home-mobile/${mobileFilename}`;

    return {
      src,
      mobileSrc: existsSync(join(publicDir, 'images', 'home-mobile', mobileFilename))
        ? mobileSrc
        : undefined,
      alt: photo?.alt || `Nature photograph by ${site.name}`,
    };
  })
  .slice(0, 6);
---

<BaseLayout transparentHeader>
  <div class="homepage-root">
    <CanvasGrain />
    <HomeIntro images={introImages} name={site.name} tagline={site.tagline} />

  <section class="selected page-shell" id="selected-work">
    <header class="section-intro">
      <p class="eyebrow">Selected Work</p>
      <h2>Photographs from<br />near and elsewhere.</h2>
    </header>
    <div class="selected-grid">
      {featured.map((photo, index) => <PhotoCard photo={photo} eager={index < 2} homeCaptionMode reveal />)}
    </div>
    <div class="section-end"><a class="text-link" href="/portfolio">View all work <span>↗</span></a></div>
  </section>
    <ScrollReveal />
  </div>
</BaseLayout>

<style>
  :global(html:has(.homepage-root)),
  :global(body:has(.homepage-root)) {
    --home-bg: #f4f0e6;
    background: var(--home-bg);
  }

  .homepage-root {
    --home-bg: #f4f0e6;
    min-height: 100vh;
    position: relative;
    background: var(--home-bg);
  }

  :global(.homepage-root .section-intro),
  :global(.homepage-root .section-end) {
    position: relative;
    z-index: 21;
  }

  :global(.homepage-root .photo-card__home-caption) {
    z-index: 21;
  }
</style>

<script>
  const initHomeCaptions = () => {
    const grid = document.querySelector('.selected-grid');
    if (!grid || grid.dataset.homeCaptionsReady === 'true') return;
    grid.dataset.homeCaptionsReady = 'true';

    const cards = Array.from(grid.querySelectorAll('[data-home-caption]'));
    let activeCard = null;

    const closeCard = (card) => {
      const caption = card.querySelector('.photo-card__home-caption');
      const trigger = card.querySelector('.photo-card__trigger');
      card.classList.remove('is-caption-active');
      if (caption) {
        caption.classList.remove('is-visible');
        caption.setAttribute('aria-hidden', 'true');
      }
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    };

    cards.forEach((card) => {
      const trigger = card.querySelector('.photo-card__trigger');
      const caption = card.querySelector('.photo-card__home-caption');
      const titleElement = card.querySelector('.photo-card__home-title');
      const copyElement = card.querySelector('.photo-card__home-copy');
      if (!trigger || !caption || !titleElement || !copyElement) return;

      const title = (card.getAttribute('data-home-title') || '').trim();
      const copy = (card.getAttribute('data-home-caption-text') || '').trim();
      titleElement.textContent = title;
      copyElement.textContent = copy;
      caption.setAttribute('aria-hidden', 'true');

      trigger.addEventListener('click', () => {
        if (!title && !copy) return;

        if (activeCard === card) {
          closeCard(card);
          activeCard = null;
          return;
        }

        if (activeCard) closeCard(activeCard);

        activeCard = card;
        card.classList.add('is-caption-active');
        trigger.setAttribute('aria-expanded', 'true');
        caption.setAttribute('aria-hidden', 'false');
        caption.classList.add('is-visible');
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomeCaptions, { once: true });
  } else {
    initHomeCaptions();
  }

  document.addEventListener('astro:page-load', initHomeCaptions);
</script>
