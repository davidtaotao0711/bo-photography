---
import photos from '../data/photos.json';
import series from '../data/series.json';
import { photoCategories as categoryConfig } from '../data/categories.js';

const serializedPhotos = JSON.stringify(photos).replace(/</g, '\\u003c');
const serializedSeries = JSON.stringify(series).replace(/</g, '\\u003c');
const serializedCategories = JSON.stringify(categoryConfig).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>本地排版编辑器 · Bo David</title>
  </head>
  <body>
    <script id="initial-photos" type="application/json" set:html={serializedPhotos}></script>
    <script id="initial-series" type="application/json" set:html={serializedSeries}></script>
    <script id="initial-categories" type="application/json" set:html={serializedCategories}></script>

    <header class="editor-header">
      <a class="wordmark" href="/">BO DAVID</a>
      <div>
        <span class="local-badge"><i></i> 本地编辑</span>
        <a class="site-link" href="/" target="_blank">查看网站 ↗</a>
      </div>
    </header>

    <main class="editor-shell">
      <aside class="sidebar">
        <div class="sidebar-heading">
          <p class="eyebrow">Layout studio</p>
          <h1>排版<br />编辑器</h1>
          <p>首页与各分类页都可以独立拖动、缩放和调整照片。所有操作只发生在你的电脑上。</p>
        </div>

        <div class="field-group">
          <label for="view-filter">预览版面</label>
          <select id="view-filter">
            <option value="featured">首页精选</option>
            <option value="all">全部照片</option>
            {categoryConfig.map((category) => <option value={category.slug}>{category.title}</option>)}
            <option value="series">Series</option>
          </select>
        </div>

        <div class="field-group" id="photo-search-field">
          <label for="search">查找照片</label>
          <input id="search" type="search" placeholder="名称、地点或 ID" autocomplete="off" />
        </div>

        <div class="stats" aria-live="polite">
          <div><strong id="visible-count">0</strong><span id="visible-label">当前显示</span></div>
          <div><strong id="featured-count">0</strong><span id="featured-label">首页精选</span></div>
          <div><strong id="total-count">0</strong><span id="total-label">照片总数</span></div>
        </div>

        <div class="help">
          <p class="eyebrow">使用方法</p>
          <ol>
            <li>在首页或分类中按住照片自由移动</li>
            <li>使用上下箭头改变前后顺序</li>
            <li>点尺寸按钮或拖右下角缩放</li>
            <li>点击照片编辑属性</li>
            <li>Street / Scenes / Nature 会按横竖方向自动成行</li>
            <li>进入分类页后可一次添加单张或多张照片</li>
            <li>Series 先新建影集，再进入影集上传与选择封面</li>
            <li>删除只移除网站记录，不删除磁盘原图</li>
            <li>保存并覆盖 photos.json</li>
          </ol>
          <p class="note">首页只展示排在最前面的 12 张精选照片。</p>
        </div>
      </aside>

      <section class="workspace">
        <div class="toolbar">
          <div>
            <button class="button button--primary" id="open-file" type="button">打开 photos.json</button>
            <button class="button" id="save-file" type="button">保存</button>
          </div>
          <div>
            <button class="text-button" id="undo" type="button" disabled>撤销</button>
            <button class="text-button" id="download" type="button">下载副本</button>
            <button class="text-button text-button--danger" id="reset" type="button">恢复初始</button>
          </div>
        </div>

        <div class="status-row">
          <p><span id="view-title">首页精选</span><span id="canvas-scale"></span></p>
          <div class="status-actions">
            <p id="save-status" data-state="clean">已载入网站数据</p>
            <button class="add-photos" id="add-photos" type="button" hidden>
              <span class="add-photos__icon" aria-hidden="true">+</span>
              <span id="add-photos-label">添加照片</span>
            </button>
            <button class="add-photos" id="new-series" type="button" hidden>
              <span class="add-photos__icon" aria-hidden="true">+</span>
              <span>New Series</span>
            </button>
          </div>
        </div>

        <div id="empty-state" class="empty-state" hidden>
          <p>没有找到照片</p>
          <button class="text-button" id="clear-search" type="button">清除搜索</button>
        </div>
        <div id="canvas-viewport" class="canvas-viewport">
          <div id="canvas-stage" class="canvas-stage">
            <div id="photo-grid" class="photo-grid" aria-label="可自由定位的照片版面"></div>
          </div>
        </div>
        <div id="series-workspace" class="series-workspace" hidden>
          <section id="series-list-view">
            <header class="series-editor-head">
              <div>
                <p class="eyebrow">Series library</p>
                <h2>影集书架</h2>
              </div>
              <p>先创建一本影集，再进入其中上传、排序并选择封面。</p>
            </header>
            <div id="series-editor-grid" class="series-editor-grid"></div>
          </section>

          <section id="series-detail-view" class="series-manager" hidden>
            <button class="series-back" id="series-back" type="button">← 返回影集书架</button>
            <header class="series-manager__head">
              <div>
                <p class="eyebrow">Series manager</p>
                <h2 id="series-manager-title"></h2>
                <p id="series-manager-meta"></p>
              </div>
              <div class="series-manager__actions">
                <button class="add-photos" id="upload-series-photos" type="button">
                  <span class="add-photos__icon" aria-hidden="true">+</span>
                  <span>Upload Photos</span>
                </button>
                <button class="button" id="edit-active-series" type="button">Edit Series</button>
              </div>
            </header>
            <div class="series-layout-toolbar">
              <div>
                <button class="text-button" id="add-portrait-row" type="button">+ Portrait Row</button>
                <button class="text-button" id="add-landscape-row" type="button">+ Landscape Row</button>
              </div>
              <button class="button button--primary" id="save-series-layout" type="button" disabled>Save Layout</button>
            </div>
            <div id="series-photo-empty" class="series-photo-empty" hidden>
              <p>这本影集还没有照片</p>
              <span>上传后的第一张照片会自动成为封面。</span>
            </div>
            <div id="series-photo-grid" class="series-photo-grid"></div>
          </section>
        </div>
      </section>
    </main>

    <dialog id="inspector">
      <form id="photo-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Photo details</p>
            <h2>照片设置</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>

        <div class="dialog-preview"><img id="form-preview" src="" alt="" /></div>
        <input id="form-original-id" type="hidden" />
        <div class="form-grid">
          <label>标题<input id="form-title" required /></label>
          <label>唯一 ID<input id="form-id" required pattern="[a-zA-Z0-9_-]+" /></label>
          <label>分类
            <select id="form-category" required>
              {categoryConfig.map((category) => <option value={category.slug}>{category.title}</option>)}
              <option value="series">Series</option>
            </select>
          </label>
          <label>画面方向
            <select id="form-orientation" required>
              <option value="landscape">横图</option>
              <option value="portrait">竖图</option>
            </select>
          </label>
          <label>显示尺寸（%）<input id="form-layout-width" type="number" min="45" max="200" step="1" required /></label>
          <label>水平位置（%）<input id="form-offset-x" type="number" min="-80" max="80" step="1" required /></label>
          <label>垂直位置（%）<input id="form-offset-y" type="number" min="-80" max="80" step="1" required /></label>
          <label>地点<input id="form-location" /></label>
          <label>日期<input id="form-date" /></label>
          <label>所属系列<input id="form-series" placeholder="没有可留空" /></label>
          <label>图片路径<input id="form-image" required /></label>
          <label class="full">图片描述<textarea id="form-alt" rows="3" required></textarea></label>
          <label class="toggle full"><input id="form-featured" type="checkbox" /><span></span>显示在首页精选</label>
        </div>
        <p id="form-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <button class="text-button text-button--danger" id="delete-photo" type="button">删除照片</button>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="apply-photo" type="button">应用修改</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="series-dialog" class="series-dialog">
      <form id="series-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">New photo book</p>
            <h2>New Series</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="series-dialog__intro">名称会自动生成网址 slug，你也可以在创建前微调。</p>
        <div class="form-grid">
          <label>Series 名称<input id="series-title" required placeholder="Tokyo 2026" /></label>
          <label>Slug<input id="series-slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="tokyo-2026" /></label>
          <label>年份<input id="series-year" placeholder="2026" /></label>
          <label class="full">简短说明<textarea id="series-description" rows="3" placeholder="可稍后填写"></textarea></label>
        </div>
        <p id="series-form-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="create-series" type="button">创建 Series</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="series-edit-dialog" class="series-dialog">
      <form id="series-edit-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Edit photo book</p>
            <h2>Edit Series</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="series-dialog__intro">Slug 创建后保持不变，避免图片路径和公开链接失效。</p>
        <input id="series-edit-original-slug" type="hidden" />
        <div class="form-grid">
          <label>Series 名称<input id="series-edit-title" required /></label>
          <label>Slug<input id="series-edit-slug" readonly /></label>
          <label>年份<input id="series-edit-year" /></label>
          <label>展示顺序<input id="series-edit-order" type="number" min="1" step="1" required /></label>
          <label class="full">封面路径<input id="series-edit-cover" placeholder="/images/series/slug/001.jpg" /></label>
          <label class="full">简短说明<textarea id="series-edit-description" rows="3"></textarea></label>
        </div>
        <p id="series-edit-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <button class="text-button text-button--danger" id="request-delete-series" type="button">Delete Series</button>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="save-series-edit" type="button">保存修改</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="series-delete-dialog" class="warning-dialog">
      <form id="series-delete-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Move to trash</p>
            <h2>确认删除 Series</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="warning-copy">这会移除该 Series 及其照片记录，并把图片文件夹移动到 <code>trash/series/</code>。请输入 slug 再确认。</p>
        <label class="delete-confirm-label">输入 <strong id="series-delete-slug-label"></strong>
          <input id="series-delete-confirmation" autocomplete="off" required />
        </label>
        <p id="series-delete-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--danger" id="confirm-delete-series" type="button" disabled>Move to Trash</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="large-file-warning" class="warning-dialog">
      <form method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">File size warning</p>
            <h2>图片超过 5 MB</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="warning-copy">以下图片可能影响网页加载速度。你仍然可以继续添加，之后建议压缩图片。</p>
        <ul id="large-file-list" class="warning-list"></ul>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" value="continue" type="submit">仍然添加</button>
          </div>
        </div>
      </form>
    </dialog>

    <input id="file-fallback" type="file" accept="application/json,.json" hidden />
    <input id="photo-file-input" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple hidden />
    <input id="series-photo-input" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple hidden />
    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      import { buildOrientationRows } from '../utils/photo-layout.js';

      const initialNode = document.querySelector('#initial-photos');
      const initialSeriesNode = document.querySelector('#initial-series');
      const initialCategoriesNode = document.querySelector('#initial-categories');
      const initialPhotos = JSON.parse(initialNode?.textContent || '[]');
      const initialSeries = JSON.parse(initialSeriesNode?.textContent || '[]');
      const photoCategoryConfig = JSON.parse(initialCategoriesNode?.textContent || '[]');
      let photoData = structuredClone(initialPhotos);
      let seriesData = structuredClone(initialSeries);
      let fileHandle = null;
      let dirty = false;
      let activeSeriesSlug = sessionStorage.getItem('editorSeriesSlug') || '';
      let layoutDraftSlug = '';
      let layoutDraftRows = [];
      let layoutDirty = false;
      const history = [];
      const maxRecommendedFileSize = 5 * 1024 * 1024;
      const photoCategories = photoCategoryConfig.map((category) => category.slug);
      const rowLayoutCategories = photoCategoryConfig.filter((category) => category.rowLayout).map((category) => category.slug);

      const grid = document.querySelector('#photo-grid');
      const viewFilter = document.querySelector('#view-filter');
      const searchInput = document.querySelector('#search');
      const inspector = document.querySelector('#inspector');
      const formError = document.querySelector('#form-error');
      const canvasViewport = document.querySelector('#canvas-viewport');
      const canvasStage = document.querySelector('#canvas-stage');
      const addPhotosButton = document.querySelector('#add-photos');
      const addPhotosLabel = document.querySelector('#add-photos-label');
      const largeFileWarning = document.querySelector('#large-file-warning');
      const newSeriesButton = document.querySelector('#new-series');
      const seriesWorkspace = document.querySelector('#series-workspace');
      const seriesListView = document.querySelector('#series-list-view');
      const seriesDetailView = document.querySelector('#series-detail-view');
      const seriesEditorGrid = document.querySelector('#series-editor-grid');
      const seriesPhotoGrid = document.querySelector('#series-photo-grid');
      const seriesDialog = document.querySelector('#series-dialog');
      const seriesEditDialog = document.querySelector('#series-edit-dialog');
      const seriesDeleteDialog = document.querySelector('#series-delete-dialog');

      const savedView = sessionStorage.getItem('editorView');
      if (['featured', 'all', ...photoCategories, 'series'].includes(savedView)) viewFilter.value = savedView;

      const $ = (selector) => document.querySelector(selector);
      const escapeHtml = (value = '') => String(value)
        .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

      function snapshot() {
        history.push(structuredClone(photoData));
        if (history.length > 30) history.shift();
        $('#undo').disabled = false;
      }

      function setDirty(value, message) {
        dirty = value;
        const status = $('#save-status');
        status.dataset.state = value ? 'dirty' : 'clean';
        status.textContent = message || (value ? '有未保存修改' : '所有修改已保存');
      }

      function showToast(message) {
        const toast = $('#toast');
        toast.textContent = message;
        toast.classList.add('is-visible');
        window.clearTimeout(showToast.timer);
        showToast.timer = window.setTimeout(() => toast.classList.remove('is-visible'), 2400);
      }

      function getVisiblePhotos() {
        const filter = viewFilter.value;
        const query = searchInput.value.trim().toLowerCase();
        return photoData.filter((photo) => {
          const matchesView = filter === 'all' || (filter === 'featured' ? photo.featured : photo.category === filter);
          const haystack = [photo.id, photo.title, photo.location, photo.series, photo.alt].join(' ').toLowerCase();
          return matchesView && (!query || haystack.includes(query));
        });
      }

      function getLayoutScope() {
        if (viewFilter.value === 'featured') return 'home';
        if (photoCategories.includes(viewFilter.value)) return 'category';
        return null;
      }

      function getLayoutProperty(scope, type) {
        if (scope === 'category') {
          if (type === 'width') return 'categoryLayoutWidth';
          return axisProperty('categoryLayoutOffset', type);
        }
        if (type === 'width') return 'layoutWidth';
        return axisProperty('layoutOffset', type);
      }

      function axisProperty(prefix, axis) {
        return `${prefix}${axis === 'x' ? 'X' : 'Y'}`;
      }

      function getDefaultLayoutWidth(photo, scope) {
        return scope === 'category' && photo.category === 'portrait' ? 78 : 100;
      }

      function getLayoutWidth(photo, scope = getLayoutScope()) {
        const width = Number(photo[getLayoutProperty(scope, 'width')]);
        return Number.isFinite(width)
          ? Math.min(200, Math.max(45, Math.round(width)))
          : getDefaultLayoutWidth(photo, scope);
      }

      function getLayoutOffset(photo, axis, scope = getLayoutScope()) {
        const offset = Number(photo[getLayoutProperty(scope, axis)]);
        return Number.isFinite(offset) ? Math.min(80, Math.max(-80, Math.round(offset))) : 0;
      }

      function setLayoutWidth(photo, value, scope = getLayoutScope()) {
        if (!scope) return;
        photo[getLayoutProperty(scope, 'width')] = Math.min(200, Math.max(45, Math.round(value)));
      }

      function setLayoutOffset(photo, axis, value, scope = getLayoutScope()) {
        if (!scope) return;
        photo[getLayoutProperty(scope, axis)] = Math.min(80, Math.max(-80, Math.round(value)));
      }

      function syncCanvasScale() {
        if (!canvasViewport || !canvasStage) return;
        canvasStage.style.zoom = '1';
        if (window.innerWidth <= 620) {
          canvasStage.style.width = '100%';
        } else {
          const sitePadding = Math.min(72, Math.max(20, window.innerWidth * 0.04));
          canvasStage.style.width = `${document.documentElement.clientWidth - sitePadding * 2}px`;
        }
        const designWidth = canvasStage.offsetWidth;
        const availableWidth = canvasViewport.clientWidth;
        const scale = window.innerWidth <= 620 || !designWidth ? 1 : Math.min(1, availableWidth / designWidth);
        canvasStage.style.zoom = String(scale);
        $('#canvas-scale').textContent = window.innerWidth <= 620 ? '' : ` · 完整画布 ${Math.round(scale * 100)}% 预览`;
      }

      function orderedSeries() {
        return seriesData
          .map((item, index) => ({ item, index, order: Number.isFinite(Number(item.order)) ? Number(item.order) : index + 1 }))
          .sort((a, b) => a.order - b.order || a.index - b.index)
          .map(({ item }) => item);
      }

      function photosForSeries(slug) {
        return photoData
          .map((photo, index) => ({ photo, index, order: Number.isFinite(Number(photo.order)) ? Number(photo.order) : index + 1 }))
          .filter(({ photo }) => photo.series === slug)
          .sort((a, b) => a.order - b.order || a.index - b.index)
          .map(({ photo }) => photo);
      }

      function seriesCover(item, items = photosForSeries(item.slug)) {
        return item.coverImage || items[0]?.image || '';
      }

      function maxRowPhotos(orientation) {
        return orientation === 'portrait' ? 4 : 3;
      }

      function defaultSeriesRows(items) {
        return buildOrientationRows(items).map((row) => ({
          orientation: row.orientation,
          photoIds: row.items.map((photo) => photo.id),
        }));
      }

      function normalizedSeriesRows(item, items) {
        const photosById = new Map(items.map((photo) => [photo.id, photo]));
        const used = new Set();
        const rows = [];
        if (Array.isArray(item.layoutRows)) {
          item.layoutRows.forEach((row) => {
            const orientation = row?.orientation === 'portrait' ? 'portrait' : 'landscape';
            const photoIds = Array.isArray(row?.photoIds)
              ? row.photoIds.filter((id) => {
                  const photo = photosById.get(id);
                  if (!photo || used.has(id) || photo.orientation !== orientation) return false;
                  used.add(id);
                  return true;
                }).slice(0, maxRowPhotos(orientation))
              : [];
            if (photoIds.length) rows.push({ orientation, photoIds });
          });
        }
        const missing = items.filter((photo) => !used.has(photo.id));
        defaultSeriesRows(missing).forEach((row) => rows.push(row));
        return rows;
      }

      function ensureLayoutDraft(item, items) {
        if (layoutDraftSlug === item.slug) return;
        layoutDraftSlug = item.slug;
        layoutDraftRows = normalizedSeriesRows(item, items);
        layoutDirty = false;
        $('#save-series-layout').disabled = true;
      }

      function markLayoutDirty() {
        layoutDirty = true;
        $('#save-series-layout').disabled = false;
      }

      function renderSeriesRows(items, cover) {
        const byId = new Map(items.map((photo) => [photo.id, photo]));
        seriesPhotoGrid.innerHTML = layoutDraftRows.map((row, rowIndex) => {
          const rowPhotos = row.photoIds.map((id) => byId.get(id)).filter(Boolean);
          const max = maxRowPhotos(row.orientation);
          return `
            <section class="series-layout-row" data-row-index="${rowIndex}">
              <header class="series-layout-row__head">
                <span>${rowPhotos.length}/${max}</span>
                <div>
                  <button type="button" data-row-action="decrease" aria-label="减少本行照片" ${rowPhotos.length <= 1 ? 'disabled' : ''}>−</button>
                  <button type="button" data-row-action="increase" aria-label="增加本行照片" ${rowPhotos.length >= max ? 'disabled' : ''}>+</button>
                  <button type="button" data-row-action="up" aria-label="本行上移" ${rowIndex === 0 ? 'disabled' : ''}>↑</button>
                  <button type="button" data-row-action="down" aria-label="本行下移" ${rowIndex === layoutDraftRows.length - 1 ? 'disabled' : ''}>↓</button>
                </div>
              </header>
              <div class="series-layout-row__photos series-layout-row__photos--${row.orientation}" style="--row-columns:${Math.max(1, rowPhotos.length)}">
                ${rowPhotos.map((photo, index) => `
                  <article class="series-photo-card ${photo.image === cover ? 'is-cover' : ''}">
                    <div class="series-photo-card__image">
                      <img src="${escapeHtml(photo.image)}" alt="${escapeHtml(photo.alt || '')}" loading="lazy" />
                      <span>${String(index + 1).padStart(2, '0')}</span>
                      ${photo.image === cover ? '<strong>Cover</strong>' : ''}
                    </div>
                    <div class="series-photo-card__meta">
                      <span>${photo.orientation === 'portrait' ? '竖图' : '横图'}</span>
                      ${photo.image === cover ? '<span>当前封面</span>' : `<button type="button" data-cover-image="${escapeHtml(photo.image)}">Set as Cover</button>`}
                    </div>
                  </article>`).join('')}
              </div>
            </section>`;
        }).join('');
      }

      function renderSeries() {
        const ordered = orderedSeries();
        const activeItem = ordered.find((item) => item.slug === activeSeriesSlug);
        if (activeSeriesSlug && !activeItem) {
          activeSeriesSlug = '';
          sessionStorage.removeItem('editorSeriesSlug');
        }

        seriesListView.hidden = Boolean(activeItem);
        seriesDetailView.hidden = !activeItem;
        newSeriesButton.hidden = Boolean(activeItem);
        $('#visible-count').textContent = String(ordered.length);
        $('#featured-count').textContent = String(ordered.filter((item) => seriesCover(item)).length);
        $('#total-count').textContent = String(photoData.length);
        $('#visible-label').textContent = '影集数量';
        $('#featured-label').textContent = '已有封面';
        $('#total-label').textContent = '照片总数';

        if (!activeItem) {
          $('#view-title').textContent = `Series · ${ordered.length} 本影集`;
          seriesEditorGrid.innerHTML = ordered.map((item, index) => {
            const items = photosForSeries(item.slug);
            const cover = seriesCover(item, items);
            return `
              <article class="series-editor-card" data-slug="${escapeHtml(item.slug)}">
                <button class="series-editor-card__open" type="button" data-series-action="open" aria-label="管理 ${escapeHtml(item.title)}">
                  <span class="series-editor-card__cover ${cover ? '' : 'is-empty'}">
                    ${cover ? `<img src="${escapeHtml(cover)}" alt="" loading="lazy" />` : '<span>Empty series</span>'}
                  </span>
                  <span class="series-editor-card__body">
                    <span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.year || '未填写年份')}</small></span>
                    <span>${items.length} photos</span>
                  </span>
                </button>
                <div class="series-editor-card__order" aria-label="Series 管理">
                  <button type="button" data-series-action="edit" aria-label="编辑 ${escapeHtml(item.title)}">Edit</button>
                  <button class="is-danger" type="button" data-series-action="delete" aria-label="删除 ${escapeHtml(item.title)}">Delete</button>
                  <button type="button" data-series-action="up" aria-label="向前移动" ${index === 0 ? 'disabled' : ''}>↑</button>
                  <button type="button" data-series-action="down" aria-label="向后移动" ${index === ordered.length - 1 ? 'disabled' : ''}>↓</button>
                </div>
              </article>`;
          }).join('');
          return;
        }

        const items = photosForSeries(activeItem.slug);
        const cover = seriesCover(activeItem, items);
        ensureLayoutDraft(activeItem, items);
        $('#view-title').textContent = `${activeItem.title} · Series manager`;
        $('#series-manager-title').textContent = activeItem.title;
        $('#series-manager-meta').textContent = `${activeItem.year || '未填写年份'} · ${items.length} photographs · ${activeItem.slug}`;
        $('#series-photo-empty').hidden = items.length > 0;
        seriesPhotoGrid.hidden = items.length === 0;
        $('#add-portrait-row').disabled = !items.some((photo) => photo.orientation === 'portrait');
        $('#add-landscape-row').disabled = !items.some((photo) => photo.orientation !== 'portrait');
        if (items.length) renderSeriesRows(items, cover);
      }

      function render() {
        const isSeriesView = viewFilter.value === 'series';
        sessionStorage.setItem('editorView', viewFilter.value);
        seriesWorkspace.hidden = !isSeriesView;
        canvasViewport.hidden = isSeriesView;
        $('#empty-state').hidden = true;
        $('#photo-search-field').hidden = isSeriesView;
        addPhotosButton.hidden = true;
        newSeriesButton.hidden = !isSeriesView || Boolean(activeSeriesSlug);
        $('#canvas-scale').textContent = '';
        if (isSeriesView) {
          grid.hidden = true;
          renderSeries();
          return;
        }

        const visible = getVisiblePhotos();
        $('#visible-label').textContent = '当前显示';
        $('#featured-label').textContent = '首页精选';
        $('#total-label').textContent = '照片总数';
        const layoutScope = getLayoutScope();
        const isFreeLayout = Boolean(layoutScope);
        const isOrientationLayout = rowLayoutCategories.includes(viewFilter.value);
        const orientationRows = isOrientationLayout ? buildOrientationRows(visible) : [];
        const displayPhotos = isOrientationLayout ? orientationRows.flatMap((row) => row.items) : visible;
        const filterLabel = viewFilter.options[viewFilter.selectedIndex]?.textContent || '';
        const importCategory = photoCategories.includes(viewFilter.value) ? viewFilter.value : null;
        $('#view-title').textContent = isFreeLayout ? `${filterLabel} · 独立拖动与缩放` : `${filterLabel} · 数据总览`;
        addPhotosButton.hidden = !importCategory;
        newSeriesButton.hidden = true;
        if (importCategory && !addPhotosButton.disabled) addPhotosLabel.textContent = `添加到 ${filterLabel}`;
        $('#visible-count').textContent = String(visible.length);
        $('#featured-count').textContent = String(photoData.filter((photo) => photo.featured).length);
        $('#total-count').textContent = String(photoData.length);
        $('#empty-state').hidden = visible.length > 0;
        grid.hidden = visible.length === 0;
        grid.dataset.view = viewFilter.value;
        grid.classList.toggle('photo-grid--rows', isOrientationLayout);

        let featuredPosition = 0;
        const cards = displayPhotos.map((photo, index) => {
          const layoutWidth = isFreeLayout ? getLayoutWidth(photo, layoutScope) : 100;
          const offsetX = isFreeLayout ? getLayoutOffset(photo, 'x', layoutScope) : 0;
          const offsetY = isFreeLayout ? getLayoutOffset(photo, 'y', layoutScope) : 0;
          if (photo.featured) featuredPosition += 1;
          const publishBadge = viewFilter.value === 'featured' && featuredPosition > 12
            ? '<span class="card-badge card-badge--muted">首页不展示</span>'
            : `<span class="card-badge">${String(index + 1).padStart(2, '0')}</span>`;
          const layoutControls = isFreeLayout ? `
                <button class="position-control ${offsetX || offsetY ? 'is-active' : ''}" type="button" data-action="reset-position" aria-label="位置归零，当前水平 ${offsetX}%，垂直 ${offsetY}%" title="点击恢复原位">⌖ ${offsetX}, ${offsetY}</button>
                <button class="size-control" type="button" data-action="size" aria-label="切换照片尺寸，当前 ${layoutWidth}%" title="点击切换尺寸">↔ ${layoutWidth}%</button>
                <button class="resize-handle" type="button" data-action="resize" aria-label="拖动以等比缩放照片" title="拖动以等比缩放"></button>` : '';
          const orderControls = `<div class="move-actions">
                  <button type="button" data-action="up" aria-label="向前移动">↑</button>
                  <button type="button" data-action="down" aria-label="向后移动">↓</button>
                </div>`;
          return `
            <article class="editor-card editor-card--${escapeHtml(photo.orientation)}" data-id="${escapeHtml(photo.id)}" style="--card-width: ${layoutWidth}%; --offset-x: ${offsetX}%; --offset-y: ${offsetY}%">
              <div class="editor-card__image">
                <img src="${escapeHtml(photo.image)}" alt="${escapeHtml(photo.alt)}" loading="lazy" />
                ${publishBadge}
                <button class="favorite ${photo.featured ? 'is-active' : ''}" type="button" data-action="featured" aria-label="${photo.featured ? '取消首页精选' : '加入首页精选'}" title="首页精选">★</button>
                <button class="delete-control" type="button" data-action="delete" aria-label="删除照片" title="从网站中删除">×</button>
                ${layoutControls}
                ${orderControls}
              </div>
              <button class="editor-card__meta" type="button" data-action="edit">
                <span><strong>${escapeHtml(photo.title || photo.id)}</strong>${escapeHtml(photo.location || '未填写地点')}</span>
                <span>${isOrientationLayout ? '方向分行 · 可编辑' : `${photo.orientation === 'portrait' ? '竖图' : '横图'} · 编辑`}</span>
              </button>
            </article>`;
        });
        if (isOrientationLayout) {
          let cardIndex = 0;
          grid.innerHTML = orientationRows.map((row, rowIndex) => {
            const max = maxRowPhotos(row.orientation);
            const hasLaterPhoto = orientationRows.slice(rowIndex + 1).some((candidate) => candidate.orientation === row.orientation);
            return `<section class="editor-row-wrap" data-category-row-index="${rowIndex}">
              <header class="category-row-controls">
                <span>${row.items.length}/${max}</span>
                <div>
                  <button type="button" data-category-row-action="decrease" aria-label="减少本行照片" ${row.items.length <= 1 ? 'disabled' : ''}>−</button>
                  <button type="button" data-category-row-action="increase" aria-label="增加本行照片" ${row.items.length >= max || !hasLaterPhoto ? 'disabled' : ''}>+</button>
                </div>
              </header>
              <div class="editor-row editor-row--${row.orientation}" style="--category-row-columns:${row.items.length}">${row.items.map(() => cards[cardIndex++]).join('')}</div>
            </section>`;
          }).join('');
        } else {
          grid.innerHTML = cards.join('');
        }
        window.requestAnimationFrame(syncCanvasScale);
      }

      function replaceVisibleOrder(orderedIds) {
        const idSet = new Set(orderedIds);
        let cursor = 0;
        photoData = photoData.map((photo) => {
          if (!idSet.has(photo.id)) return photo;
          const nextId = orderedIds[cursor++];
          return photoData.find((item) => item.id === nextId);
        });
      }

      function movePhoto(id, direction) {
        const visible = getVisiblePhotos();
        const current = visible.find((photo) => photo.id === id);
        if (!current) return;
        const orderedPhotos = rowLayoutCategories.includes(viewFilter.value)
          ? visible.filter((photo) => photo.orientation === current.orientation)
          : visible;
        const index = orderedPhotos.findIndex((photo) => photo.id === id);
        const nextIndex = index + direction;
        if (index < 0 || nextIndex < 0 || nextIndex >= orderedPhotos.length) return;
        snapshot();
        const ids = orderedPhotos.map((photo) => photo.id);
        [ids[index], ids[nextIndex]] = [ids[nextIndex], ids[index]];
        replaceVisibleOrder(ids);
        setDirty(true);
        render();
      }

      function openInspector(id) {
        const photo = photoData.find((item) => item.id === id);
        if (!photo) return;
        const layoutScope = getLayoutScope();
        const layoutLocked = !layoutScope;
        inspector.dataset.layoutScope = layoutScope || '';
        $('#form-original-id').value = photo.id;
        $('#form-id').value = photo.id;
        $('#form-title').value = photo.title || '';
        $('#form-category').value = photo.category;
        $('#form-orientation').value = photo.orientation;
        $('#form-layout-width').value = String(getLayoutWidth(photo, layoutScope));
        $('#form-offset-x').value = String(getLayoutOffset(photo, 'x', layoutScope));
        $('#form-offset-y').value = String(getLayoutOffset(photo, 'y', layoutScope));
        $('#form-layout-width').disabled = layoutLocked;
        $('#form-offset-x').disabled = layoutLocked;
        $('#form-offset-y').disabled = layoutLocked;
        $('#form-location').value = photo.location || '';
        $('#form-date').value = photo.date || '';
        $('#form-series').value = photo.series || '';
        $('#form-image').value = photo.image;
        $('#form-alt').value = photo.alt || '';
        $('#form-featured').checked = Boolean(photo.featured);
        $('#form-preview').src = photo.image;
        $('#form-preview').alt = photo.alt || '';
        formError.textContent = '';
        inspector.showModal();
      }

      function applyInspector() {
        const form = $('#photo-form');
        if (!form.reportValidity()) return;
        const oldId = $('#form-original-id').value;
        const newId = $('#form-id').value.trim();
        if (photoData.some((photo) => photo.id === newId && photo.id !== oldId)) {
          formError.textContent = `ID “${newId}” 已被另一张照片使用。`;
          return;
        }
        const index = photoData.findIndex((photo) => photo.id === oldId);
        if (index < 0) return;
        const layoutScope = inspector.dataset.layoutScope || null;
        snapshot();
        photoData[index] = {
          ...photoData[index],
          id: newId,
          title: $('#form-title').value.trim(),
          category: $('#form-category').value,
          series: $('#form-series').value.trim(),
          location: $('#form-location').value.trim(),
          date: $('#form-date').value.trim(),
          image: $('#form-image').value.trim(),
          featured: $('#form-featured').checked,
          orientation: $('#form-orientation').value,
          alt: $('#form-alt').value.trim(),
        };
        if (layoutScope) {
          setLayoutWidth(photoData[index], Number($('#form-layout-width').value), layoutScope);
          setLayoutOffset(photoData[index], 'x', Number($('#form-offset-x').value), layoutScope);
          setLayoutOffset(photoData[index], 'y', Number($('#form-offset-y').value), layoutScope);
        }
        inspector.close();
        setDirty(true);
        render();
        showToast('照片设置已应用');
      }

      function deletePhoto(id) {
        const photo = photoData.find((item) => item.id === id);
        if (!photo) return;
        if (!window.confirm(`确定从网站中删除“${photo.title || photo.id}”吗？\n\n这会移除 photos.json 中的记录，但不会删除磁盘里的原图文件。`)) return;
        snapshot();
        photoData = photoData.filter((item) => item.id !== id);
        if (inspector.open) inspector.close();
        setDirty(true, '照片已移除，保存后生效');
        render();
        showToast('照片已从网站记录中删除，可撤销');
      }

      function adjustCategoryRow(rowIndex, action) {
        if (!rowLayoutCategories.includes(viewFilter.value)) return;
        const visible = getVisiblePhotos();
        const rows = buildOrientationRows(visible);
        const row = rows[rowIndex];
        if (!row || !['increase', 'decrease'].includes(action)) return;
        const orientationRows = rows.filter((candidate) => candidate.orientation === row.orientation);
        const orientationIndex = rows.slice(0, rowIndex + 1).filter((candidate) => candidate.orientation === row.orientation).length - 1;
        const currentSizes = orientationRows.map((candidate) => candidate.items.length);
        const max = maxRowPhotos(row.orientation);
        const target = currentSizes[orientationIndex] + (action === 'increase' ? 1 : -1);
        if (target < 1 || target > max) return;

        const orientationPhotos = visible.filter((photo) => (photo.orientation === 'portrait' ? 'portrait' : 'landscape') === row.orientation);
        const photosBeforeNextRow = currentSizes.slice(0, orientationIndex + 1).reduce((sum, size) => sum + size, 0);
        if (action === 'increase' && photosBeforeNextRow >= orientationPhotos.length) return;

        snapshot();
        currentSizes[orientationIndex] = target;
        const nextSizes = [];
        let remaining = orientationPhotos.length;
        currentSizes.forEach((size) => {
          if (remaining <= 0) return;
          const nextSize = Math.min(max, Math.max(1, size), remaining);
          nextSizes.push(nextSize);
          remaining -= nextSize;
        });
        while (remaining > 0) {
          const nextSize = Math.min(row.orientation === 'portrait' ? 3 : 2, remaining);
          nextSizes.push(nextSize);
          remaining -= nextSize;
        }

        orientationPhotos.forEach((photo) => delete photo.categoryRowSize);
        let offset = 0;
        nextSizes.forEach((size) => {
          orientationPhotos[offset].categoryRowSize = size;
          offset += size;
        });
        setDirty(true);
        render();
        showToast(`本行已调整为 ${target} 张，点击保存写入 photos.json`);
      }

      function formatFileSize(bytes) {
        return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
      }

      function getImageDetails(file) {
        return new Promise((resolve, reject) => {
          const url = URL.createObjectURL(file);
          const image = new Image();
          image.onload = () => {
            URL.revokeObjectURL(url);
            resolve({
              orientation: image.naturalHeight > image.naturalWidth ? 'portrait' : 'landscape',
              aspect: image.naturalWidth / image.naturalHeight,
            });
          };
          image.onerror = () => {
            URL.revokeObjectURL(url);
            reject(new Error(`无法读取 ${file.name} 的图片尺寸。`));
          };
          image.src = url;
        });
      }

      async function getImageOrientation(file) {
        return (await getImageDetails(file)).orientation;
      }

      function confirmLargeFiles(files) {
        const largeFiles = files.filter((file) => file.size > maxRecommendedFileSize);
        if (!largeFiles.length) return Promise.resolve(true);
        $('#large-file-list').innerHTML = largeFiles
          .map((file) => `<li><span>${escapeHtml(file.name)}</span><strong>${formatFileSize(file.size)}</strong></li>`)
          .join('');
        largeFileWarning.showModal();
        return new Promise((resolve) => {
          largeFileWarning.addEventListener('close', () => resolve(largeFileWarning.returnValue === 'continue'), { once: true });
        });
      }

      async function importPhotos(files) {
        const category = viewFilter.value;
        if (!photoCategories.includes(category) || !files.length) return;

        addPhotosButton.disabled = true;
        addPhotosLabel.textContent = '正在添加…';
        try {
          const orientations = await Promise.all(files.map(getImageOrientation));
          const formData = new FormData();
          formData.append('category', category);
          files.forEach((file) => formData.append('photos', file, file.name));

          const response = await fetch('/__editor/import-photos', { method: 'POST', body: formData });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || '本地导入接口没有响应，请通过 npm run editor 打开编辑器。');

          const categoryCount = photoData.filter((photo) => photo.category === category).length;
          const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
          const year = String(new Date().getFullYear());
          const additions = result.files.map((savedFile, index) => ({
            id: savedFile.id,
            title: `No. ${String(categoryCount + index + 1).padStart(2, '0')}`,
            category,
            series: '',
            location: '',
            date: year,
            image: savedFile.image,
            featured: false,
            orientation: orientations[savedFile.index ?? index],
            alt: `${categoryLabel} photograph by Bo David`,
          }));

          const duplicate = additions.find((photo) => photoData.some((existing) => existing.id === photo.id));
          if (duplicate) throw new Error(`照片 ID ${duplicate.id} 已存在，请检查对应图片目录。`);
          snapshot();
          photoData.push(...additions);
          searchInput.value = '';
          setDirty(true, `已添加 ${additions.length} 张照片，请保存 photos.json`);
          render();
          showToast(`${additions.length} 张照片已添加并自动排列`);
        } catch (error) {
          window.alert(`添加照片失败：${error.message}`);
        } finally {
          addPhotosButton.disabled = false;
          const label = viewFilter.options[viewFilter.selectedIndex]?.textContent || '';
          addPhotosLabel.textContent = `添加到 ${label}`;
        }
      }

      function ensureSeriesActionReady() {
        if (!dirty) return true;
        window.alert('请先保存当前照片排版修改，再管理 Series。创建、上传或调整 Series 会刷新本地数据。');
        return false;
      }

      function ensureLayoutSaved() {
        if (!layoutDirty) return true;
        window.alert('请先保存当前 Series 行布局，再执行其他 Series 操作。');
        return false;
      }

      function slugify(value) {
        return String(value || '')
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/&/g, ' and ')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .replace(/-{2,}/g, '-');
      }

      async function postJson(url, body) {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || '本地 Series 操作失败。');
        return result;
      }

      function openSeriesDialog() {
        if (!ensureSeriesActionReady()) return;
        $('#series-form').reset();
        $('#series-form-error').textContent = '';
        seriesDialog.dataset.slugTouched = 'false';
        seriesDialog.showModal();
        $('#series-title').focus();
      }

      async function createNewSeries() {
        const form = $('#series-form');
        if (!form.reportValidity() || !ensureSeriesActionReady()) return;
        const button = $('#create-series');
        button.disabled = true;
        $('#series-form-error').textContent = '';
        const title = $('#series-title').value.trim();
        const slug = $('#series-slug').value.trim();
        const year = $('#series-year').value.trim();
        const description = $('#series-description').value.trim();
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.setItem('editorSeriesSlug', slug);
        try {
          const result = await postJson('/__editor/series/create', { title, slug, year, description });
          seriesData.push(result.series);
          activeSeriesSlug = result.series.slug;
          seriesDialog.close();
          render();
          showToast(`Series “${result.series.title}” 已创建`);
        } catch (error) {
          sessionStorage.removeItem('editorSeriesSlug');
          $('#series-form-error').textContent = error.message;
        } finally {
          button.disabled = false;
        }
      }

      async function moveSeries(slug, direction) {
        if (!ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const ordered = orderedSeries();
        const index = ordered.findIndex((item) => item.slug === slug);
        const nextIndex = index + direction;
        if (index < 0 || nextIndex < 0 || nextIndex >= ordered.length) return;
        [ordered[index], ordered[nextIndex]] = [ordered[nextIndex], ordered[index]];
        sessionStorage.setItem('editorView', 'series');
        try {
          const result = await postJson('/__editor/series/reorder', { slugs: ordered.map((item) => item.slug) });
          seriesData = result.series;
          renderSeries();
          showToast('Series 顺序已保存');
        } catch (error) {
          window.alert(`调整顺序失败：${error.message}`);
        }
      }

      function openSeriesEdit(slug) {
        if (!ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const item = seriesData.find((entry) => entry.slug === slug);
        if (!item) return;
        $('#series-edit-original-slug').value = item.slug;
        $('#series-edit-title').value = item.title || '';
        $('#series-edit-slug').value = item.slug;
        $('#series-edit-year').value = item.year || '';
        $('#series-edit-order').value = String(Number(item.order) || orderedSeries().findIndex((entry) => entry.slug === slug) + 1);
        $('#series-edit-cover').value = item.coverImage || '';
        $('#series-edit-description').value = item.description || '';
        $('#series-edit-error').textContent = '';
        seriesEditDialog.showModal();
      }

      async function saveSeriesEdit() {
        const form = $('#series-edit-form');
        if (!form.reportValidity() || !ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const button = $('#save-series-edit');
        button.disabled = true;
        const slug = $('#series-edit-original-slug').value;
        sessionStorage.setItem('editorView', 'series');
        if (activeSeriesSlug) sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);
        try {
          const result = await postJson('/__editor/series/update', {
            slug,
            title: $('#series-edit-title').value.trim(),
            year: $('#series-edit-year').value.trim(),
            order: Number($('#series-edit-order').value),
            coverImage: $('#series-edit-cover').value.trim(),
            description: $('#series-edit-description').value.trim(),
          });
          seriesData = result.series;
          seriesEditDialog.close();
          renderSeries();
          showToast('Series 资料已保存');
        } catch (error) {
          $('#series-edit-error').textContent = error.message;
        } finally {
          button.disabled = false;
        }
      }

      function requestSeriesDelete(slug) {
        if (!ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const item = seriesData.find((entry) => entry.slug === slug);
        if (!item) return;
        if (seriesEditDialog.open) seriesEditDialog.close();
        seriesDeleteDialog.dataset.slug = slug;
        $('#series-delete-slug-label').textContent = slug;
        $('#series-delete-confirmation').value = '';
        $('#series-delete-error').textContent = '';
        $('#confirm-delete-series').disabled = true;
        seriesDeleteDialog.showModal();
        $('#series-delete-confirmation').focus();
      }

      async function deleteSeries() {
        const slug = seriesDeleteDialog.dataset.slug || '';
        if ($('#series-delete-confirmation').value.trim() !== slug) return;
        const button = $('#confirm-delete-series');
        button.disabled = true;
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.removeItem('editorSeriesSlug');
        try {
          const result = await postJson('/__editor/series/delete', { slug });
          seriesData = result.series;
          photoData = photoData.filter((photo) => photo.series !== slug);
          activeSeriesSlug = '';
          layoutDraftSlug = '';
          layoutDraftRows = [];
          layoutDirty = false;
          seriesDeleteDialog.close();
          setDirty(false, `Series 已移至 ${result.trashPath || 'trash/series'}`);
          renderSeries();
          showToast(`Series 已移除，${result.removedPhotoCount} 条照片记录已清理`);
        } catch (error) {
          $('#series-delete-error').textContent = error.message;
          button.disabled = false;
        }
      }

      function addSeriesRow(orientation) {
        const donorIndex = layoutDraftRows.findLastIndex((row) => row.orientation === orientation && row.photoIds.length > 1);
        const photoIds = donorIndex >= 0 ? [layoutDraftRows[donorIndex].photoIds.pop()] : [];
        layoutDraftRows.push({ orientation, photoIds });
        markLayoutDirty();
        renderSeries();
      }

      function adjustSeriesRow(rowIndex, action) {
        const row = layoutDraftRows[rowIndex];
        if (!row) return;
        if (action === 'up' || action === 'down') {
          const nextIndex = rowIndex + (action === 'up' ? -1 : 1);
          if (nextIndex < 0 || nextIndex >= layoutDraftRows.length) return;
          [layoutDraftRows[rowIndex], layoutDraftRows[nextIndex]] = [layoutDraftRows[nextIndex], layoutDraftRows[rowIndex]];
        }
        if (action === 'increase') {
          if (row.photoIds.length >= maxRowPhotos(row.orientation)) return;
          let donorIndex = layoutDraftRows.findIndex((candidate, index) => index > rowIndex && candidate.orientation === row.orientation && candidate.photoIds.length > 1);
          if (donorIndex < 0) donorIndex = layoutDraftRows.findIndex((candidate, index) => index !== rowIndex && candidate.orientation === row.orientation && candidate.photoIds.length > 1);
          if (donorIndex < 0) {
            showToast('没有可移入本行的同方向照片');
            return;
          }
          const donor = layoutDraftRows[donorIndex];
          row.photoIds.push(donorIndex > rowIndex ? donor.photoIds.shift() : donor.photoIds.pop());
        }
        if (action === 'decrease') {
          if (row.photoIds.length <= 1) return;
          const photoId = row.photoIds.pop();
          let receiverIndex = layoutDraftRows.findIndex((candidate, index) => index > rowIndex && candidate.orientation === row.orientation && candidate.photoIds.length < maxRowPhotos(row.orientation));
          if (receiverIndex < 0) {
            layoutDraftRows.splice(rowIndex + 1, 0, { orientation: row.orientation, photoIds: [photoId] });
          } else {
            layoutDraftRows[receiverIndex].photoIds.unshift(photoId);
          }
        }
        layoutDraftRows = layoutDraftRows.filter((candidate) => candidate.photoIds.length > 0);
        markLayoutDirty();
        renderSeries();
      }

      async function saveSeriesLayout() {
        if (!activeSeriesSlug || !ensureSeriesActionReady()) return;
        const button = $('#save-series-layout');
        button.disabled = true;
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);
        try {
          const result = await postJson('/__editor/series/layout', {
            slug: activeSeriesSlug,
            layoutRows: layoutDraftRows.filter((row) => row.photoIds.length > 0),
          });
          seriesData = seriesData.map((item) => item.slug === activeSeriesSlug ? result.series : item);
          layoutDraftRows = structuredClone(result.series.layoutRows || []);
          layoutDirty = false;
          renderSeries();
          showToast('Series 行布局已保存');
        } catch (error) {
          window.alert(`保存布局失败：${error.message}`);
          button.disabled = false;
        }
      }

      async function setSeriesCover(image) {
        if (!activeSeriesSlug || !ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);
        try {
          const result = await postJson('/__editor/series/cover', { slug: activeSeriesSlug, image });
          seriesData = seriesData.map((item) => item.slug === activeSeriesSlug ? result.series : item);
          renderSeries();
          showToast('Series 封面已更新');
        } catch (error) {
          window.alert(`设置封面失败：${error.message}`);
        }
      }

      async function importSeriesPhotos(files) {
        if (!activeSeriesSlug || !files.length || !ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const button = $('#upload-series-photos');
        button.disabled = true;
        const label = button.querySelector('span:last-child');
        label.textContent = 'Uploading…';
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);

        try {
          const metadata = await Promise.all(files.map(getImageDetails));
          const formData = new FormData();
          formData.append('slug', activeSeriesSlug);
          formData.append('metadata', JSON.stringify(metadata));
          files.forEach((file) => formData.append('photos', file, file.name));
          const response = await fetch('/__editor/series/upload', { method: 'POST', body: formData });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Series 照片上传失败。');
          photoData.push(...result.photos);
          seriesData = seriesData.map((item) => item.slug === activeSeriesSlug ? result.series : item);
          layoutDraftSlug = '';
          setDirty(false, `${result.photos.length} 张 Series 照片已写入 photos.json`);
          renderSeries();
          showToast(`${result.photos.length} 张照片已上传，横竖方向已识别`);
        } catch (error) {
          window.alert(`上传 Series 照片失败：${error.message}`);
        } finally {
          button.disabled = false;
          label.textContent = 'Upload Photos';
        }
      }

      function validatePhotos(value) {
        if (!Array.isArray(value)) throw new Error('文件内容不是照片数组。');
        const ids = new Set();
        value.forEach((photo, index) => {
          if (!photo || typeof photo !== 'object') throw new Error(`第 ${index + 1} 项不是有效照片。`);
          if (!photo.id || !photo.image) throw new Error(`第 ${index + 1} 项缺少 id 或 image。`);
          if (ids.has(photo.id)) throw new Error(`发现重复 ID：${photo.id}`);
          if (![...photoCategories, 'series'].includes(photo.category)) throw new Error(`${photo.id} 的分类无效。`);
          if (!['portrait', 'landscape'].includes(photo.orientation)) throw new Error(`${photo.id} 的画面方向无效。`);
          if (photo.layoutWidth !== undefined && (!Number.isFinite(Number(photo.layoutWidth)) || Number(photo.layoutWidth) < 45 || Number(photo.layoutWidth) > 200)) throw new Error(`${photo.id} 的显示尺寸应在 45–200 之间。`);
          if (photo.layoutOffsetX !== undefined && (!Number.isFinite(Number(photo.layoutOffsetX)) || Math.abs(Number(photo.layoutOffsetX)) > 80)) throw new Error(`${photo.id} 的水平位置应在 -80–80 之间。`);
          if (photo.layoutOffsetY !== undefined && (!Number.isFinite(Number(photo.layoutOffsetY)) || Math.abs(Number(photo.layoutOffsetY)) > 80)) throw new Error(`${photo.id} 的垂直位置应在 -80–80 之间。`);
          if (photo.categoryLayoutWidth !== undefined && (!Number.isFinite(Number(photo.categoryLayoutWidth)) || Number(photo.categoryLayoutWidth) < 45 || Number(photo.categoryLayoutWidth) > 200)) throw new Error(`${photo.id} 的分类页显示尺寸应在 45–200 之间。`);
          if (photo.categoryLayoutOffsetX !== undefined && (!Number.isFinite(Number(photo.categoryLayoutOffsetX)) || Math.abs(Number(photo.categoryLayoutOffsetX)) > 80)) throw new Error(`${photo.id} 的分类页水平位置应在 -80–80 之间。`);
          if (photo.categoryLayoutOffsetY !== undefined && (!Number.isFinite(Number(photo.categoryLayoutOffsetY)) || Math.abs(Number(photo.categoryLayoutOffsetY)) > 80)) throw new Error(`${photo.id} 的分类页垂直位置应在 -80–80 之间。`);
          ids.add(photo.id);
        });
        return value;
      }

      async function loadFile(file, handle = null) {
        try {
          const parsed = validatePhotos(JSON.parse(await file.text()));
          if (dirty && !window.confirm('打开新文件会放弃当前未保存修改，继续吗？')) return;
          photoData = parsed;
          fileHandle = handle;
          history.length = 0;
          $('#undo').disabled = true;
          setDirty(false, `已打开 ${file.name}`);
          render();
          showToast(`已载入 ${parsed.length} 张照片`);
        } catch (error) {
          window.alert(`无法打开文件：${error.message}`);
        }
      }

      function serialize() {
        validatePhotos(photoData);
        return `${JSON.stringify(photoData, null, 2)}\n`;
      }

      function downloadJson() {
        try {
          const url = URL.createObjectURL(new Blob([serialize()], { type: 'application/json' }));
          const link = document.createElement('a');
          link.href = url;
          link.download = 'photos.json';
          link.click();
          URL.revokeObjectURL(url);
          showToast('photos.json 副本已下载');
        } catch (error) {
          window.alert(`导出失败：${error.message}`);
        }
      }

      async function saveJson() {
        try {
          if (!fileHandle && 'showSaveFilePicker' in window) {
            fileHandle = await window.showSaveFilePicker({
              suggestedName: 'photos.json',
              types: [{ description: 'JSON 文件', accept: { 'application/json': ['.json'] } }],
            });
          }
          if (!fileHandle) {
            downloadJson();
            setDirty(false, '副本已下载，请替换 src/data/photos.json');
            return;
          }
          const writable = await fileHandle.createWritable();
          await writable.write(serialize());
          await writable.close();
          setDirty(false);
          showToast('已保存到本地文件');
        } catch (error) {
          if (error.name !== 'AbortError') window.alert(`保存失败：${error.message}`);
        }
      }

      grid.addEventListener('click', (event) => {
        const categoryRowButton = event.target.closest('[data-category-row-action]');
        const categoryRow = event.target.closest('[data-category-row-index]');
        if (categoryRowButton && categoryRow) {
          adjustCategoryRow(Number(categoryRow.dataset.categoryRowIndex), categoryRowButton.dataset.categoryRowAction);
          return;
        }
        const button = event.target.closest('button');
        const card = event.target.closest('.editor-card');
        if (!button || !card) return;
        const { id } = card.dataset;
        const action = button.dataset.action;
        if (action === 'edit') openInspector(id);
        if (action === 'delete') deletePhoto(id);
        if (action === 'up') movePhoto(id, -1);
        if (action === 'down') movePhoto(id, 1);
        if (action === 'size') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return;
          snapshot();
          const layoutScope = getLayoutScope();
          const current = getLayoutWidth(photo, layoutScope);
          const nextWidth = current >= 200 ? 60 : current >= 150 ? 200 : current >= 100 ? 150 : current >= 80 ? 100 : 80;
          setLayoutWidth(photo, nextWidth, layoutScope);
          setDirty(true);
          render();
          showToast(`照片尺寸已调整为 ${nextWidth}%`);
        }
        if (action === 'reset-position') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return;
          snapshot();
          const layoutScope = getLayoutScope();
          setLayoutOffset(photo, 'x', 0, layoutScope);
          setLayoutOffset(photo, 'y', 0, layoutScope);
          setDirty(true);
          render();
          showToast('照片位置已归零');
        }
        if (action === 'featured') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return;
          snapshot();
          photo.featured = !photo.featured;
          setDirty(true);
          render();
        }
      });

      grid.addEventListener('pointerdown', (event) => {
        const handle = event.target.closest('[data-action="resize"]');
        const card = event.target.closest('.editor-card');
        if (!handle || !card) return;
        event.preventDefault();
        event.stopPropagation();
        const photo = photoData.find((item) => item.id === card.dataset.id);
        if (!photo) return;
        const layoutScope = getLayoutScope();
        if (!layoutScope) return;
        snapshot();
        const startScale = getLayoutWidth(photo, layoutScope);
        const startX = event.clientX;
        const startWidth = card.getBoundingClientRect().width;
        const baseWidth = startWidth / (startScale / 100);
          card.classList.add('is-resizing');
        handle.setPointerCapture?.(event.pointerId);

        const onMove = (moveEvent) => {
          const nextWidth = startWidth + (moveEvent.clientX - startX) * 2;
          const nextScale = Math.min(200, Math.max(45, Math.round((nextWidth / baseWidth) * 100)));
          setLayoutWidth(photo, nextScale, layoutScope);
          card.style.setProperty('--card-width', `${nextScale}%`);
          const sizeButton = card.querySelector('[data-action="size"]');
          sizeButton.textContent = `↔ ${nextScale}%`;
          sizeButton.setAttribute('aria-label', `切换照片尺寸，当前 ${nextScale}%`);
        };
        const onEnd = () => {
          if (handle.hasPointerCapture?.(event.pointerId)) handle.releasePointerCapture(event.pointerId);
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onEnd);
          window.removeEventListener('pointercancel', onEnd);
          card.classList.remove('is-resizing');
          setDirty(true);
          showToast(`照片尺寸已调整为 ${getLayoutWidth(photo, layoutScope)}%`);
        };
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onEnd);
        window.addEventListener('pointercancel', onEnd);
      });

      grid.addEventListener('pointerdown', (event) => {
        const image = event.target.closest('.editor-card__image');
        const card = event.target.closest('.editor-card');
        const layoutScope = getLayoutScope();
        if (!layoutScope || !image || !card || event.target.closest('button')) return;
        event.preventDefault();
        const photo = photoData.find((item) => item.id === card.dataset.id);
        if (!photo) return;
        snapshot();
        const startX = event.clientX;
        const startY = event.clientY;
        const startOffsetX = getLayoutOffset(photo, 'x', layoutScope);
        const startOffsetY = getLayoutOffset(photo, 'y', layoutScope);
        const bounds = card.getBoundingClientRect();
        card.classList.add('is-positioning');
        image.setPointerCapture?.(event.pointerId);

        const onMove = (moveEvent) => {
          const nextX = Math.min(80, Math.max(-80, Math.round(startOffsetX + ((moveEvent.clientX - startX) / bounds.width) * 100)));
          const nextY = Math.min(80, Math.max(-80, Math.round(startOffsetY + ((moveEvent.clientY - startY) / bounds.height) * 100)));
          setLayoutOffset(photo, 'x', nextX, layoutScope);
          setLayoutOffset(photo, 'y', nextY, layoutScope);
          card.style.setProperty('--offset-x', `${nextX}%`);
          card.style.setProperty('--offset-y', `${nextY}%`);
          const control = card.querySelector('[data-action="reset-position"]');
          control.textContent = `⌖ ${nextX}, ${nextY}`;
          control.classList.toggle('is-active', Boolean(nextX || nextY));
          control.setAttribute('aria-label', `位置归零，当前水平 ${nextX}%，垂直 ${nextY}%`);
        };
        const onEnd = () => {
          if (image.hasPointerCapture?.(event.pointerId)) image.releasePointerCapture(event.pointerId);
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onEnd);
          window.removeEventListener('pointercancel', onEnd);
          card.classList.remove('is-positioning');
          setDirty(true);
          showToast(`照片位置：${getLayoutOffset(photo, 'x', layoutScope)}, ${getLayoutOffset(photo, 'y', layoutScope)}`);
        };
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onEnd);
        window.addEventListener('pointercancel', onEnd);
      });

      viewFilter.addEventListener('change', () => {
        if (layoutDirty && viewFilter.value !== 'series' && !window.confirm('当前 Series 行布局尚未保存，确定放弃吗？')) {
          viewFilter.value = 'series';
          return;
        }
        if (viewFilter.value !== 'series') layoutDirty = false;
        render();
      });
      searchInput.addEventListener('input', render);
      newSeriesButton.addEventListener('click', openSeriesDialog);
      $('#create-series').addEventListener('click', createNewSeries);
      $('#series-title').addEventListener('input', (event) => {
        const title = event.target.value;
        if (seriesDialog.dataset.slugTouched !== 'true') {
          const generated = slugify(title);
          $('#series-slug').value = generated || `series-${new Date().getFullYear()}`;
        }
        const year = title.match(/(?:19|20)\d{2}/)?.[0];
        if (year && !$('#series-year').value) $('#series-year').value = year;
      });
      $('#series-slug').addEventListener('input', () => { seriesDialog.dataset.slugTouched = 'true'; });
      $('#series-back').addEventListener('click', () => {
        if (layoutDirty && !window.confirm('当前行布局尚未保存，确定返回并放弃吗？')) return;
        activeSeriesSlug = '';
        layoutDraftSlug = '';
        layoutDraftRows = [];
        layoutDirty = false;
        sessionStorage.removeItem('editorSeriesSlug');
        renderSeries();
      });
      seriesEditorGrid.addEventListener('click', (event) => {
        const card = event.target.closest('[data-slug]');
        const button = event.target.closest('[data-series-action]');
        if (!card || !button) return;
        const action = button.dataset.seriesAction;
        if (action === 'open') {
          activeSeriesSlug = card.dataset.slug;
          sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);
          renderSeries();
        }
        if (action === 'edit') openSeriesEdit(card.dataset.slug);
        if (action === 'delete') requestSeriesDelete(card.dataset.slug);
        if (action === 'up') moveSeries(card.dataset.slug, -1);
        if (action === 'down') moveSeries(card.dataset.slug, 1);
      });
      seriesPhotoGrid.addEventListener('click', (event) => {
        const coverButton = event.target.closest('[data-cover-image]');
        if (coverButton) setSeriesCover(coverButton.dataset.coverImage);
        const rowButton = event.target.closest('[data-row-action]');
        const row = event.target.closest('[data-row-index]');
        if (rowButton && row) adjustSeriesRow(Number(row.dataset.rowIndex), rowButton.dataset.rowAction);
      });
      $('#add-portrait-row').addEventListener('click', () => addSeriesRow('portrait'));
      $('#add-landscape-row').addEventListener('click', () => addSeriesRow('landscape'));
      $('#save-series-layout').addEventListener('click', saveSeriesLayout);
      $('#edit-active-series').addEventListener('click', () => openSeriesEdit(activeSeriesSlug));
      $('#save-series-edit').addEventListener('click', saveSeriesEdit);
      $('#request-delete-series').addEventListener('click', () => requestSeriesDelete($('#series-edit-original-slug').value));
      $('#series-delete-confirmation').addEventListener('input', (event) => {
        $('#confirm-delete-series').disabled = event.target.value.trim() !== seriesDeleteDialog.dataset.slug;
      });
      seriesDeleteDialog.querySelectorAll('[value="cancel"]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          seriesDeleteDialog.close('cancel');
        });
      });
      $('#confirm-delete-series').addEventListener('click', deleteSeries);
      $('#upload-series-photos').addEventListener('click', () => $('#series-photo-input').click());
      $('#series-photo-input').addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []);
        event.target.value = '';
        if (!files.length || !await confirmLargeFiles(files)) return;
        await importSeriesPhotos(files);
      });
      addPhotosButton.addEventListener('click', () => $('#photo-file-input').click());
      $('#photo-file-input').addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []);
        event.target.value = '';
        if (!files.length || !await confirmLargeFiles(files)) return;
        await importPhotos(files);
      });
      $('#clear-search').addEventListener('click', () => { searchInput.value = ''; render(); });
      $('#apply-photo').addEventListener('click', applyInspector);
      $('#delete-photo').addEventListener('click', () => deletePhoto($('#form-original-id').value));
      $('#form-image').addEventListener('input', (event) => { $('#form-preview').src = event.target.value; });
      $('#open-file').addEventListener('click', async () => {
        if ('showOpenFilePicker' in window) {
          try {
            const [handle] = await window.showOpenFilePicker({
              types: [{ description: 'JSON 文件', accept: { 'application/json': ['.json'] } }],
              multiple: false,
            });
            await loadFile(await handle.getFile(), handle);
          } catch (error) {
            if (error.name !== 'AbortError') window.alert(`打开失败：${error.message}`);
          }
        } else {
          $('#file-fallback').click();
        }
      });
      $('#file-fallback').addEventListener('change', (event) => {
        const [file] = event.target.files;
        if (file) loadFile(file);
        event.target.value = '';
      });
      $('#save-file').addEventListener('click', saveJson);
      $('#download').addEventListener('click', downloadJson);
      $('#undo').addEventListener('click', () => {
        if (!history.length) return;
        photoData = history.pop();
        $('#undo').disabled = history.length === 0;
        setDirty(true, '已撤销上一步');
        render();
      });
      $('#reset').addEventListener('click', () => {
        if (!window.confirm('确定恢复到页面最初载入的数据吗？当前修改会丢失。')) return;
        snapshot();
        photoData = structuredClone(initialPhotos);
        setDirty(true, '已恢复初始数据，尚未保存');
        render();
      });
      window.addEventListener('beforeunload', (event) => {
        if (!dirty && !layoutDirty) return;
        event.preventDefault();
        event.returnValue = '';
      });
      window.addEventListener('resize', syncCanvasScale);

      render();
    </script>
  </body>
</html>

<style is:global>
  :root { --paper: #f3f1eb; --ink: #171716; --muted: #75736d; --line: rgba(23,23,22,.16); --accent: #be4b2f; --serif: Georgia, 'Times New Roman', serif; --sans: Arial, Helvetica, sans-serif; }
  * { box-sizing: border-box; }
  html { background: var(--paper); }
  body { margin: 0; color: var(--ink); background: var(--paper); font: 14px/1.4 var(--sans); }
  button, input, select, textarea { font: inherit; }
  button, select { cursor: pointer; }
  a { color: inherit; text-decoration: none; }
  .editor-header { height: 5rem; padding: 0 2rem; position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; color: #f7f5f0; background: #1c1c1a; }
  .editor-header > div { display: flex; align-items: center; gap: 2rem; }
  .wordmark { font-family: var(--serif); font-size: .82rem; letter-spacing: .17em; }
