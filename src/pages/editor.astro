        const startOffsetY = getLayoutOffset(photo, 'y', layoutScope);
        const bounds = card.getBoundingClientRect();
        card.classList.add('is-positioning');
        image.setPointerCapture?.(event.pointerId);

        const onMove = (moveEvent) => {
          const nextX = Math.min(80, Math.max(-80, Math.round(startOffsetX + ((moveEvent.clientX - startX) / bounds.width) * 100)));
          const nextY = Math.min(80, Math.max(-80, Math.round(startOffsetY + ((moveEvent.clientY - startY) / bounds.height) * 100)));
