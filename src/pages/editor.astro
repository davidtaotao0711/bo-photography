---
import photos from '../data/photos.json';

const serializedPhotos = JSON.stringify(photos).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>本地排版编辑器 · Bo David</title>
  </head>
  <body>
    <script id="initial-photos" type="application/json" set:html={serializedPhotos}></script>

    <header class="editor-header">
      <a class="wordmark" href="/">BO DAVID</a>
      <div>
        <span class="local-badge"><i></i> 本地编辑</span>
        <a class="site-link" href="/" target="_blank">查看网站 ↗</a>
      </div>
    </header>

    <main class="editor-shell">
      <aside class="sidebar">
        <div class="sidebar-heading">
          <p class="eyebrow">Layout studio</p>
          <h1>排版<br />编辑器</h1>
          <p>直接拖动照片自由安排位置，使用箭头调整顺序。所有操作只发生在你的电脑上。</p>
        </div>

        <div class="field-group">
          <label for="view-filter">预览版面</label>
          <select id="view-filter">
            <option value="featured">首页精选</option>
            <option value="all">全部照片</option>
            <option value="street">Street</option>
            <option value="portrait">Portrait</option>
            <option value="scenes">Scenes</option>
          </select>
        </div>

        <div class="field-group">
          <label for="search">查找照片</label>
          <input id="search" type="search" placeholder="名称、地点或 ID" autocomplete="off" />
        </div>

        <div class="stats" aria-live="polite">
          <div><strong id="visible-count">0</strong><span>当前显示</span></div>
          <div><strong id="featured-count">0</strong><span>首页精选</span></div>
          <div><strong id="total-count">0</strong><span>照片总数</span></div>
        </div>

        <div class="help">
          <p class="eyebrow">使用方法</p>
          <ol>
            <li>按住照片画面自由移动位置</li>
            <li>使用上下箭头改变前后顺序</li>
            <li>点尺寸按钮或拖右下角缩放</li>
            <li>点击照片编辑属性</li>
            <li>保存并覆盖 photos.json</li>
          </ol>
          <p class="note">首页只展示排在最前面的 12 张精选照片。</p>
        </div>
      </aside>

      <section class="workspace">
        <div class="toolbar">
          <div>
            <button class="button button--primary" id="open-file" type="button">打开 photos.json</button>
            <button class="button" id="save-file" type="button">保存</button>
          </div>
          <div>
            <button class="text-button" id="undo" type="button" disabled>撤销</button>
            <button class="text-button" id="download" type="button">下载副本</button>
            <button class="text-button text-button--danger" id="reset" type="button">恢复初始</button>
          </div>
        </div>

        <div class="status-row">
          <p id="view-title">首页精选</p>
          <p id="save-status" data-state="clean">已载入网站数据</p>
        </div>

        <div id="empty-state" class="empty-state" hidden>
          <p>没有找到照片</p>
          <button class="text-button" id="clear-search" type="button">清除搜索</button>
        </div>
        <div id="photo-grid" class="photo-grid" aria-label="可自由定位的照片版面"></div>
      </section>
    </main>

    <dialog id="inspector">
      <form id="photo-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Photo details</p>
            <h2>照片设置</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>

        <div class="dialog-preview"><img id="form-preview" src="" alt="" /></div>
        <input id="form-original-id" type="hidden" />
        <div class="form-grid">
          <label>标题<input id="form-title" required /></label>
          <label>唯一 ID<input id="form-id" required pattern="[a-zA-Z0-9_-]+" /></label>
          <label>分类
            <select id="form-category" required>
              <option value="street">Street</option>
              <option value="portrait">Portrait</option>
              <option value="scenes">Scenes</option>
            </select>
          </label>
          <label>画面方向
            <select id="form-orientation" required>
              <option value="landscape">横图</option>
              <option value="portrait">竖图</option>
            </select>
          </label>
          <label>显示尺寸（%）<input id="form-layout-width" type="number" min="45" max="200" step="1" required /></label>
          <label>水平位置（%）<input id="form-offset-x" type="number" min="-80" max="80" step="1" required /></label>
          <label>垂直位置（%）<input id="form-offset-y" type="number" min="-80" max="80" step="1" required /></label>
          <label>地点<input id="form-location" /></label>
          <label>日期<input id="form-date" /></label>
          <label>所属系列<input id="form-series" placeholder="没有可留空" /></label>
          <label>图片路径<input id="form-image" required /></label>
          <label class="full">图片描述<textarea id="form-alt" rows="3" required></textarea></label>
          <label class="toggle full"><input id="form-featured" type="checkbox" /><span></span>显示在首页精选</label>
        </div>
        <p id="form-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <button class="text-button" value="cancel" type="submit">取消</button>
          <button class="button button--primary" id="apply-photo" type="button">应用修改</button>
        </div>
      </form>
    </dialog>

    <input id="file-fallback" type="file" accept="application/json,.json" hidden />
    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      const initialNode = document.querySelector('#initial-photos');
      const initialPhotos = JSON.parse(initialNode?.textContent || '[]');
      let photoData = structuredClone(initialPhotos);
      let fileHandle = null;
      let dirty = false;
      const history = [];

      const grid = document.querySelector('#photo-grid');
      const viewFilter = document.querySelector('#view-filter');
      const searchInput = document.querySelector('#search');
      const inspector = document.querySelector('#inspector');
      const formError = document.querySelector('#form-error');

      const $ = (selector) => document.querySelector(selector);
      const escapeHtml = (value = '') => String(value)
        .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

      function snapshot() {
        history.push(structuredClone(photoData));
        if (history.length > 30) history.shift();
        $('#undo').disabled = false;
      }

      function setDirty(value, message) {
        dirty = value;
        const status = $('#save-status');
        status.dataset.state = value ? 'dirty' : 'clean';
        status.textContent = message || (value ? '有未保存修改' : '所有修改已保存');
      }

      function showToast(message) {
        const toast = $('#toast');
        toast.textContent = message;
        toast.classList.add('is-visible');
        window.clearTimeout(showToast.timer);
        showToast.timer = window.setTimeout(() => toast.classList.remove('is-visible'), 2400);
      }

      function getVisiblePhotos() {
        const filter = viewFilter.value;
        const query = searchInput.value.trim().toLowerCase();
        return photoData.filter((photo) => {
          const matchesView = filter === 'all' || (filter === 'featured' ? photo.featured : photo.category === filter);
          const haystack = [photo.id, photo.title, photo.location, photo.series, photo.alt].join(' ').toLowerCase();
          return matchesView && (!query || haystack.includes(query));
        });
      }

      function getLayoutWidth(photo) {
        const width = Number(photo.layoutWidth);
        return Number.isFinite(width) ? Math.min(200, Math.max(45, Math.round(width))) : 100;
      }

      function getLayoutOffset(photo, axis) {
        const offset = Number(photo[axis === 'x' ? 'layoutOffsetX' : 'layoutOffsetY']);
        return Number.isFinite(offset) ? Math.min(80, Math.max(-80, Math.round(offset))) : 0;
      }

      function render() {
        const visible = getVisiblePhotos();
        const filterLabel = viewFilter.options[viewFilter.selectedIndex]?.textContent || '';
        $('#view-title').textContent = `${filterLabel} · 拖动画面自由定位`;
        $('#visible-count').textContent = String(visible.length);
        $('#featured-count').textContent = String(photoData.filter((photo) => photo.featured).length);
        $('#total-count').textContent = String(photoData.length);
        $('#empty-state').hidden = visible.length > 0;
        grid.hidden = visible.length === 0;
        grid.dataset.view = viewFilter.value;

        let featuredPosition = 0;
        grid.innerHTML = visible.map((photo, index) => {
          const layoutWidth = getLayoutWidth(photo);
          const offsetX = getLayoutOffset(photo, 'x');
          const offsetY = getLayoutOffset(photo, 'y');
          if (photo.featured) featuredPosition += 1;
          const publishBadge = viewFilter.value === 'featured' && featuredPosition > 12
            ? '<span class="card-badge card-badge--muted">首页不展示</span>'
            : `<span class="card-badge">${String(index + 1).padStart(2, '0')}</span>`;
          return `
            <article class="editor-card editor-card--${escapeHtml(photo.orientation)}" data-id="${escapeHtml(photo.id)}" style="--card-width: ${layoutWidth}%; --offset-x: ${offsetX}%; --offset-y: ${offsetY}%">
              <div class="editor-card__image">
                <img src="${escapeHtml(photo.image)}" alt="${escapeHtml(photo.alt)}" loading="lazy" />
                ${publishBadge}
                <button class="favorite ${photo.featured ? 'is-active' : ''}" type="button" data-action="featured" aria-label="${photo.featured ? '取消首页精选' : '加入首页精选'}" title="首页精选">★</button>
                <button class="position-control ${offsetX || offsetY ? 'is-active' : ''}" type="button" data-action="reset-position" aria-label="位置归零，当前水平 ${offsetX}%，垂直 ${offsetY}%" title="点击恢复原位">⌖ ${offsetX}, ${offsetY}</button>
                <button class="size-control" type="button" data-action="size" aria-label="切换照片尺寸，当前 ${layoutWidth}%" title="点击切换尺寸">↔ ${layoutWidth}%</button>
                <div class="move-actions">
                  <button type="button" data-action="up" aria-label="向前移动">↑</button>
                  <button type="button" data-action="down" aria-label="向后移动">↓</button>
                </div>
                <button class="resize-handle" type="button" data-action="resize" aria-label="拖动以等比缩放照片" title="拖动以等比缩放"></button>
              </div>
              <button class="editor-card__meta" type="button" data-action="edit">
                <span><strong>${escapeHtml(photo.title || photo.id)}</strong>${escapeHtml(photo.location || '未填写地点')}</span>
                <span>${photo.orientation === 'portrait' ? '竖图' : '横图'} · 编辑</span>
              </button>
            </article>`;
        }).join('');
      }

      function replaceVisibleOrder(orderedIds) {
        const idSet = new Set(orderedIds);
        let cursor = 0;
        photoData = photoData.map((photo) => {
          if (!idSet.has(photo.id)) return photo;
          const nextId = orderedIds[cursor++];
          return photoData.find((item) => item.id === nextId);
        });
      }

      function movePhoto(id, direction) {
        const visible = getVisiblePhotos();
        const index = visible.findIndex((photo) => photo.id === id);
        const nextIndex = index + direction;
        if (index < 0 || nextIndex < 0 || nextIndex >= visible.length) return;
        snapshot();
        const ids = visible.map((photo) => photo.id);
        [ids[index], ids[nextIndex]] = [ids[nextIndex], ids[index]];
        replaceVisibleOrder(ids);
        setDirty(true);
        render();
      }

      function openInspector(id) {
        const photo = photoData.find((item) => item.id === id);
        if (!photo) return;
        $('#form-original-id').value = photo.id;
        $('#form-id').value = photo.id;
        $('#form-title').value = photo.title || '';
        $('#form-category').value = photo.category;
        $('#form-orientation').value = photo.orientation;
        $('#form-layout-width').value = String(getLayoutWidth(photo));
        $('#form-offset-x').value = String(getLayoutOffset(photo, 'x'));
        $('#form-offset-y').value = String(getLayoutOffset(photo, 'y'));
        $('#form-location').value = photo.location || '';
        $('#form-date').value = photo.date || '';
        $('#form-series').value = photo.series || '';
        $('#form-image').value = photo.image;
        $('#form-alt').value = photo.alt || '';
        $('#form-featured').checked = Boolean(photo.featured);
        $('#form-preview').src = photo.image;
        $('#form-preview').alt = photo.alt || '';
        formError.textContent = '';
        inspector.showModal();
      }

      function applyInspector() {
        const form = $('#photo-form');
        if (!form.reportValidity()) return;
        const oldId = $('#form-original-id').value;
        const newId = $('#form-id').value.trim();
        if (photoData.some((photo) => photo.id === newId && photo.id !== oldId)) {
          formError.textContent = `ID “${newId}” 已被另一张照片使用。`;
          return;
        }
        const index = photoData.findIndex((photo) => photo.id === oldId);
        if (index < 0) return;
        snapshot();
        photoData[index] = {
          ...photoData[index],
          id: newId,
          title: $('#form-title').value.trim(),
          category: $('#form-category').value,
          series: $('#form-series').value.trim(),
          location: $('#form-location').value.trim(),
          date: $('#form-date').value.trim(),
          image: $('#form-image').value.trim(),
          featured: $('#form-featured').checked,
          orientation: $('#form-orientation').value,
          layoutWidth: Math.min(200, Math.max(45, Number($('#form-layout-width').value))),
          layoutOffsetX: Math.min(80, Math.max(-80, Number($('#form-offset-x').value))),
          layoutOffsetY: Math.min(80, Math.max(-80, Number($('#form-offset-y').value))),
          alt: $('#form-alt').value.trim(),
        };
        inspector.close();
        setDirty(true);
        render();
        showToast('照片设置已应用');
      }

      function validatePhotos(value) {
        if (!Array.isArray(value)) throw new Error('文件内容不是照片数组。');
        const ids = new Set();
        value.forEach((photo, index) => {
          if (!photo || typeof photo !== 'object') throw new Error(`第 ${index + 1} 项不是有效照片。`);
          if (!photo.id || !photo.image) throw new Error(`第 ${index + 1} 项缺少 id 或 image。`);
          if (ids.has(photo.id)) throw new Error(`发现重复 ID：${photo.id}`);
          if (!['street', 'portrait', 'scenes'].includes(photo.category)) throw new Error(`${photo.id} 的分类无效。`);
          if (!['portrait', 'landscape'].includes(photo.orientation)) throw new Error(`${photo.id} 的画面方向无效。`);
          if (photo.layoutWidth !== undefined && (!Number.isFinite(Number(photo.layoutWidth)) || Number(photo.layoutWidth) < 45 || Number(photo.layoutWidth) > 200)) throw new Error(`${photo.id} 的显示尺寸应在 45–200 之间。`);
          if (photo.layoutOffsetX !== undefined && (!Number.isFinite(Number(photo.layoutOffsetX)) || Math.abs(Number(photo.layoutOffsetX)) > 80)) throw new Error(`${photo.id} 的水平位置应在 -80–80 之间。`);
          if (photo.layoutOffsetY !== undefined && (!Number.isFinite(Number(photo.layoutOffsetY)) || Math.abs(Number(photo.layoutOffsetY)) > 80)) throw new Error(`${photo.id} 的垂直位置应在 -80–80 之间。`);
          ids.add(photo.id);
        });
        return value;
      }

      async function loadFile(file, handle = null) {
        try {
          const parsed = validatePhotos(JSON.parse(await file.text()));
          if (dirty && !window.confirm('打开新文件会放弃当前未保存修改，继续吗？')) return;
          photoData = parsed;
          fileHandle = handle;
          history.length = 0;
          $('#undo').disabled = true;
          setDirty(false, `已打开 ${file.name}`);
          render();
          showToast(`已载入 ${parsed.length} 张照片`);
        } catch (error) {
          window.alert(`无法打开文件：${error.message}`);
        }
      }

      function serialize() {
        validatePhotos(photoData);
        return `${JSON.stringify(photoData, null, 2)}\n`;
      }

      function downloadJson() {
        try {
          const url = URL.createObjectURL(new Blob([serialize()], { type: 'application/json' }));
          const link = document.createElement('a');
          link.href = url;
          link.download = 'photos.json';
          link.click();
          URL.revokeObjectURL(url);
          showToast('photos.json 副本已下载');
        } catch (error) {
          window.alert(`导出失败：${error.message}`);
        }
      }

      async function saveJson() {
        try {
          if (!fileHandle && 'showSaveFilePicker' in window) {
            fileHandle = await window.showSaveFilePicker({
              suggestedName: 'photos.json',
              types: [{ description: 'JSON 文件', accept: { 'application/json': ['.json'] } }],
            });
          }
          if (!fileHandle) {
            downloadJson();
            setDirty(false, '副本已下载，请替换 src/data/photos.json');
            return;
          }
          const writable = await fileHandle.createWritable();
          await writable.write(serialize());
          await writable.close();
          setDirty(false);
          showToast('已保存到本地文件');
        } catch (error) {
          if (error.name !== 'AbortError') window.alert(`保存失败：${error.message}`);
        }
      }

      grid.addEventListener('click', (event) => {
        const button = event.target.closest('button');
        const card = event.target.closest('.editor-card');
        if (!button || !card) return;
        const { id } = card.dataset;
        const action = button.dataset.action;
        if (action === 'edit') openInspector(id);
        if (action === 'up') movePhoto(id, -1);
        if (action === 'down') movePhoto(id, 1);
        if (action === 'size') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return;
          snapshot();
          const current = getLayoutWidth(photo);
          photo.layoutWidth = current >= 200 ? 60 : current >= 150 ? 200 : current >= 100 ? 150 : current >= 80 ? 100 : 80;
          setDirty(true);
          render();
          showToast(`照片尺寸已调整为 ${photo.layoutWidth}%`);
        }
        if (action === 'reset-position') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return;
          snapshot();
          photo.layoutOffsetX = 0;
          photo.layoutOffsetY = 0;
          setDirty(true);
          render();
          showToast('照片位置已归零');
        }
        if (action === 'featured') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return;
          snapshot();
          photo.featured = !photo.featured;
          setDirty(true);
          render();
        }
      });

      grid.addEventListener('pointerdown', (event) => {
        const handle = event.target.closest('[data-action="resize"]');
        const card = event.target.closest('.editor-card');
        if (!handle || !card) return;
        event.preventDefault();
        event.stopPropagation();
        const photo = photoData.find((item) => item.id === card.dataset.id);
        if (!photo) return;
        snapshot();
        const startScale = getLayoutWidth(photo);
        const startX = event.clientX;
        const startWidth = card.getBoundingClientRect().width;
        const baseWidth = startWidth / (startScale / 100);
          card.classList.add('is-resizing');
        handle.setPointerCapture?.(event.pointerId);

        const onMove = (moveEvent) => {
          const nextWidth = startWidth + (moveEvent.clientX - startX) * 2;
          const nextScale = Math.min(200, Math.max(45, Math.round((nextWidth / baseWidth) * 100)));
          photo.layoutWidth = nextScale;
          card.style.setProperty('--card-width', `${nextScale}%`);
          const sizeButton = card.querySelector('[data-action="size"]');
          sizeButton.textContent = `↔ ${nextScale}%`;
          sizeButton.setAttribute('aria-label', `切换照片尺寸，当前 ${nextScale}%`);
        };
        const onEnd = () => {
          if (handle.hasPointerCapture?.(event.pointerId)) handle.releasePointerCapture(event.pointerId);
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onEnd);
          window.removeEventListener('pointercancel', onEnd);
          card.classList.remove('is-resizing');
          setDirty(true);
          showToast(`照片尺寸已调整为 ${getLayoutWidth(photo)}%`);
        };
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onEnd);
        window.addEventListener('pointercancel', onEnd);
      });

      grid.addEventListener('pointerdown', (event) => {
        const image = event.target.closest('.editor-card__image');
        const card = event.target.closest('.editor-card');
        if (!image || !card || event.target.closest('button')) return;
        event.preventDefault();
        const photo = photoData.find((item) => item.id === card.dataset.id);
        if (!photo) return;
        snapshot();
        const startX = event.clientX;
        const startY = event.clientY;
        const startOffsetX = getLayoutOffset(photo, 'x');
        const startOffsetY = getLayoutOffset(photo, 'y');
        const bounds = card.getBoundingClientRect();
        card.classList.add('is-positioning');
        image.setPointerCapture?.(event.pointerId);

        const onMove = (moveEvent) => {
          const nextX = Math.min(80, Math.max(-80, Math.round(startOffsetX + ((moveEvent.clientX - startX) / bounds.width) * 100)));
          const nextY = Math.min(80, Math.max(-80, Math.round(startOffsetY + ((moveEvent.clientY - startY) / bounds.height) * 100)));
          photo.layoutOffsetX = nextX;
          photo.layoutOffsetY = nextY;
          card.style.setProperty('--offset-x', `${nextX}%`);
          card.style.setProperty('--offset-y', `${nextY}%`);
          const control = card.querySelector('[data-action="reset-position"]');
          control.textContent = `⌖ ${nextX}, ${nextY}`;
          control.classList.toggle('is-active', Boolean(nextX || nextY));
          control.setAttribute('aria-label', `位置归零，当前水平 ${nextX}%，垂直 ${nextY}%`);
        };
        const onEnd = () => {
          if (image.hasPointerCapture?.(event.pointerId)) image.releasePointerCapture(event.pointerId);
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onEnd);
          window.removeEventListener('pointercancel', onEnd);
          card.classList.remove('is-positioning');
          setDirty(true);
          showToast(`照片位置：${getLayoutOffset(photo, 'x')}, ${getLayoutOffset(photo, 'y')}`);
        };
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onEnd);
        window.addEventListener('pointercancel', onEnd);
      });

      viewFilter.addEventListener('change', render);
      searchInput.addEventListener('input', render);
      $('#clear-search').addEventListener('click', () => { searchInput.value = ''; render(); });
      $('#apply-photo').addEventListener('click', applyInspector);
      $('#form-image').addEventListener('input', (event) => { $('#form-preview').src = event.target.value; });
      $('#open-file').addEventListener('click', async () => {
        if ('showOpenFilePicker' in window) {
          try {
            const [handle] = await window.showOpenFilePicker({
              types: [{ description: 'JSON 文件', accept: { 'application/json': ['.json'] } }],
              multiple: false,
            });
            await loadFile(await handle.getFile(), handle);
          } catch (error) {
            if (error.name !== 'AbortError') window.alert(`打开失败：${error.message}`);
          }
        } else {
          $('#file-fallback').click();
        }
      });
      $('#file-fallback').addEventListener('change', (event) => {
        const [file] = event.target.files;
        if (file) loadFile(file);
        event.target.value = '';
      });
      $('#save-file').addEventListener('click', saveJson);
      $('#download').addEventListener('click', downloadJson);
      $('#undo').addEventListener('click', () => {
        if (!history.length) return;
        photoData = history.pop();
        $('#undo').disabled = history.length === 0;
        setDirty(true, '已撤销上一步');
        render();
      });
      $('#reset').addEventListener('click', () => {
        if (!window.confirm('确定恢复到页面最初载入的数据吗？当前修改会丢失。')) return;
        snapshot();
        photoData = structuredClone(initialPhotos);
        setDirty(true, '已恢复初始数据，尚未保存');
        render();
      });
      window.addEventListener('beforeunload', (event) => {
        if (!dirty) return;
        event.preventDefault();
        event.returnValue = '';
      });

      render();
    </script>
  </body>
</html>

