---
import photos from '../data/photos.json';
import series from '../data/series.json';
import site from '../data/site.json';
import portraitBooks from '../data/portrait-books.json';
import portfolioCategories from '../data/portfolio-categories.json';
import imageManifest from '../data/image-manifest.json';
import { photoCategories as categoryConfig } from '../data/categories.js';

const serializedPhotos = JSON.stringify(photos).replace(/</g, '\\u003c');
const serializedSeries = JSON.stringify(series).replace(/</g, '\\u003c');
const serializedSite = JSON.stringify(site).replace(/</g, '\\u003c');
const serializedPortraitBooks = JSON.stringify(portraitBooks).replace(/</g, '\\u003c');
const serializedPortfolioCategories = JSON.stringify(portfolioCategories).replace(/</g, '\\u003c');
const serializedCategories = JSON.stringify(categoryConfig).replace(/</g, '\\u003c');
const serializedImageManifest = JSON.stringify(imageManifest).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>本地排版编辑器 · Bo David</title>
  </head>
  <body>
    <script id="initial-photos" type="application/json" set:html={serializedPhotos}></script>
    <script id="initial-series" type="application/json" set:html={serializedSeries}></script>
    <script id="initial-site" type="application/json" set:html={serializedSite}></script>
    <script id="initial-portrait-books" type="application/json" set:html={serializedPortraitBooks}></script>
    <script id="initial-portfolio-categories" type="application/json" set:html={serializedPortfolioCategories}></script>
    <script id="initial-categories" type="application/json" set:html={serializedCategories}></script>
    <script id="initial-image-manifest" type="application/json" set:html={serializedImageManifest}></script>

    <header class="editor-header">
      <a class="wordmark" href="/">BO DAVID</a>
      <div>
        <span class="local-badge"><i></i> 本地编辑</span>
        <a class="site-link" href="/" target="_blank">查看网站 ↗</a>
      </div>
    </header>

    <main class="editor-shell">
      <aside class="sidebar">
        <div class="sidebar-heading">
          <p class="eyebrow">Layout studio</p>
          <h1>排版<br />编辑器</h1>
          <p>首页保持原有排版；作品页使用稳定的 12 列隐形网格调整顺序、尺寸和裁切。所有操作只发生在你的电脑上。</p>
        </div>

        <div class="field-group">
          <label for="view-filter">预览版面</label>
          <select id="view-filter">
            <option value="featured">首页精选</option>
            <option value="all">全部照片</option>
            {categoryConfig.map((category) => <option value={category.slug}>{category.slug === 'portrait' ? 'Portrait Photos' : category.title}</option>)}
            <option value="portrait-layout">Portrait Books</option>
            <option value="series">Series</option>
          </select>
        </div>

        <div class="field-group" id="photo-search-field">
          <label for="search">查找照片</label>
          <input id="search" type="search" placeholder="名称、地点或 ID" autocomplete="off" />
        </div>

        <div class="stats" aria-live="polite">
          <div><strong id="visible-count">0</strong><span id="visible-label">当前显示</span></div>
          <div><strong id="featured-count">0</strong><span id="featured-label">首页精选</span></div>
          <div><strong id="total-count">0</strong><span id="total-label">照片总数</span></div>
        </div>

        <div class="help">
          <p class="eyebrow">使用方法</p>
          <ol>
            <li>在作品页拖动照片即可调整顺序</li>
            <li>选择照片后使用 S / M / L / W / T / Full</li>
            <li>所有尺寸都会吸附到隐形 12 列网格</li>
            <li>点击照片编辑属性</li>
            <li>Street / Scenes / Nature 使用拼贴规则；Portrait Books 先管理书架，再进入单书排版</li>
            <li>进入分类页后可一次添加单张或多张照片</li>
            <li>Series 先新建影集，再进入影集上传与选择封面</li>
            <li>删除只移除网站记录，不删除磁盘原图</li>
            <li>保存并覆盖 photos.json</li>
          </ol>
          <p class="note">首页只展示排在最前面的 12 张精选照片。</p>
        </div>
      </aside>

      <section class="workspace">
        <div class="toolbar">
          <div>
            <button class="button button--primary" id="open-file" type="button">打开 photos.json</button>
            <button class="button" id="save-file" type="button">保存</button>
          </div>
          <div>
            <button class="text-button" id="undo" type="button" disabled>撤销</button>
            <button class="text-button" id="download" type="button">下载副本</button>
            <button class="text-button text-button--danger" id="reset" type="button">恢复初始</button>
          </div>
        </div>

        <div class="status-row">
          <p><span id="view-title">首页精选</span><span id="canvas-scale"></span></p>
          <div class="status-actions">
            <p id="save-status" data-state="clean">已载入网站数据</p>
            <button class="add-photos" id="add-photos" type="button" hidden>
              <span class="add-photos__icon" aria-hidden="true">+</span>
              <span id="add-photos-label">添加照片</span>
            </button>
            <button class="add-photos" id="new-series" type="button" hidden>
              <span class="add-photos__icon" aria-hidden="true">+</span>
              <span>New Series</span>
            </button>
          </div>
        </div>
        <div id="layout-toolbar" class="layout-toolbar" hidden>
          <div class="layout-toolbar__selection">
            <span>Selected photo</span>
            <strong id="layout-selection">选择一张照片调整版面</strong>
          </div>
          <div class="layout-toolbar__controls" aria-label="照片尺寸预设">
            <div class="layout-toolbar__presets">
              <button type="button" data-layout-preset="S">S</button>
              <button type="button" data-layout-preset="M">M</button>
              <button type="button" data-layout-preset="L">L</button>
              <button type="button" data-layout-preset="W">W</button>
              <button type="button" data-layout-preset="T">T</button>
              <button type="button" data-layout-preset="Full">Full</button>
            </div>
            <div class="layout-toolbar__crop">
              <button type="button" data-layout-crop>Crop</button>
            </div>
            <div class="layout-toolbar__fit">
              <button type="button" data-layout-fit="contain">Contain</button>
              <button type="button" data-layout-fit="cover">Cover</button>
            </div>
          </div>
        </div>

        <div id="empty-state" class="empty-state" hidden>
          <p>没有找到照片</p>
          <button class="text-button" id="clear-search" type="button">清除搜索</button>
        </div>
        <div id="canvas-viewport" class="canvas-viewport">
          <div id="canvas-stage" class="canvas-stage">
            <div id="photo-grid" class="photo-grid" aria-label="可自由定位的照片版面"></div>
            <div id="category-sections" class="category-sections" aria-label="Portfolio selected and archive" hidden></div>
          </div>
        </div>
        <div id="portrait-layout-workspace" class="portrait-layout-workspace" hidden>
          <section id="portrait-books-list-view">
            <header class="portrait-layout-head">
              <div>
                <p class="eyebrow">Portrait books</p>
                <h2>Portrait Books</h2>
                <p>管理 Portrait 书架：创建、排序、编辑资料并选择统一书封。进入一本书后再编辑内部杂志化排版。</p>
              </div>
              <div class="portrait-layout-head__actions">
                <button class="button" id="new-portrait-book" type="button">+ New Book</button>
                <button class="button button--primary" id="save-portrait-books" type="button" disabled>Save Portrait Books</button>
              </div>
            </header>
            <div id="portrait-books-grid" class="portrait-books-grid series-editor-grid"></div>
          </section>

          <section id="portrait-book-detail-view" hidden>
            <button class="series-back" id="portrait-book-back" type="button">← Portrait Books</button>
            <header class="portrait-layout-head">
              <div>
                <p class="eyebrow">Edit book</p>
                <h2 id="portrait-book-title"></h2>
                <p id="portrait-book-meta"></p>
              </div>
              <div class="portrait-layout-head__actions">
                <button class="button" id="edit-portrait-book" type="button">Book details</button>
                <button class="button" id="add-portrait-group" type="button">+ New spread</button>
                <button class="button button--primary" id="save-portrait-layout" type="button" disabled>Save Book</button>
              </div>
            </header>
            <p id="portrait-layout-error" class="form-error" role="alert"></p>
            <div id="portrait-layout-groups" class="portrait-layout-groups"></div>
          </section>
        </div>
        <div id="series-workspace" class="series-workspace" hidden>
          <section id="series-list-view">
            <header class="series-editor-head">
              <div>
                <p class="eyebrow">Series library</p>
                <h2>影集书架</h2>
              </div>
              <p>先创建一本影集，再进入其中上传、排序并选择封面。</p>
            </header>
            <div id="series-editor-grid" class="series-editor-grid"></div>
          </section>

          <section id="series-detail-view" class="series-manager" hidden>
            <button class="series-back" id="series-back" type="button">← 返回影集书架</button>
            <header class="series-manager__head">
              <div>
                <p class="eyebrow">Series manager</p>
                <h2 id="series-manager-title"></h2>
                <p id="series-manager-meta"></p>
              </div>
              <div class="series-manager__actions">
                <button class="add-photos" id="upload-series-photos" type="button">
                  <span class="add-photos__icon" aria-hidden="true">+</span>
                  <span>Upload Photos</span>
                </button>
                <button class="button" id="edit-active-series" type="button">Edit Series</button>
              </div>
            </header>
            <div class="series-layout-toolbar" hidden>
              <div>
                <button class="text-button" id="add-portrait-row" type="button">+ Portrait Row</button>
                <button class="text-button" id="add-landscape-row" type="button">+ Landscape Row</button>
              </div>
              <button class="button button--primary" id="save-series-layout" type="button" disabled>Save Layout</button>
            </div>
            <div id="series-photo-empty" class="series-photo-empty" hidden>
              <p>这本影集还没有照片</p>
              <span>上传后的第一张照片会自动成为封面。</span>
            </div>
            <div id="series-photo-grid" class="series-photo-grid"></div>
          </section>
        </div>
      </section>
    </main>

    <dialog id="inspector">
      <form id="photo-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Photo details</p>
            <h2>照片设置</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>

        <div class="dialog-preview"><img id="form-preview" src="" alt="" /></div>
        <input id="form-original-id" type="hidden" />
        <div class="form-grid">
          <label>标题<input id="form-title" required /></label>
          <label>唯一 ID<input id="form-id" required pattern="[a-zA-Z0-9_-]+" /></label>
          <label>分类
            <select id="form-category" required>
              {categoryConfig.map((category) => <option value={category.slug}>{category.title}</option>)}
              <option value="series">Series</option>
            </select>
          </label>
          <label>画面方向
            <select id="form-orientation" required>
              <option value="landscape">横图</option>
              <option value="portrait">竖图</option>
            </select>
          </label>
          <div class="form-grid-sub full" id="legacy-layout-fields">
            <label>显示尺寸（%）<input id="form-layout-width" type="number" min="45" max="200" step="1" required /></label>
            <label>水平位置（%）<input id="form-offset-x" type="number" min="-80" max="80" step="1" required /></label>
            <label>垂直位置（%）<input id="form-offset-y" type="number" min="-80" max="80" step="1" required /></label>
          </div>
          <div class="form-grid-sub full" id="collage-layout-fields" hidden>
            <label>占用列数<input id="form-col-span" type="number" min="3" max="12" step="1" /></label>
            <label class="toggle"><input id="form-crop" type="checkbox" /><span aria-hidden="true"></span>裁切模式</label>
            <label id="form-row-span-field">裁切比例高度<input id="form-row-span" type="number" min="3" max="8" step="1" /></label>
            <label>图片适配
              <select id="form-fit">
                <option value="contain">Contain</option>
                <option value="cover">Cover</option>
              </select>
            </label>
            <label>水平焦点（%）<input id="form-focal-x" type="number" min="0" max="100" step="1" /></label>
            <label>垂直焦点（%）<input id="form-focal-y" type="number" min="0" max="100" step="1" /></label>
          </div>
          <label>点开尺寸（%）<input id="form-detail-scale" type="number" min="60" max="140" step="1" required /></label>
          <label>地点<input id="form-location" /></label>
          <label>日期<input id="form-date" /></label>
          <label>所属系列<input id="form-series" placeholder="没有可留空" /></label>
          <label>图片路径<input id="form-image" required /></label>
          <label>首页点击标题<input id="form-home-title" placeholder="留空则使用普通标题" /></label>
          <label>首页点击文案<input id="form-home-caption" placeholder="留空则不显示文案" /></label>
          <label class="full">图片描述<textarea id="form-alt" rows="3" required></textarea></label>
          <label class="toggle full"><input id="form-featured" type="checkbox" /><span></span>显示在首页精选</label>
          <div class="home-intro-control full" id="home-intro-control" hidden>
            <div>
              <strong>首页封面轮播</strong>
              <span id="home-intro-status">这张横图尚未设为首页封面</span>
            </div>
            <button class="button" id="set-home-intro" type="button">设为首页封面</button>
          </div>
        </div>
        <p id="form-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <button class="text-button text-button--danger" id="delete-photo" type="button">删除照片</button>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="apply-photo" type="button">应用修改</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="home-intro-dialog" class="home-intro-dialog">
      <form method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Home cover</p>
            <h2>选择封面顺序</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="home-intro-dialog__copy">选择第几张封面。确认后会替换原来占据该位置的图片。</p>
        <div class="home-intro-slots" id="home-intro-slots"></div>
        <div class="dialog-actions">
          <span></span>
          <button class="text-button" value="cancel" type="submit">取消</button>
        </div>
      </form>
    </dialog>

    <dialog id="series-dialog" class="series-dialog">
      <form id="series-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">New photo book</p>
            <h2>New Series</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="series-dialog__intro">名称会自动生成网址 slug，你也可以在创建前微调。</p>
        <div class="form-grid">
          <label>Series 名称<input id="series-title" required placeholder="Tokyo 2026" /></label>
          <label>Slug<input id="series-slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="tokyo-2026" /></label>
          <label>年份<input id="series-year" placeholder="2026" /></label>
          <label class="full">简短说明<textarea id="series-description" rows="3" placeholder="可稍后填写"></textarea></label>
        </div>
        <p id="series-form-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="create-series" type="button">创建 Series</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="series-edit-dialog" class="series-dialog">
      <form id="series-edit-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Edit photo book</p>
            <h2>Edit Series</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="series-dialog__intro">Slug 创建后保持不变，避免图片路径和公开链接失效。</p>
        <input id="series-edit-original-slug" type="hidden" />
        <div class="form-grid">
          <label>Series 名称<input id="series-edit-title" required /></label>
          <label>Slug<input id="series-edit-slug" readonly /></label>
          <label>年份<input id="series-edit-year" /></label>
          <label>展示顺序<input id="series-edit-order" type="number" min="1" step="1" required /></label>
          <label class="full">封面路径<input id="series-edit-cover" placeholder="/images/series/slug/001.jpg" /></label>
          <label class="full">简短说明<textarea id="series-edit-description" rows="3"></textarea></label>
        </div>
        <p id="series-edit-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <button class="text-button text-button--danger" id="request-delete-series" type="button">Delete Series</button>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="save-series-edit" type="button">保存修改</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="series-delete-dialog" class="warning-dialog">
      <form id="series-delete-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Move to trash</p>
            <h2>确认删除 Series</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="warning-copy">这会移除该 Series 及其照片记录，并把图片文件夹移动到 <code>trash/series/</code>。请输入 slug 再确认。</p>
        <label class="delete-confirm-label">输入 <strong id="series-delete-slug-label"></strong>
          <input id="series-delete-confirmation" autocomplete="off" required />
        </label>
        <p id="series-delete-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--danger" id="confirm-delete-series" type="button" disabled>Move to Trash</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="large-file-warning" class="warning-dialog">
      <form method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">File size warning</p>
            <h2>图片超过 5 MB</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <p class="warning-copy">以下图片可能影响网页加载速度。你仍然可以继续添加，之后建议压缩图片。</p>
        <ul id="large-file-list" class="warning-list"></ul>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" value="continue" type="submit">仍然添加</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="portrait-book-dialog" class="series-dialog">
      <form id="portrait-book-form" method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Portrait book</p>
            <h2 id="portrait-book-dialog-title">New Portrait Book</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit" formnovalidate>×</button>
        </div>
        <p class="series-dialog__intro">书封只影响 Portrait 书架；组图中的 Cover 开关仍只控制书内裁切。</p>
        <input id="portrait-book-original-slug" type="hidden" />
        <div class="form-grid">
          <label>Book title<input id="portrait-book-form-title" maxlength="120" required /></label>
          <label>Slug<input id="portrait-book-form-slug" maxlength="80" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /></label>
          <label>Year<input id="portrait-book-form-year" maxlength="20" /></label>
          <div class="portrait-book-cover-field full">
            <div class="portrait-book-cover-field__head">
              <label for="portrait-book-cover-search">Book cover</label>
              <span id="portrait-book-cover-selection" aria-live="polite">Choose a Selected Portrait</span>
            </div>
            <input
              id="portrait-book-cover-search"
              class="portrait-book-cover-search"
              type="search"
              placeholder="Search by number or filename…"
              autocomplete="off"
            />
            <input id="portrait-book-form-cover" type="hidden" />
            <div
              id="portrait-book-cover-grid"
              class="portrait-book-cover-grid"
              role="listbox"
              aria-label="Choose a Portrait book cover"
            ></div>
          </div>
          <label class="full">Description<textarea id="portrait-book-form-description" rows="3" maxlength="500"></textarea></label>
        </div>
        <p id="portrait-book-form-error" class="form-error" role="alert"></p>
        <div class="dialog-actions">
          <span></span>
          <div>
            <button class="text-button" value="cancel" type="submit" formnovalidate>取消</button>
            <button class="button button--primary" id="save-portrait-book-details" type="button">Save Book</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="portrait-category-cover-dialog" class="portrait-photo-picker-dialog">
      <form method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Portfolio entrance</p>
            <h2>Portrait Covers</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <div class="portrait-photo-picker__meta">
          <p>依次选择左、中、右三张竖图。Selected 与 Archive 中的 Portrait 均可使用。</p>
          <span id="portrait-category-cover-count">0 / 3 selected</span>
        </div>
        <input
          id="portrait-category-cover-search"
          class="portrait-photo-picker__search"
          type="search"
          placeholder="Search by number or filename…"
          autocomplete="off"
        />
        <div
          id="portrait-category-cover-grid"
          class="portrait-photo-picker__grid"
          role="listbox"
          aria-multiselectable="true"
          aria-label="Choose three Portrait entrance covers"
        ></div>
        <div class="dialog-actions portrait-photo-picker__actions">
          <span id="portrait-category-cover-selection" aria-live="polite">Choose left cover first</span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="save-portrait-category-covers" type="button" disabled>Save three covers</button>
          </div>
        </div>
      </form>
    </dialog>

    <dialog id="portrait-photo-picker-dialog" class="portrait-photo-picker-dialog">
      <form method="dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Portrait book</p>
            <h2 id="portrait-photo-picker-title">Choose a photograph</h2>
          </div>
          <button class="icon-button" value="cancel" aria-label="关闭" type="submit">×</button>
        </div>
        <div class="portrait-photo-picker__meta">
          <p>Selected Portfolio 与 Archive 中的 Portrait 照片均可用于书内排版。</p>
          <span id="portrait-photo-picker-count"></span>
        </div>
        <input
          id="portrait-photo-picker-search"
          class="portrait-photo-picker__search"
          type="search"
          placeholder="Search by number or filename…"
          autocomplete="off"
        />
        <div
          id="portrait-photo-picker-grid"
          class="portrait-photo-picker__grid"
          role="listbox"
          aria-label="Choose a Portrait photograph"
        ></div>
        <div class="dialog-actions portrait-photo-picker__actions">
          <span id="portrait-photo-picker-selection" aria-live="polite">Choose one photograph</span>
          <div>
            <button class="text-button" value="cancel" type="submit">取消</button>
            <button class="button button--primary" id="confirm-portrait-photo" type="button" disabled>Add photograph</button>
          </div>
        </div>
      </form>
    </dialog>

    <input id="file-fallback" type="file" accept="application/json,.json" hidden />
    <input id="photo-file-input" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple hidden />
    <input id="series-photo-input" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple hidden />
    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      import { buildOrientationRows } from '../utils/photo-layout.js';
      import { collageLayoutPresets, normalizeCollageLayout, sortPhotosByOrder } from '../utils/collage-layout.js';
      import { getPortfolioStatus, migratePortfolioPhotos, sortPortfolioPhotos } from '../utils/portfolio-status.js';
      import { PORTRAIT_LAYOUT_PRESETS, normalizePortraitBooks, normalizePortraitLayout, resolvePortraitSpread } from '../utils/portrait-layout.js';

      const initialNode = document.querySelector('#initial-photos');
      const initialSeriesNode = document.querySelector('#initial-series');
      const initialSiteNode = document.querySelector('#initial-site');
      const initialPortraitBooksNode = document.querySelector('#initial-portrait-books');
      const initialPortfolioCategoriesNode = document.querySelector('#initial-portfolio-categories');
      const initialCategoriesNode = document.querySelector('#initial-categories');
      const initialImageManifestNode = document.querySelector('#initial-image-manifest');
      const initialPhotos = JSON.parse(initialNode?.textContent || '[]');
      const initialSeries = JSON.parse(initialSeriesNode?.textContent || '[]');
      const initialSite = JSON.parse(initialSiteNode?.textContent || '{}');
      const initialPortraitBooks = normalizePortraitBooks(JSON.parse(initialPortraitBooksNode?.textContent || '{}'));
      const initialPortfolioCategories = JSON.parse(initialPortfolioCategoriesNode?.textContent || '[]');
      const photoCategoryConfig = JSON.parse(initialCategoriesNode?.textContent || '[]');
      const imageManifest = JSON.parse(initialImageManifestNode?.textContent || '{}');
      let photoData = migratePortfolioPhotos(initialPhotos);
      let seriesData = structuredClone(initialSeries);
      let siteData = structuredClone(initialSite);
      let siteDirty = false;
      let portraitBooksData = structuredClone(initialPortraitBooks);
      let portfolioCategoriesData = structuredClone(initialPortfolioCategories);
      let portraitBooksDirty = false;
      let portraitBooksFileHandle = null;
      let activePortraitBookSlug = sessionStorage.getItem('editorPortraitBookSlug') || '';
      const portraitBooksHistory = [];
      let portraitPhotoPickerGroupId = '';
      let portraitPhotoPickerSelectionId = '';
      let portraitCategoryCoverSelection = [];
      let fileHandle = null;
      let dirty = false;
      let activeSeriesSlug = sessionStorage.getItem('editorSeriesSlug') || '';
      let layoutDraftSlug = '';
      let layoutDraftRows = [];
      let layoutDirty = false;
      let selectedLayoutPhotoId = '';
      let draggedLayoutPhotoId = '';
      const history = [];
      const maxRecommendedFileSize = 5 * 1024 * 1024;
      const COLLAGE_RATIO_MIN = 0.55;
      const COLLAGE_RATIO_MAX = 1.9;
      const COLLAGE_WIDTH_SPANS = [...new Set(Object.values(collageLayoutPresets).map((preset) => preset.colSpan))]
        .sort((a, b) => a - b);
      const photoCategories = photoCategoryConfig.map((category) => category.slug);
      const rowLayoutCategories = photoCategoryConfig.filter((category) => category.rowLayout).map((category) => category.slug);

      const grid = document.querySelector('#photo-grid');
      const viewFilter = document.querySelector('#view-filter');
      const searchInput = document.querySelector('#search');
      const inspector = document.querySelector('#inspector');
      const formError = document.querySelector('#form-error');
      const canvasViewport = document.querySelector('#canvas-viewport');
      const canvasStage = document.querySelector('#canvas-stage');
      const categorySections = document.querySelector('#category-sections');
      const addPhotosButton = document.querySelector('#add-photos');
      const addPhotosLabel = document.querySelector('#add-photos-label');
      const largeFileWarning = document.querySelector('#large-file-warning');
      const newSeriesButton = document.querySelector('#new-series');
      const seriesWorkspace = document.querySelector('#series-workspace');
      const portraitLayoutWorkspace = document.querySelector('#portrait-layout-workspace');
      const portraitLayoutGroups = document.querySelector('#portrait-layout-groups');
      const portraitBooksListView = document.querySelector('#portrait-books-list-view');
      const portraitBookDetailView = document.querySelector('#portrait-book-detail-view');
      const portraitBooksGrid = document.querySelector('#portrait-books-grid');
      const portraitBookDialog = document.querySelector('#portrait-book-dialog');
      const portraitPhotoPickerDialog = document.querySelector('#portrait-photo-picker-dialog');
      const portraitCategoryCoverDialog = document.querySelector('#portrait-category-cover-dialog');
      const seriesListView = document.querySelector('#series-list-view');
      const seriesDetailView = document.querySelector('#series-detail-view');
      const seriesEditorGrid = document.querySelector('#series-editor-grid');
      const seriesPhotoGrid = document.querySelector('#series-photo-grid');
      const seriesDialog = document.querySelector('#series-dialog');
      const seriesEditDialog = document.querySelector('#series-edit-dialog');
      const seriesDeleteDialog = document.querySelector('#series-delete-dialog');
      const layoutToolbar = document.querySelector('#layout-toolbar');

      const savedView = sessionStorage.getItem('editorView');
      const requestedView = new URLSearchParams(window.location.search).get('view');
      const initialView = requestedView || savedView;
      if (['featured', 'all', ...photoCategories, 'portrait-layout', 'series'].includes(initialView)) viewFilter.value = initialView;

      const $ = (selector) => document.querySelector(selector);
      const escapeHtml = (value = '') => String(value)
        .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

      function snapshot() {
        history.push(structuredClone(photoData));
        if (history.length > 30) history.shift();
        $('#undo').disabled = false;
      }

      function setDirty(value, message) {
        dirty = value;
        const status = $('#save-status');
        status.dataset.state = value ? 'dirty' : 'clean';
        status.textContent = message || (value ? '有未保存修改' : '所有修改已保存');
      }

      function showToast(message) {
        const toast = $('#toast');
        toast.textContent = message;
        toast.classList.add('is-visible');
        window.clearTimeout(showToast.timer);
        showToast.timer = window.setTimeout(() => toast.classList.remove('is-visible'), 2400);
      }

      const editorMasonryMedia = window.matchMedia('(max-width: 620px)');
      const editorMasonryFrames = new WeakMap();

      function packEditorMasonry(container) {
        const cards = Array.from(container.querySelectorAll(':scope > .editor-card--collage'));
        cards.forEach((card) => card.style.removeProperty('grid-row-end'));
        if (editorMasonryMedia.matches) return;

        void container.offsetWidth;
        const rowSize = Number.parseFloat(getComputedStyle(container).gridAutoRows) || 1;
        const styles = getComputedStyle(container);
        const editorChrome = Number.parseFloat(styles.getPropertyValue('--editor-layout-chrome')) || 0;
        const gap = Number.parseFloat(styles.getPropertyValue('--gallery-gap')) || 0;
        const rowSpans = cards.map((card) => {
          const image = card.querySelector('.editor-card__image');
          const imageHeight = image?.offsetHeight || card.offsetHeight;
          return Math.max(1, Math.ceil((imageHeight + gap + editorChrome) / rowSize));
        });
        cards.forEach((card, index) => {
          card.style.gridRowEnd = `span ${rowSpans[index]}`;
        });
      }

      function scheduleEditorMasonry(container) {
        if (!container) return;
        const previousFrame = editorMasonryFrames.get(container);
        if (previousFrame) window.cancelAnimationFrame(previousFrame);
        container.querySelectorAll('img').forEach((image) => {
          if (!image.complete && image.dataset.masonryBound !== 'true') {
            image.dataset.masonryBound = 'true';
            image.addEventListener('load', () => scheduleEditorMasonry(container), { once: true });
          }
        });
        editorMasonryFrames.set(container, window.requestAnimationFrame(() => {
          editorMasonryFrames.delete(container);
          packEditorMasonry(container);
        }));
      }

      function getVisiblePhotos() {
        const filter = viewFilter.value;
        const query = searchInput.value.trim().toLowerCase();
        const visible = photoData.filter((photo) => {
          const matchesView = filter === 'all' || (filter === 'featured' ? photo.featured : photo.category === filter);
          const haystack = [photo.id, photo.title, photo.location, photo.series, photo.alt].join(' ').toLowerCase();
          return matchesView && (!query || haystack.includes(query));
        });
        return photoCategories.includes(filter) ? sortPhotosByOrder(visible) : visible;
      }

      function isPortfolioView() {
        return photoCategories.includes(viewFilter.value);
      }

      function portfolioItems(status, category = viewFilter.value, respectSearch = false) {
        const query = respectSearch ? searchInput.value.trim().toLowerCase() : '';
        return sortPortfolioPhotos(
          photoData.filter((photo) => {
            if (photo.category !== category || getPortfolioStatus(photo, category) !== status) return false;
            if (!query) return true;
            return [photo.id, photo.title, photo.location, photo.series, photo.alt].join(' ').toLowerCase().includes(query);
          }),
          status,
        );
      }

      function snapshotPortraitBooks() {
        portraitBooksHistory.push(structuredClone(portraitBooksData));
        if (portraitBooksHistory.length > 30) portraitBooksHistory.shift();
        if (viewFilter.value === 'portrait-layout') $('#undo').disabled = false;
      }

      function setPortraitBooksDirty(value, message) {
        portraitBooksDirty = value;
        $('#save-portrait-layout').disabled = !value;
        $('#save-portrait-books').disabled = !value;
        if (viewFilter.value !== 'portrait-layout') return;
        const status = $('#save-status');
        status.dataset.state = value ? 'dirty' : 'clean';
        status.textContent = message || (value ? 'Portrait Books 有未保存修改' : 'Portrait Books 已保存');
      }

      function portfolioUsesRows(category = viewFilter.value) {
        return photoData.some((photo) => (
          photo.category === category
          && getPortfolioStatus(photo, category) === 'selected'
          && photo.layoutMode === 'rows'
        ));
      }

      function setPortfolioRowsMode(enabled) {
        if (!isPortfolioView()) return;
        const category = viewFilter.value;
        snapshot();
        photoData.forEach((photo) => {
          if (photo.category !== category) return;
          if (enabled && getPortfolioStatus(photo, category) === 'selected') photo.layoutMode = 'rows';
          else if (!enabled) delete photo.layoutMode;
        });
        setDirty(true, enabled ? '已启用行布局，尚未保存' : '已恢复瀑布流布局，尚未保存');
        render();
        showToast(enabled ? 'Selected Portfolio 已启用行布局' : '已恢复当前分类的瀑布流布局');
      }

      function normalizePortfolioOrders(category = viewFilter.value) {
        if (!photoCategories.includes(category)) return;
        const selected = portfolioItems('selected', category);
        const archive = portfolioItems('archive', category);
        selected.forEach((photo, index) => {
          photo.portfolioStatus = 'selected';
          photo.selectedOrder = index + 1;
          photo.archiveOrder = null;
        });
        archive.forEach((photo, index) => {
          photo.portfolioStatus = 'archive';
          photo.selectedOrder = null;
          photo.archiveOrder = index + 1;
        });
      }

      function movePortfolioPhotos(ids, nextStatus) {
        if (!isPortfolioView() || !ids.length || !['selected', 'archive'].includes(nextStatus)) return;
        const category = viewFilter.value;
        const current = new Set(ids);
        const sourceStatus = nextStatus === 'selected' ? 'archive' : 'selected';
        const movable = portfolioItems(sourceStatus, category).filter((photo) => current.has(photo.id));
        if (!movable.length) return;

        snapshot();
        const destination = portfolioItems(nextStatus, category);
        let nextOrder = destination.length + 1;
        movable.forEach((photo) => {
          photo.portfolioStatus = nextStatus;
          photo.selectedOrder = nextStatus === 'selected' ? nextOrder : null;
          photo.archiveOrder = nextStatus === 'archive' ? nextOrder : null;
          if (nextStatus === 'selected' && portfolioUsesRows(category)) photo.layoutMode = 'rows';
          if (nextStatus === 'archive') delete photo.layoutMode;
          nextOrder += 1;
        });
        normalizePortfolioOrders(category);
        setDirty(true, nextStatus === 'selected'
          ? `${movable.length} 张照片已加入 Selected Portfolio，尚未保存`
          : `${movable.length} 张照片已移入 Archive，尚未保存`);
        render();
        showToast(nextStatus === 'selected' ? `${movable.length} 张照片已加入 Selected Portfolio` : `${movable.length} 张照片已移入 Archive`);
      }

      function reorderPortfolioPhotos(status, draggedId, targetId, placeAfter) {
        if (!isPortfolioView() || draggedId === targetId) return;
        const items = portfolioItems(status);
        const currentIds = items.map((photo) => photo.id);
        if (!currentIds.includes(draggedId) || !currentIds.includes(targetId)) return;
        const orderedIds = currentIds.filter((id) => id !== draggedId);
        const targetIndex = orderedIds.indexOf(targetId);
        orderedIds.splice(targetIndex + (placeAfter ? 1 : 0), 0, draggedId);
        if (orderedIds.join('|') === currentIds.join('|')) return;

        snapshot();
        const orderField = status === 'selected' ? 'selectedOrder' : 'archiveOrder';
        const orderById = new Map(orderedIds.map((id, index) => [id, index + 1]));
        photoData.forEach((photo) => {
          if (orderById.has(photo.id)) {
            photo.portfolioStatus = status;
            photo[orderField] = orderById.get(photo.id);
            photo[status === 'selected' ? 'archiveOrder' : 'selectedOrder'] = null;
          }
        });
        setDirty(true, 'Portfolio 顺序已更新，尚未保存');
        render();
        showToast(`${status === 'selected' ? 'Selected' : 'Archive'} 顺序已更新`);
      }

      function isCollageContext() {
        return photoCategories.includes(viewFilter.value) || (viewFilter.value === 'series' && Boolean(activeSeriesSlug));
      }

      function currentCollagePhotos() {
        if (photoCategories.includes(viewFilter.value)) {
          return sortPhotosByOrder(photoData.filter((photo) => photo.category === viewFilter.value));
        }
        if (viewFilter.value === 'series' && activeSeriesSlug) return photosForSeries(activeSeriesSlug);
        return [];
      }

      function saveableLayout(photo) {
        const layout = normalizeCollageLayout(photo);
        const result = {
          colSpan: layout.colSpan,
          rowSpan: layout.rowSpan,
          crop: layout.crop,
          fit: layout.fit,
          focalX: layout.focalX,
          focalY: layout.focalY,
        };
        if (layout.ratio !== null) result.ratio = layout.ratio;
        return result;
      }

      function setPhotoLayout(photo, values) {
        photo.layout = saveableLayout({ ...photo, layout: { ...saveableLayout(photo), ...values } });
      }

      function presetName(layout) {
        return Object.entries(collageLayoutPresets)
          .find(([, preset]) => preset.colSpan === layout.colSpan)?.[0] || '';
      }

      function updateLayoutToolbar() {
        const isVisible = isCollageContext();
        layoutToolbar.hidden = !isVisible;
        if (!isVisible) return;

        const photo = currentCollagePhotos().find((item) => item.id === selectedLayoutPhotoId);
        const selection = $('#layout-selection');
        const buttons = layoutToolbar.querySelectorAll('[data-layout-preset], [data-layout-fit], [data-layout-crop]');
        buttons.forEach((button) => {
          button.disabled = !photo;
          button.classList.remove('is-active');
        });
        document.querySelectorAll('.editor-card.is-selected').forEach((card) => card.classList.remove('is-selected'));

        if (!photo) {
          selection.textContent = '选择一张照片调整版面';
          return;
        }

        const layout = normalizeCollageLayout(photo);
        selection.textContent = `${photo.title || photo.id} · ${layout.colSpan} columns · ${layout.ratio ? `Ratio ${layout.ratio.toFixed(2)}` : layout.crop ? `Crop ${layout.rowSpan}` : 'Natural ratio'}`;
        document.querySelectorAll(`.editor-card[data-id="${CSS.escape(photo.id)}"]`).forEach((card) => card.classList.add('is-selected'));
        layoutToolbar.querySelector(`[data-layout-preset="${presetName(layout)}"]`)?.classList.add('is-active');
        layoutToolbar.querySelector('[data-layout-crop]')?.classList.toggle('is-active', layout.crop);
        layoutToolbar.querySelectorAll('[data-layout-fit]').forEach((button) => {
          button.disabled = !layout.crop;
          button.classList.toggle('is-active', layout.crop && button.dataset.layoutFit === layout.fit);
        });
      }

      function selectLayoutPhoto(id) {
        selectedLayoutPhotoId = id;
        updateLayoutToolbar();
      }

      function getEditorImageDimensions(photo) {
        const entry = imageManifest[photo?.image];
        const width = Number(entry?.width);
        const height = Number(entry?.height);
        return width > 0 && height > 0 ? { width, height } : null;
      }

      function editorThumbnailMarkup(photo, alt = '') {
        const entry = imageManifest[photo?.image];
        const variants = Array.isArray(entry?.variants)
          ? [...entry.variants].filter((variant) => Number(variant.width) > 0 && variant.src).sort((a, b) => Number(a.width) - Number(b.width))
          : [];
        const dimensions = getEditorImageDimensions(photo);
        const dimensionAttributes = dimensions ? `width="${dimensions.width}" height="${dimensions.height}"` : '';
        const srcset = variants.map((variant) => `${escapeHtml(variant.src)} ${Number(variant.width)}w`).join(', ');
        const fallback = variants[0]?.src || photo.image;
        return `<picture>
          ${srcset ? `<source type="image/webp" srcset="${srcset}" sizes="(max-width: 420px) 44vw, (max-width: 620px) 30vw, 9rem" />` : ''}
          <img src="${escapeHtml(fallback)}" alt="${escapeHtml(alt)}" ${dimensionAttributes} loading="lazy" decoding="async" />
        </picture>`;
      }

      function collageEditorCard(photo, index, cover = '', portfolioStatus = '') {
        const layout = normalizeCollageLayout(photo);
        const dimensions = getEditorImageDimensions(photo);
        const dimensionAttributes = dimensions ? `width="${dimensions.width}" height="${dimensions.height}"` : '';
        const isSeriesPhoto = viewFilter.value === 'series';
        const isPortfolioPhoto = Boolean(portfolioStatus);
        const isCover = Boolean(cover && photo.image === cover);
        const preset = presetName(layout) || `${layout.colSpan}×${layout.rowSpan}`;
        const scopeItems = isPortfolioPhoto ? portfolioItems(portfolioStatus) : currentCollagePhotos();
        const scopeIndex = scopeItems.findIndex((item) => item.id === photo.id);
        return `
          <article
            class="editor-card editor-card--collage ${isPortfolioPhoto ? `editor-card--portfolio editor-card--portfolio-${portfolioStatus}` : ''} ${layout.crop ? 'editor-card--cropped' : ''} ${layout.ratio ? 'is-ratio-adjusted' : ''} ${selectedLayoutPhotoId === photo.id ? 'is-selected' : ''}"
            data-id="${escapeHtml(photo.id)}"
            ${isPortfolioPhoto ? `data-portfolio-status="${portfolioStatus}"` : ''}
            style="--editor-col-span:${layout.colSpan}; --editor-aspect:${layout.colSpan}/${layout.rowSpan}; ${dimensions ? `--editor-natural-aspect:${dimensions.width}/${dimensions.height};` : ''} ${layout.ratio ? `--editor-display-aspect:1/${layout.ratio};` : ''} --editor-fit:${layout.fit}; --editor-focal-x:${layout.focalX}%; --editor-focal-y:${layout.focalY}%"
          >
            <div class="editor-card__image" data-layout-select>
              <img src="${escapeHtml(photo.image)}" alt="${escapeHtml(photo.alt || '')}" ${dimensionAttributes} loading="lazy" />
              <span class="card-badge">${String(index + 1).padStart(2, '0')}</span>
              ${isPortfolioPhoto ? `<label class="portfolio-select" title="Select photo"><input type="checkbox" data-portfolio-select value="${escapeHtml(photo.id)}" /><span aria-hidden="true"></span><span class="sr-only">Select ${escapeHtml(photo.title || photo.id)}</span></label>` : ''}
              ${isCover ? '<span class="cover-badge">Cover</span>' : ''}
              ${isSeriesPhoto ? '' : `
                <button class="favorite ${photo.featured ? 'is-active' : ''}" type="button" data-action="featured" aria-label="${photo.featured ? '取消首页精选' : '加入首页精选'}" title="首页精选">★</button>
                <button class="delete-control" type="button" data-action="delete" aria-label="删除照片" title="从网站中删除">×</button>
              `}
              <button class="collage-resize-handle collage-resize-handle--left" type="button" data-collage-resize="width-left" aria-label="Drag to resize image width from the left" title="Drag to change width preset"></button>
              <button class="collage-resize-handle collage-resize-handle--right" type="button" data-collage-resize="width-right" aria-label="Drag to resize image width from the right" title="Drag to change width preset"></button>
              <button class="collage-resize-handle collage-resize-handle--height" type="button" data-collage-resize="height" aria-label="Drag to resize image container height" title="Drag to change image ratio"></button>
            </div>
            <div class="editor-card__footer">
              <button class="editor-card__meta" type="button" data-action="edit">
                <span data-layout-summary><strong>${escapeHtml(photo.title || photo.id)}</strong><small data-layout-summary-text>${escapeHtml(preset)} · ${layout.ratio ? `ratio ${layout.ratio.toFixed(2)}` : layout.crop ? `crop ${escapeHtml(layout.fit)}` : 'natural'}</small></span>
                <span>编辑</span>
              </button>
              ${isPortfolioPhoto ? `<button class="portfolio-move-button" type="button" data-portfolio-action="${portfolioStatus === 'selected' ? 'archive' : 'selected'}">${portfolioStatus === 'selected' ? 'Move to archive' : 'Add to selected'}</button>` : ''}
                            <button class="fit-toggle" type="button" data-action="fit-toggle" data-fit="${layout.fit}" title="Switch between Cover and Contain">${layout.crop ? (layout.fit === "cover" ? "Cover" : "Contain") : ""}</button>
              <div class="collage-order-controls" aria-label="调整照片顺序">
                <button type="button" data-action="up" aria-label="与前一张交换" title="与前一张交换" ${scopeIndex <= 0 ? 'disabled' : ''}>←</button>
                <button type="button" data-action="down" aria-label="与后一张交换" title="与后一张交换" ${scopeIndex < 0 || scopeIndex === scopeItems.length - 1 ? 'disabled' : ''}>→</button>
              </div>
              ${isSeriesPhoto && !isCover ? `<button class="cover-control" type="button" data-cover-image="${escapeHtml(photo.image)}">Set cover</button>` : ''}
            </div>
          </article>`;
      }

      function getLayoutScope() {
        if (viewFilter.value === 'featured') return 'home';
        if (photoCategories.includes(viewFilter.value)) return 'category';
        return null;
      }

      function getLayoutProperty(scope, type) {
        if (scope === 'category') {
          if (type === 'width') return 'categoryLayoutWidth';
          return axisProperty('categoryLayoutOffset', type);
        }
        if (type === 'width') return 'layoutWidth';
        return axisProperty('layoutOffset', type);
      }

      function axisProperty(prefix, axis) {
        return `${prefix}${axis === 'x' ? 'X' : 'Y'}`;
      }

      function getDefaultLayoutWidth(photo, scope) {
        return scope === 'category' && photo.category === 'portrait' ? 78 : 100;
      }

      function getLayoutWidth(photo, scope = getLayoutScope()) {
        const width = Number(photo[getLayoutProperty(scope, 'width')]);
        return Number.isFinite(width)
          ? Math.min(200, Math.max(45, Math.round(width)))
          : getDefaultLayoutWidth(photo, scope);
      }

      function getLayoutOffset(photo, axis, scope = getLayoutScope()) {
        const offset = Number(photo[getLayoutProperty(scope, axis)]);
        return Number.isFinite(offset) ? Math.min(80, Math.max(-80, Math.round(offset))) : 0;
      }

      function setLayoutWidth(photo, value, scope = getLayoutScope()) {
        if (!scope) return;
        photo[getLayoutProperty(scope, 'width')] = Math.min(200, Math.max(45, Math.round(value)));
      }

      function setLayoutOffset(photo, axis, value, scope = getLayoutScope()) {
        if (!scope) return;
        photo[getLayoutProperty(scope, axis)] = Math.min(80, Math.max(-80, Math.round(value)));
      }

      function syncCanvasScale() {
        if (!canvasViewport || !canvasStage) return;
        canvasStage.style.zoom = '1';
        if (window.innerWidth <= 620) {
          canvasStage.style.width = '100%';
        } else {
          const sitePadding = Math.min(72, Math.max(20, window.innerWidth * 0.04));
          // Keep the editor canvas on the same sub-pixel grid as the public
          // page shell; dense placement is sensitive to a single rounding step.
          canvasStage.style.width = `${document.documentElement.clientWidth - sitePadding * 2 - 0.2}px`;
        }
        const designWidth = canvasStage.offsetWidth;
        const availableWidth = canvasViewport.clientWidth;
        const scale = window.innerWidth <= 620 || !designWidth ? 1 : Math.min(1, availableWidth / designWidth);
        canvasStage.style.zoom = String(scale);
        $('#canvas-scale').textContent = window.innerWidth <= 620 ? '' : ` · 完整画布 ${Math.round(scale * 100)}% 预览`;
      }

      function orderedSeries() {
        return seriesData
          .map((item, index) => ({ item, index, order: Number.isFinite(Number(item.order)) ? Number(item.order) : index + 1 }))
          .sort((a, b) => a.order - b.order || a.index - b.index)
          .map(({ item }) => item);
      }

      function photosForSeries(slug) {
        return photoData
          .map((photo, index) => ({ photo, index, order: Number.isFinite(Number(photo.order)) ? Number(photo.order) : index + 1 }))
          .filter(({ photo }) => photo.series === slug)
          .sort((a, b) => a.order - b.order || a.index - b.index)
          .map(({ photo }) => photo);
      }

      function seriesCover(item, items = photosForSeries(item.slug)) {
        return item.coverImage || items[0]?.image || '';
      }

      function maxRowPhotos(orientation) {
        return orientation === 'portrait' ? 4 : 3;
      }

      function defaultSeriesRows(items) {
        return buildOrientationRows(items).map((row) => ({
          orientation: row.orientation,
          photoIds: row.items.map((photo) => photo.id),
        }));
      }

      function normalizedSeriesRows(item, items) {
        const photosById = new Map(items.map((photo) => [photo.id, photo]));
        const used = new Set();
        const rows = [];
        if (Array.isArray(item.layoutRows)) {
          item.layoutRows.forEach((row) => {
            const orientation = row?.orientation === 'portrait' ? 'portrait' : 'landscape';
            const photoIds = Array.isArray(row?.photoIds)
              ? row.photoIds.filter((id) => {
                  const photo = photosById.get(id);
                  if (!photo || used.has(id) || photo.orientation !== orientation) return false;
                  used.add(id);
                  return true;
                }).slice(0, maxRowPhotos(orientation))
              : [];
            if (photoIds.length) rows.push({ orientation, photoIds });
          });
        }
        const missing = items.filter((photo) => !used.has(photo.id));
        defaultSeriesRows(missing).forEach((row) => rows.push(row));
        return rows;
      }

      function ensureLayoutDraft(item, items) {
        if (layoutDraftSlug === item.slug) return;
        layoutDraftSlug = item.slug;
        layoutDraftRows = normalizedSeriesRows(item, items);
        layoutDirty = false;
        $('#save-series-layout').disabled = true;
      }

      function markLayoutDirty() {
        layoutDirty = true;
        $('#save-series-layout').disabled = false;
      }

      function renderSeriesRows(items, cover) {
        seriesPhotoGrid.innerHTML = items.map((photo, index) => collageEditorCard(photo, index, cover)).join('');
        scheduleEditorMasonry(seriesPhotoGrid);
        updateLayoutToolbar();
      }

      function renderSeries() {
        const ordered = orderedSeries();
        const activeItem = ordered.find((item) => item.slug === activeSeriesSlug);
        if (activeSeriesSlug && !activeItem) {
          activeSeriesSlug = '';
          sessionStorage.removeItem('editorSeriesSlug');
        }

        seriesListView.hidden = Boolean(activeItem);
        seriesDetailView.hidden = !activeItem;
        newSeriesButton.hidden = Boolean(activeItem);
        $('#visible-count').textContent = String(ordered.length);
        $('#featured-count').textContent = String(ordered.filter((item) => seriesCover(item)).length);
        $('#total-count').textContent = String(photoData.length);
        $('#visible-label').textContent = '影集数量';
        $('#featured-label').textContent = '已有封面';
        $('#total-label').textContent = '照片总数';

        if (!activeItem) {
          layoutToolbar.hidden = true;
          $('#view-title').textContent = `Series · ${ordered.length} 本影集`;
          seriesEditorGrid.innerHTML = ordered.map((item, index) => {
            const items = photosForSeries(item.slug);
            const cover = seriesCover(item, items);
            return `
              <article class="series-editor-card" data-slug="${escapeHtml(item.slug)}">
                <button class="series-editor-card__open" type="button" data-series-action="open" aria-label="管理 ${escapeHtml(item.title)}">
                  <span class="series-editor-card__cover ${cover ? '' : 'is-empty'}">
                    ${cover ? `<img src="${escapeHtml(cover)}" alt="" loading="lazy" />` : '<span>Empty series</span>'}
                  </span>
                  <span class="series-editor-card__body">
                    <span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.year || '未填写年份')}</small></span>
                    <span>${items.length} photos</span>
                  </span>
                </button>
                <div class="series-editor-card__order" aria-label="Series 管理">
                  <button type="button" data-series-action="edit" aria-label="编辑 ${escapeHtml(item.title)}">Edit</button>
                  <button class="is-danger" type="button" data-series-action="delete" aria-label="删除 ${escapeHtml(item.title)}">Delete</button>
                  <button type="button" data-series-action="up" aria-label="向前移动" ${index === 0 ? 'disabled' : ''}>↑</button>
                  <button type="button" data-series-action="down" aria-label="向后移动" ${index === ordered.length - 1 ? 'disabled' : ''}>↓</button>
                </div>
              </article>`;
          }).join('');
          return;
        }

        const items = photosForSeries(activeItem.slug);
        const cover = seriesCover(activeItem, items);
        layoutToolbar.hidden = false;
        $('#view-title').textContent = `${activeItem.title} · Series manager`;
        $('#series-manager-title').textContent = activeItem.title;
        $('#series-manager-meta').textContent = `${activeItem.year || '未填写年份'} · ${items.length} photographs · ${activeItem.slug}`;
        $('#series-photo-empty').hidden = items.length > 0;
        seriesPhotoGrid.hidden = items.length === 0;
        $('#add-portrait-row').disabled = !items.some((photo) => photo.orientation === 'portrait');
        $('#add-landscape-row').disabled = !items.some((photo) => photo.orientation !== 'portrait');
        if (items.length) renderSeriesRows(items, cover);
      }

      function renderPortfolioRows(status, category) {
        const items = portfolioItems(status, category, true);
        const rows = buildOrientationRows(items);
        let displayIndex = 0;
        return rows.map((row, rowIndex) => {
          const rowStart = displayIndex;
          displayIndex += row.items.length;
          return `
            <section class="editor-row-wrap" data-category-row-index="${rowIndex}" data-portfolio-row-status="${status}">
              <header class="category-row-controls">
                <span>${row.items.length} images · row ${rowIndex + 1}</span>
                <div>
                  ${[1, 2, 3, 4].map((count) => `<button type="button" data-category-row-action="set-${count}" ${row.items.length === count ? 'disabled' : ''} aria-label="Set row to ${count} images">${count}</button>`).join('')}
                </div>
              </header>
              <div class="editor-row portfolio-row" data-portfolio-row-grid="${status}" style="--category-row-columns:${row.items.length}">
                ${row.items.map((photo, index) => collageEditorCard(photo, rowStart + index, '', status)).join('')}
              </div>
            </section>`;
        }).join('');
      }

      function renderPortfolioSections() {
        const category = viewFilter.value;
        const title = viewFilter.options[viewFilter.selectedIndex]?.textContent || category;
        const usesRows = portfolioUsesRows(category);
        const sections = ['selected', 'archive'].map((status) => {
          const items = portfolioItems(status, category, true);
          const isSelected = status === 'selected';
          const label = isSelected ? 'Selected Portfolio' : 'Archive';
          const action = isSelected ? 'archive' : 'selected';
          const actionLabel = isSelected ? 'Move selected photos to archive' : 'Add selected photos to portfolio';
          const recommendation = items.length < 18
            ? `Recommended: 18–24 photographs · ${18 - items.length} below suggestion`
            : items.length > 24
              ? `Recommended: 18–24 photographs · ${items.length - 24} above suggestion`
              : 'Recommended: 18–24 photographs';
          return `
            <section class="portfolio-section" data-portfolio-section="${status}">
              <header class="portfolio-section__head">
                <div>
                  <p class="eyebrow">${escapeHtml(title)}</p>
                  <h2>${label} <span>— ${items.length} photographs</span></h2>
                  ${isSelected ? `<p class="portfolio-section__recommendation">${recommendation}</p>` : ''}
                </div>
                <div class="portfolio-section__actions">
                  ${isSelected ? `<button class="button button--quiet" type="button" data-category-layout-mode="${usesRows ? 'collage' : 'rows'}">${usesRows ? 'Use collage' : 'Use rows'}</button>` : ''}
                  <label class="portfolio-select-all"><input type="checkbox" data-portfolio-select-all="${status}" /> Select all</label>
                  <button class="button" type="button" data-portfolio-batch="${action}" data-portfolio-status="${status}" ${items.length ? '' : 'disabled'}>${actionLabel}</button>
                </div>
              </header>
              ${isSelected && usesRows
                ? renderPortfolioRows(status, category)
                : `<div class="photo-grid photo-grid--collage portfolio-photo-grid" data-portfolio-grid="${status}" aria-label="${label}">
                    ${items.map((photo, index) => collageEditorCard(photo, index, '', status)).join('')}
                  </div>`}
            </section>`;
        }).join('');
        categorySections.innerHTML = `${category === 'portrait' ? portraitCategoryCoverPanel() : ''}${sections}`;
        categorySections.querySelectorAll('.portfolio-photo-grid').forEach((container) => scheduleEditorMasonry(container));
      }

      const portraitPresetCapacity = {
        HERO: 1,
        DIPTYCH: 2,
        TRIPTYCH: 3,
        FEATURE: 3,
        FULL: 1,
        TEXT: 0,
        SPACER: 0,
      };

      function portraitSelectedPhotos() {
        return sortPortfolioPhotos(
          photoData.filter((photo) => photo.category === 'portrait' && getPortfolioStatus(photo, 'portrait') === 'selected'),
          'selected',
        );
      }

      function portraitBookPhotos() {
        const portraits = photoData.filter((photo) => photo.category === 'portrait');
        const selected = sortPortfolioPhotos(
          portraits.filter((photo) => getPortfolioStatus(photo, 'portrait') === 'selected'),
          'selected',
        );
        const archive = sortPortfolioPhotos(
          portraits.filter((photo) => getPortfolioStatus(photo, 'portrait') === 'archive'),
          'archive',
        );
        return [...selected, ...archive];
      }

      function portraitCategoryEntry() {
        return portfolioCategoriesData.find((entry) => entry.id === 'portrait');
      }

      function portraitCategoryCoverImages() {
        const entry = portraitCategoryEntry();
        const images = Array.isArray(entry?.coverImages) ? entry.coverImages.filter(Boolean).slice(0, 3) : [];
        if (images.length === 3) return images;
        return entry?.coverImage ? [entry.coverImage] : [];
      }

      function normalizePortraitCategoryCoverPosition(value) {
        const keyword = { left: 0, center: 50, right: 100, top: 0, bottom: 100 };
        const parts = String(value || 'center center').trim().split(/\s+/).slice(0, 2);
        const numberFor = (part, fallback) => {
          if (part in keyword) return keyword[part];
          const parsed = Number.parseFloat(part);
          return Number.isFinite(parsed) ? Math.min(100, Math.max(0, parsed)) : fallback;
        };
        const x = numberFor(parts[0], 50);
        const y = numberFor(parts[1], 50);
        return { x, y, value: `${Number(x.toFixed(1))}% ${Number(y.toFixed(1))}%` };
      }

      function portraitCategoryCoverPositions() {
        const entry = portraitCategoryEntry();
        const positions = Array.isArray(entry?.coverPositions) ? entry.coverPositions.slice(0, 3) : [];
        return [0, 1, 2].map((index) => normalizePortraitCategoryCoverPosition(positions[index]).value);
      }

      function portraitCategoryCoverPanel() {
        const images = portraitCategoryCoverImages();
        const positions = portraitCategoryCoverPositions();
        const photosByImage = new Map(portraitBookPhotos().map((photo) => [photo.image, photo]));
        return `
          <section class="portrait-category-cover-panel">
            <div>
              <p class="eyebrow">Portfolio entrance</p>
              <h2>Portrait covers</h2>
              <p>Choose three vertical photographs, then drag each preview to adjust its visible area.</p>
            </div>
            <div class="portrait-category-cover-panel__images">
              ${images.map((image, index) => {
                const photo = photosByImage.get(image);
                const label = ['Left', 'Center', 'Right'][index];
                return photo ? `<span
                  data-portrait-category-cover-position="${index}"
                  style="--cover-position: ${positions[index]};"
                  aria-label="Drag to reposition ${label.toLowerCase()} Portrait cover"
                ><b>${label}</b>${editorThumbnailMarkup(photo, `${label} Portrait cover`)}<em>Drag to reposition</em></span>` : '';
              }).join('')}
            </div>
            <button class="button" type="button" data-open-portrait-category-covers>Choose three covers</button>
          </section>`;
      }

      function renderPortraitCategoryCoverPicker(query = '') {
        const normalizedQuery = query.trim().toLowerCase();
        const photos = portraitBookPhotos();
        const filteredPhotos = photos.filter((photo) => {
          if (!normalizedQuery) return true;
          const filename = (photo.image.split('/').pop() || '').replace(/\.[^.]+$/, '');
          return [photo.title, photo.id, filename, photo.image]
            .filter(Boolean)
            .some((value) => String(value).toLowerCase().includes(normalizedQuery));
        });
        $('#portrait-category-cover-grid').innerHTML = filteredPhotos.length
          ? filteredPhotos.map((photo) => {
              const selectionIndex = portraitCategoryCoverSelection.indexOf(photo.image);
              const isSelected = selectionIndex >= 0;
              return `
                <button
                  class="portrait-book-cover-option ${isSelected ? 'is-selected' : ''}"
                  type="button"
                  role="option"
                  aria-selected="${isSelected}"
                  data-portrait-category-cover="${escapeHtml(photo.image)}"
                >
                  <span class="portrait-book-cover-option__image">
                    ${editorThumbnailMarkup(photo)}
                    <span class="portrait-book-cover-option__check" aria-hidden="true">${isSelected ? selectionIndex + 1 : ''}</span>
                  </span>
                  <small>${escapeHtml(portraitBookCoverLabel(photo))}</small>
                </button>`;
            }).join('')
          : '<p class="portrait-book-cover-empty">No matching Portrait photographs.</p>';
        $('#portrait-category-cover-count').textContent = `${portraitCategoryCoverSelection.length} / 3 selected`;
        $('#portrait-category-cover-selection').textContent = portraitCategoryCoverSelection.length === 0
          ? 'Choose left cover first'
          : portraitCategoryCoverSelection.length === 1
            ? 'Now choose the center cover'
            : portraitCategoryCoverSelection.length === 2
              ? 'Now choose the right cover'
              : 'Left, center, and right covers ready';
        $('#save-portrait-category-covers').disabled = portraitCategoryCoverSelection.length !== 3;
      }

      function openPortraitCategoryCoverDialog() {
        portraitCategoryCoverSelection = portraitCategoryCoverImages();
        $('#portrait-category-cover-search').value = '';
        renderPortraitCategoryCoverPicker();
        portraitCategoryCoverDialog.showModal();
      }

      async function persistPortraitCategoryCovers(coverImages, coverPositions) {
        const response = await fetch('/__editor/portfolio-categories/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: 'portrait', coverImages, coverPositions }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Portfolio cover save failed.');
        portfolioCategoriesData = portfolioCategoriesData.map((entry) => entry.id === 'portrait' ? result.entry : entry);
        return result.entry;
      }

      async function savePortraitCategoryCovers() {
        if (portraitCategoryCoverSelection.length !== 3) return;
        const button = $('#save-portrait-category-covers');
        button.disabled = true;
        button.textContent = 'Saving…';
        try {
          await persistPortraitCategoryCovers(portraitCategoryCoverSelection, ['50% 50%', '50% 50%', '50% 50%']);
          portraitCategoryCoverDialog.close('saved');
          renderPortfolioSections();
          showToast('Portrait 首页三张封面已保存');
        } catch (error) {
          window.alert(`保存失败：${error.message}`);
        } finally {
          button.textContent = 'Save three covers';
          button.disabled = portraitCategoryCoverSelection.length !== 3;
        }
      }

      function orderedPortraitBooks() {
        return [...portraitBooksData.books].sort((a, b) => Number(a.order) - Number(b.order));
      }

      function activePortraitBook() {
        return portraitBooksData.books.find((book) => book.slug === activePortraitBookSlug);
      }

      function portraitGroupById(groupId) {
        return activePortraitBook()?.layout.groups.find((group) => group.id === groupId);
      }

      function nextPortraitGroupId() {
        const groups = activePortraitBook()?.layout.groups || [];
        let index = groups.length + 1;
        let id = `portrait-group-${index}`;
        const ids = new Set(groups.map((group) => group.id));
        while (ids.has(id)) id = `portrait-group-${++index}`;
        return id;
      }

      function portraitEditorPhotoMarkup(item) {
        const photo = item.photo;
        if (!photo) return '';
        return `
          <article class="portrait-layout-photo" data-portrait-photo-id="${escapeHtml(photo.id)}">
            ${editorThumbnailMarkup(photo, photo.alt || '')}
            <div>
              <span><strong>${escapeHtml(photo.title || photo.id)}</strong><small>${escapeHtml(photo.id)}</small></span>
              <label><input type="checkbox" data-portrait-cover ${item.cover ? 'checked' : ''} /> Cover</label>
              <button type="button" data-portrait-action="remove-photo">Remove</button>
            </div>
          </article>`;
      }

      function portraitEditorPageMarkup(page, group) {
        if (page.blank) {
          return `<article class="portrait-layout-page portrait-layout-page--${page.side} is-blank"><span>Blank ${page.side} page</span></article>`;
        }
        if (page.kind.startsWith('text')) {
          const showTitle = page.kind !== 'text-body';
          const showText = page.kind !== 'text-title';
          return `
            <article class="portrait-layout-page portrait-layout-page--${page.side}">
              <div class="portrait-layout-page__text">
                ${showTitle && group.title ? `<strong>${escapeHtml(group.title)}</strong>` : ''}
                ${showText && group.text ? `<p>${escapeHtml(group.text)}</p>` : ''}
              </div>
            </article>`;
        }
        return `
          <article class="portrait-layout-page portrait-layout-page--${page.side}">
            ${page.items.length ? `<div class="portrait-layout-page__media has-${page.items.length}">${page.items.map(portraitEditorPhotoMarkup).join('')}</div>` : '<span class="portrait-layout-page__paper">Open page</span>'}
          </article>`;
      }

      function renderPortraitLayout(book) {
        if (!book) return;
        const portraits = portraitBookPhotos();
        const photosById = new Map(portraits.map((photo) => [photo.id, photo]));
        const assignedIds = new Set(book.layout.groups.flatMap((group) => group.items.map((item) => item.photoId)));
        const available = portraits.filter((photo) => !assignedIds.has(photo.id));

        $('#view-title').textContent = `${book.title} · Edit Book`;
        $('#visible-count').textContent = String(book.layout.groups.length);
        $('#featured-count').textContent = String(assignedIds.size);
        $('#total-count').textContent = String(portraits.length);
        $('#visible-label').textContent = '跨页';
        $('#featured-label').textContent = '已排版照片';
        $('#total-label').textContent = 'Selected + Archive';
        $('#portrait-book-title').textContent = book.title;
        $('#portrait-book-meta').textContent = [book.year, `${book.layout.groups.length} spreads`, book.slug].filter(Boolean).join(' · ');

        portraitLayoutGroups.innerHTML = book.layout.groups.length
          ? book.layout.groups.map((group, index) => {
              const capacity = portraitPresetCapacity[group.preset] ?? 1;
              const acceptsPhotos = capacity > 0;
              const hydratedItems = group.items
                .map((item) => ({ ...item, photo: photosById.get(item.photoId) }))
                .filter((item) => item.photo);
              const pages = resolvePortraitSpread({ ...group, items: hydratedItems }, index);
              return `
                <article class="portrait-layout-group" data-portrait-group-id="${escapeHtml(group.id)}">
                  <header class="portrait-layout-group__head">
                    <button class="portrait-layout-group__drag" type="button" data-portrait-drag-handle aria-label="Drag ${escapeHtml(group.title || group.id)} spread">⋮⋮</button>
                    <div>
                      <span>Spread ${String(index + 1).padStart(2, '0')}</span>
                      <strong>${escapeHtml(group.id)}</strong>
                    </div>
                    <label>Preset
                      <select data-portrait-field="preset">
                        ${PORTRAIT_LAYOUT_PRESETS.map((preset) => `<option value="${preset}" ${preset === group.preset ? 'selected' : ''}>${preset}</option>`).join('')}
                      </select>
                    </label>
                    <div class="portrait-layout-group__order">
                      <button type="button" data-portrait-action="up" ${index === 0 ? 'disabled' : ''} aria-label="Move spread up">↑</button>
                      <button type="button" data-portrait-action="down" ${index === book.layout.groups.length - 1 ? 'disabled' : ''} aria-label="Move spread down">↓</button>
                      <button class="is-danger" type="button" data-portrait-action="delete">Delete</button>
                    </div>
                  </header>
                  <div class="portrait-layout-group__fields">
                    <label>Spread title<input data-portrait-field="title" value="${escapeHtml(group.title)}" maxlength="120" /></label>
                    <label>Short text<textarea data-portrait-field="text" rows="2" maxlength="500">${escapeHtml(group.text)}</textarea></label>
                  </div>
                  <div class="portrait-layout-page-controls">
                    <label><input type="checkbox" data-portrait-field="leftBlank" ${group.leftBlank ? 'checked' : ''} /> Left page · Blank</label>
                    <label><input type="checkbox" data-portrait-field="rightBlank" ${group.rightBlank ? 'checked' : ''} /> Right page · Blank</label>
                  </div>
                  <div class="portrait-layout-spread-preview portrait-layout-spread-preview--${group.preset.toLowerCase()}">
                    ${portraitEditorPageMarkup(pages.left, group)}
                    <div class="portrait-layout-spine" aria-hidden="true"></div>
                    ${portraitEditorPageMarkup(pages.right, group)}
                    ${pages.spanItems.length ? `<div class="portrait-layout-full-spread">${pages.spanItems.map(portraitEditorPhotoMarkup).join('')}</div>` : ''}
                  </div>
                  ${acceptsPhotos ? `
                    <div class="portrait-layout-group__add">
                      <p class="portrait-layout-add-status">${group.items.length >= capacity ? 'This spread has reached its preset capacity.' : `${available.length} Selected + Archive photographs available.`}</p>
                      <button class="button" type="button" data-portrait-action="open-photo-picker" ${group.items.length >= capacity || !available.length ? 'disabled' : ''}>Choose photo · ${group.items.length}/${capacity}</button>
                    </div>` : ''}
                </article>`;
            }).join('')
          : '<div class="portrait-layout-empty"><p>No portrait spreads yet.</p><span>Create a spread to begin the book sequence.</span></div>';
      }

      function renderPortraitBooks() {
        const books = orderedPortraitBooks();
        let activeBook = activePortraitBook();
        if (activePortraitBookSlug && !activeBook) {
          activePortraitBookSlug = '';
          sessionStorage.removeItem('editorPortraitBookSlug');
        }
        activeBook = activePortraitBook();
        portraitBooksListView.hidden = Boolean(activeBook);
        portraitBookDetailView.hidden = !activeBook;
        $('#open-file').textContent = '打开 portrait-books.json';
        $('#undo').disabled = portraitBooksHistory.length === 0;
        setPortraitBooksDirty(portraitBooksDirty);

        if (activeBook) {
          renderPortraitLayout(activeBook);
          return;
        }

        const assigned = new Set(books.flatMap((book) => book.layout.groups.flatMap((group) => group.items.map((item) => item.photoId))));
        $('#view-title').textContent = `Portrait Books · ${books.length} books`;
        $('#visible-count').textContent = String(books.length);
        $('#featured-count').textContent = String(books.filter((book) => book.coverImage).length);
        $('#total-count').textContent = String(assigned.size);
        $('#visible-label').textContent = '书籍数量';
        $('#featured-label').textContent = '已有书封';
        $('#total-label').textContent = '已引用照片';
        portraitBooksGrid.innerHTML = books.length ? books.map((book, index) => `
          <article class="series-editor-card" data-portrait-book-slug="${escapeHtml(book.slug)}">
            <button class="series-editor-card__open" type="button" data-portrait-book-action="open" aria-label="Edit ${escapeHtml(book.title)}">
              <span class="series-editor-card__cover ${book.coverImage ? '' : 'is-empty'}">
                ${book.coverImage ? `<img src="${escapeHtml(book.coverImage)}" alt="" loading="lazy" />` : '<span>No book cover</span>'}
              </span>
              <span class="series-editor-card__body">
                <span><strong>${escapeHtml(book.title)}</strong><small>${escapeHtml(book.year || 'Year not set')}</small></span>
                <span>${book.layout.groups.length} spreads</span>
              </span>
            </button>
            <div class="series-editor-card__order" aria-label="Portrait book management">
              <button type="button" data-portrait-book-action="edit">Edit</button>
              <button class="is-danger" type="button" data-portrait-book-action="delete">Delete</button>
              <button type="button" data-portrait-book-action="up" ${index === 0 ? 'disabled' : ''} aria-label="Move book up">↑</button>
              <button type="button" data-portrait-book-action="down" ${index === books.length - 1 ? 'disabled' : ''} aria-label="Move book down">↓</button>
            </div>
          </article>`).join('') : '<div class="portrait-layout-empty"><p>No portrait books yet.</p><span>Create a book to begin the shelf.</span></div>';
      }

      function updatePortraitGroup(groupId, update, message = 'Portrait Book 有未保存修改') {
        const book = activePortraitBook();
        const group = portraitGroupById(groupId);
        if (!book || !group) return;
        snapshotPortraitBooks();
        update(group);
        book.layout = normalizePortraitLayout(book.layout);
        setPortraitBooksDirty(true, message);
        renderPortraitLayout(book);
      }

      function movePortraitGroup(groupId, direction) {
        const book = activePortraitBook();
        if (!book) return;
        const index = book.layout.groups.findIndex((group) => group.id === groupId);
        const target = index + direction;
        if (index < 0 || target < 0 || target >= book.layout.groups.length) return;
        snapshotPortraitBooks();
        [book.layout.groups[index], book.layout.groups[target]] = [book.layout.groups[target], book.layout.groups[index]];
        setPortraitBooksDirty(true, '跨页顺序已更新');
        renderPortraitLayout(book);
      }

      function reorderPortraitGroup(draggedId, targetId, placeAfter) {
        const book = activePortraitBook();
        if (!book) return;
        if (!draggedId || !targetId || draggedId === targetId) return;
        const groups = [...book.layout.groups];
        const sourceIndex = groups.findIndex((group) => group.id === draggedId);
        const targetIndex = groups.findIndex((group) => group.id === targetId);
        if (sourceIndex < 0 || targetIndex < 0) return;
        snapshotPortraitBooks();
        const [source] = groups.splice(sourceIndex, 1);
        const adjustedTarget = groups.findIndex((group) => group.id === targetId);
        groups.splice(adjustedTarget + (placeAfter ? 1 : 0), 0, source);
        book.layout.groups = groups;
        setPortraitBooksDirty(true, '跨页顺序已更新');
        renderPortraitLayout(book);
      }

      function addPortraitGroup() {
        const book = activePortraitBook();
        if (!book) return;
        snapshotPortraitBooks();
        const isOpeningSpread = book.layout.groups.length === 0;
        book.layout.groups.push({
          id: nextPortraitGroupId(),
          preset: isOpeningSpread ? 'HERO' : 'DIPTYCH',
          title: '',
          text: '',
          leftBlank: isOpeningSpread,
          rightBlank: false,
          items: [],
        });
        setPortraitBooksDirty(true, '已创建新跨页');
        renderPortraitLayout(book);
      }

      function portraitBookCoverLabel(photo) {
        const filename = (photo.image.split('/').pop() || photo.id).replace(/\.[^.]+$/, '');
        return `${photo.title || photo.id} · ${filename}`;
      }

      function portraitPhotoPickerCandidates() {
        const book = activePortraitBook();
        if (!book) return [];
        const assignedIds = new Set(book.layout.groups.flatMap((group) => group.items.map((item) => item.photoId)));
        return portraitBookPhotos().filter((photo) => !assignedIds.has(photo.id));
      }

      function updatePortraitPhotoPickerSelection(photoId = '') {
        const selectedPhoto = portraitPhotoPickerCandidates().find((photo) => photo.id === photoId);
        portraitPhotoPickerSelectionId = selectedPhoto?.id || '';
        $('#portrait-photo-picker-selection').textContent = selectedPhoto
          ? portraitBookCoverLabel(selectedPhoto)
          : 'Choose one photograph';
        $('#confirm-portrait-photo').disabled = !selectedPhoto;
        $('#portrait-photo-picker-grid').querySelectorAll('[data-portrait-photo-picker-option]').forEach((button) => {
          const isSelected = button.dataset.portraitPhotoPickerOption === portraitPhotoPickerSelectionId;
          button.classList.toggle('is-selected', isSelected);
          button.setAttribute('aria-selected', String(isSelected));
        });
      }

      function renderPortraitPhotoPicker(query = '') {
        const normalizedQuery = query.trim().toLowerCase();
        const candidates = portraitPhotoPickerCandidates();
        const filteredPhotos = candidates.filter((photo) => {
          if (!normalizedQuery) return true;
          return [photo.title, photo.id, photo.image, getPortfolioStatus(photo, 'portrait')]
            .filter(Boolean)
            .some((value) => String(value).toLowerCase().includes(normalizedQuery));
        });
        $('#portrait-photo-picker-count').textContent = normalizedQuery
          ? `${filteredPhotos.length} of ${candidates.length} photographs`
          : `${candidates.length} photographs available`;
        $('#portrait-photo-picker-grid').innerHTML = filteredPhotos.length
          ? filteredPhotos.map((photo) => {
              const label = portraitBookCoverLabel(photo);
              const status = getPortfolioStatus(photo, 'portrait');
              const isSelected = photo.id === portraitPhotoPickerSelectionId;
              return `
                <button
                  class="portrait-book-cover-option portrait-photo-picker__option ${isSelected ? 'is-selected' : ''}"
                  type="button"
                  role="option"
                  aria-label="Select ${escapeHtml(label)} from ${escapeHtml(status)}"
                  aria-selected="${isSelected}"
                  data-portrait-photo-picker-option="${escapeHtml(photo.id)}"
                >
                  <span class="portrait-book-cover-option__image">
                    ${editorThumbnailMarkup(photo)}
                    <span class="portrait-book-cover-option__check" aria-hidden="true">✓</span>
                  </span>
                  <small><span>${escapeHtml(label)}</span><em>${escapeHtml(status)}</em></small>
                </button>`;
            }).join('')
          : '<p class="portrait-book-cover-empty">No matching Portrait photographs.</p>';
        updatePortraitPhotoPickerSelection(portraitPhotoPickerSelectionId);
      }

      function openPortraitPhotoPicker(groupId) {
        const group = portraitGroupById(groupId);
        if (!group) return;
        const capacity = portraitPresetCapacity[group.preset] ?? 0;
        if (group.items.length >= capacity) return;
        portraitPhotoPickerGroupId = groupId;
        portraitPhotoPickerSelectionId = '';
        $('#portrait-photo-picker-title').textContent = `Add to spread · ${group.title || group.id}`;
        $('#portrait-photo-picker-search').value = '';
        renderPortraitPhotoPicker();
        portraitPhotoPickerDialog.showModal();
      }

      function addPortraitPhotoFromPicker() {
        const groupId = portraitPhotoPickerGroupId;
        const photoId = portraitPhotoPickerSelectionId;
        if (!groupId || !photoId) return;
        updatePortraitGroup(groupId, (group) => {
          const capacity = portraitPresetCapacity[group.preset] ?? 0;
          if (group.items.length < capacity) group.items.push({ photoId, cover: false });
        }, '照片已加入 Portrait 跨页');
        portraitPhotoPickerDialog.close('added');
      }

      function updatePortraitBookCoverSelection(selectedValue = '') {
        const photos = portraitSelectedPhotos();
        const selectedPhoto = photos.find((photo) => photo.image === selectedValue);
        const value = selectedPhoto?.image || '';
        $('#portrait-book-form-cover').value = value;
        $('#portrait-book-cover-selection').textContent = selectedPhoto
          ? portraitBookCoverLabel(selectedPhoto)
          : 'Choose a Selected Portrait';
        $('#portrait-book-cover-grid').querySelectorAll('[data-portrait-book-cover]').forEach((button) => {
          const isSelected = button.dataset.portraitBookCover === value;
          button.classList.toggle('is-selected', isSelected);
          button.setAttribute('aria-selected', String(isSelected));
        });
      }

      function renderPortraitBookCoverPicker(selectedValue = '', query = '') {
        const normalizedQuery = query.trim().toLowerCase();
        const photos = portraitSelectedPhotos();
        const filteredPhotos = photos.filter((photo) => {
          if (!normalizedQuery) return true;
          const filename = (photo.image.split('/').pop() || '').replace(/\.[^.]+$/, '');
          return [photo.title, photo.id, filename, photo.image]
            .filter(Boolean)
            .some((value) => String(value).toLowerCase().includes(normalizedQuery));
        });
        $('#portrait-book-cover-grid').innerHTML = filteredPhotos.length
          ? filteredPhotos.map((photo) => {
              const label = portraitBookCoverLabel(photo);
              const isSelected = photo.image === selectedValue;
              return `
                <button
                  class="portrait-book-cover-option ${isSelected ? 'is-selected' : ''}"
                  type="button"
                  role="option"
                  aria-label="Use ${escapeHtml(label)} as book cover"
                  aria-selected="${isSelected}"
                  data-portrait-book-cover="${escapeHtml(photo.image)}"
                >
                  <span class="portrait-book-cover-option__image">
                    ${editorThumbnailMarkup(photo)}
                    <span class="portrait-book-cover-option__check" aria-hidden="true">✓</span>
                  </span>
                  <small>${escapeHtml(label)}</small>
                </button>`;
            }).join('')
          : '<p class="portrait-book-cover-empty">No matching Portrait photographs.</p>';
        updatePortraitBookCoverSelection(selectedValue);
      }

      function openPortraitBookDialog(slug = '') {
        const book = portraitBooksData.books.find((item) => item.slug === slug);
        $('#portrait-book-dialog-title').textContent = book ? 'Edit Portrait Book' : 'New Portrait Book';
        $('#portrait-book-original-slug').value = book?.slug || '';
        $('#portrait-book-form-title').value = book?.title || '';
        $('#portrait-book-form-slug').value = book?.slug || '';
        $('#portrait-book-form-slug').readOnly = Boolean(book);
        $('#portrait-book-form-year').value = book?.year || '';
        $('#portrait-book-form-description').value = book?.description || '';
        $('#portrait-book-cover-search').value = '';
        renderPortraitBookCoverPicker(book?.coverImage || '');
        $('#portrait-book-form-error').textContent = '';
        portraitBookDialog.showModal();
      }

      function savePortraitBookDetails() {
        const originalSlug = $('#portrait-book-original-slug').value;
        const title = $('#portrait-book-form-title').value.trim();
        const slug = $('#portrait-book-form-slug').value.trim().toLowerCase();
        const year = $('#portrait-book-form-year').value.trim();
        const description = $('#portrait-book-form-description').value.trim();
        const coverImage = $('#portrait-book-form-cover').value;
        const error = $('#portrait-book-form-error');
        error.textContent = '';
        if (!title) { error.textContent = 'Book title is required.'; return; }
        if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug) || slug === 'archive') { error.textContent = 'Slug must use lowercase letters, numbers and hyphens, and cannot be archive.'; return; }
        if (!coverImage) { error.textContent = 'Choose a book cover.'; return; }
        if (!originalSlug && portraitBooksData.books.some((book) => book.slug === slug)) { error.textContent = 'This slug already exists.'; return; }

        snapshotPortraitBooks();
        if (originalSlug) {
          const book = portraitBooksData.books.find((item) => item.slug === originalSlug);
          if (!book) return;
          const previousTitle = book.title;
          Object.assign(book, { title, year, description, coverImage });
          if (!book.layout.title || book.layout.title === previousTitle) book.layout.title = title;
        } else {
          portraitBooksData.books.push({
            title,
            slug,
            year,
            description,
            coverImage,
            order: portraitBooksData.books.length + 1,
            layout: normalizePortraitLayout({
              title,
              introduction: description,
              groups: [{
                id: 'portrait-group-1',
                preset: 'HERO',
                title: '',
                text: '',
                leftBlank: true,
                rightBlank: false,
                items: [],
              }],
            }),
          });
        }
        portraitBooksData = normalizePortraitBooks(portraitBooksData);
        setPortraitBooksDirty(true, originalSlug ? '书籍资料与书封已更新' : '已创建 Portrait Book');
        portraitBookDialog.close('saved');
        renderPortraitBooks();
      }

      function movePortraitBook(slug, direction) {
        const books = orderedPortraitBooks();
        const index = books.findIndex((book) => book.slug === slug);
        const target = index + direction;
        if (index < 0 || target < 0 || target >= books.length) return;
        snapshotPortraitBooks();
        [books[index], books[target]] = [books[target], books[index]];
        books.forEach((book, orderIndex) => { book.order = orderIndex + 1; });
        portraitBooksData.books = books;
        setPortraitBooksDirty(true, 'Portrait Books 顺序已更新');
        renderPortraitBooks();
      }

      function deletePortraitBook(slug) {
        const book = portraitBooksData.books.find((item) => item.slug === slug);
        if (!book || !window.confirm(`删除 Portrait Book “${book.title}”？照片文件和 photos.json 不会被删除。`)) return;
        snapshotPortraitBooks();
        portraitBooksData.books = portraitBooksData.books.filter((item) => item.slug !== slug);
        portraitBooksData = normalizePortraitBooks(portraitBooksData);
        if (activePortraitBookSlug === slug) {
          activePortraitBookSlug = '';
          sessionStorage.removeItem('editorPortraitBookSlug');
        }
        setPortraitBooksDirty(true, 'Portrait Book 已移除，照片数据未更改');
        renderPortraitBooks();
      }

      function render() {
        const isSeriesView = viewFilter.value === 'series';
        const isPortraitLayoutView = viewFilter.value === 'portrait-layout';
        sessionStorage.setItem('editorView', viewFilter.value);
        const editorUrl = new URL(window.location.href);
        if (editorUrl.searchParams.get('view') !== viewFilter.value) {
          editorUrl.searchParams.set('view', viewFilter.value);
          window.history.replaceState(null, '', `${editorUrl.pathname}${editorUrl.search}${editorUrl.hash}`);
        }
        seriesWorkspace.hidden = !isSeriesView;
        portraitLayoutWorkspace.hidden = !isPortraitLayoutView;
        canvasViewport.hidden = isSeriesView || isPortraitLayoutView;
        categorySections.hidden = !isPortfolioView();
        $('#empty-state').hidden = true;
        $('#photo-search-field').hidden = isSeriesView || isPortraitLayoutView;
        addPhotosButton.hidden = true;
        newSeriesButton.hidden = !isSeriesView || Boolean(activeSeriesSlug);
        layoutToolbar.hidden = true;
        $('#canvas-scale').textContent = '';
        if (isPortraitLayoutView) {
          grid.hidden = true;
          renderPortraitBooks();
          return;
        }
        $('#undo').disabled = history.length === 0;
        $('#open-file').textContent = '打开 photos.json';
        setDirty(dirty);
        if (isSeriesView) {
          grid.hidden = true;
          renderSeries();
          return;
        }

        if (isPortfolioView()) {
          grid.hidden = true;
          renderPortfolioSections();
          layoutToolbar.hidden = false;
          updateLayoutToolbar();
          $('#visible-count').textContent = String(photoData.filter((photo) => photo.category === viewFilter.value).length);
          $('#featured-count').textContent = String(photoData.filter((photo) => photo.featured).length);
          $('#total-count').textContent = String(photoData.length);
          $('#view-title').textContent = `${viewFilter.options[viewFilter.selectedIndex]?.textContent || viewFilter.value} · Portfolio status`;
          addPhotosButton.hidden = false;
          addPhotosLabel.textContent = `添加到 ${viewFilter.options[viewFilter.selectedIndex]?.textContent || viewFilter.value}`;
          window.requestAnimationFrame(syncCanvasScale);
          return;
        }

        const visible = getVisiblePhotos();
        $('#visible-label').textContent = '当前显示';
        $('#featured-label').textContent = '首页精选';
        $('#total-label').textContent = '照片总数';
        const layoutScope = getLayoutScope();
        const isFreeLayout = layoutScope === 'home';
        const isCollageLayout = photoCategories.includes(viewFilter.value);
        const displayPhotos = isCollageLayout ? sortPhotosByOrder(visible) : visible;
        const filterLabel = viewFilter.options[viewFilter.selectedIndex]?.textContent || '';
        const importCategory = photoCategories.includes(viewFilter.value) ? viewFilter.value : null;
        $('#view-title').textContent = isCollageLayout
          ? `${filterLabel} · 12-column collage`
          : isFreeLayout ? `${filterLabel} · 首页独立排版` : `${filterLabel} · 数据总览`;
        addPhotosButton.hidden = !importCategory;
        newSeriesButton.hidden = true;
        if (importCategory && !addPhotosButton.disabled) addPhotosLabel.textContent = `添加到 ${filterLabel}`;
        $('#visible-count').textContent = String(visible.length);
        $('#featured-count').textContent = String(photoData.filter((photo) => photo.featured).length);
        $('#total-count').textContent = String(photoData.length);
        $('#empty-state').hidden = visible.length > 0;
        grid.hidden = visible.length === 0;
        grid.dataset.view = viewFilter.value;
        grid.classList.remove('photo-grid--rows');
        grid.classList.toggle('photo-grid--collage', isCollageLayout);

        if (isCollageLayout) {
          grid.innerHTML = displayPhotos.map((photo, index) => collageEditorCard(photo, index)).join('');
          updateLayoutToolbar();
          scheduleEditorMasonry(grid);
          window.requestAnimationFrame(syncCanvasScale);
          return;
        }

        let featuredPosition = 0;
        const cards = displayPhotos.map((photo, index) => {
          const layoutWidth = isFreeLayout ? getLayoutWidth(photo, layoutScope) : 100;
          const offsetX = isFreeLayout ? getLayoutOffset(photo, 'x', layoutScope) : 0;
          const offsetY = isFreeLayout ? getLayoutOffset(photo, 'y', layoutScope) : 0;
          if (photo.featured) featuredPosition += 1;
          const publishBadge = viewFilter.value === 'featured' && featuredPosition > 12
            ? '<span class="card-badge card-badge--muted">首页不展示</span>'
            : `<span class="card-badge">${String(index + 1).padStart(2, '0')}</span>`;
          const layoutControls = isFreeLayout ? `
                <button class="position-control ${offsetX || offsetY ? 'is-active' : ''}" type="button" data-action="reset-position" aria-label="位置归零，当前水平 ${offsetX}%，垂直 ${offsetY}%" title="点击恢复原位">⌖ ${offsetX}, ${offsetY}</button>
                <button class="size-control" type="button" data-action="size" aria-label="切换照片尺寸，当前 ${layoutWidth}%" title="点击切换尺寸">↔ ${layoutWidth}%</button>
                <button class="resize-handle" type="button" data-action="resize" aria-label="拖动以等比缩放照片" title="拖动以等比缩放"></button>` : '';
          const orderControls = `<div class="move-actions">
                  <button type="button" data-action="up" aria-label="向前移动">↑</button>
                  <button type="button" data-action="down" aria-label="向后移动">↓</button>
                </div>`;
          return `
            <article class="editor-card editor-card--${escapeHtml(photo.orientation)}" data-id="${escapeHtml(photo.id)}" style="--card-width: ${layoutWidth}%; --offset-x: ${offsetX}%; --offset-y: ${offsetY}%">
              <div class="editor-card__image">
                <img src="${escapeHtml(photo.image)}" alt="${escapeHtml(photo.alt)}" loading="lazy" />
                ${publishBadge}
                <button class="favorite ${photo.featured ? 'is-active' : ''}" type="button" data-action="featured" aria-label="${photo.featured ? '取消首页精选' : '加入首页精选'}" title="首页精选">★</button>
                <button class="delete-control" type="button" data-action="delete" aria-label="删除照片" title="从网站中删除">×</button>
                ${layoutControls}
                ${orderControls}
              </div>
              <button class="editor-card__meta" type="button" data-action="edit">
                <span><strong>${escapeHtml(photo.title || photo.id)}</strong>${escapeHtml(photo.location || '未填写地点')}</span>
                <span>${photo.orientation === 'portrait' ? '竖图' : '横图'} · 编辑</span>
              </button>
            </article>`;
        });
        grid.innerHTML = cards.join('');
        window.requestAnimationFrame(syncCanvasScale);
      }

      function replaceVisibleOrder(orderedIds) {
        const idSet = new Set(orderedIds);
        let cursor = 0;
        photoData = photoData.map((photo) => {
          if (!idSet.has(photo.id)) return photo;
          const nextId = orderedIds[cursor++];
          return photoData.find((item) => item.id === nextId);
        });
      }

      function movePhoto(id, direction) {
        if (isPortfolioView()) {
          const photo = photoData.find((item) => item.id === id);
          const status = getPortfolioStatus(photo, viewFilter.value);
          const items = portfolioItems(status);
          const index = items.findIndex((item) => item.id === id);
          const nextIndex = index + direction;
          if (!photo || !status || index < 0 || nextIndex < 0 || nextIndex >= items.length) return;
          reorderPortfolioPhotos(status, id, items[nextIndex].id, direction > 0);
          return;
        }
        if (!isCollageContext()) {
          const visible = getVisiblePhotos();
          const index = visible.findIndex((photo) => photo.id === id);
          const nextIndex = index + direction;
          if (index < 0 || nextIndex < 0 || nextIndex >= visible.length) return;
          snapshot();
          const ids = visible.map((photo) => photo.id);
          [ids[index], ids[nextIndex]] = [ids[nextIndex], ids[index]];
          replaceVisibleOrder(ids);
          setDirty(true);
          render();
          return;
        }

        const orderedPhotos = currentCollagePhotos();
        const index = orderedPhotos.findIndex((photo) => photo.id === id);
        const nextIndex = index + direction;
        if (index < 0 || nextIndex < 0 || nextIndex >= orderedPhotos.length) return;
        snapshot();
        const ids = orderedPhotos.map((photo) => photo.id);
        [ids[index], ids[nextIndex]] = [ids[nextIndex], ids[index]];
        const orderById = new Map(ids.map((photoId, orderIndex) => [photoId, orderIndex + 1]));
        photoData.forEach((photo) => {
          if (orderById.has(photo.id)) photo.order = orderById.get(photo.id);
        });
        selectedLayoutPhotoId = id;
        setDirty(true);
        render();
        showToast(direction < 0 ? '已与前一张交换顺序' : '已与后一张交换顺序');
      }

      function updateInspectorCropControls() {
        const crop = $('#form-crop').checked;
        $('#form-row-span').disabled = !crop;
        $('#form-fit').disabled = !crop;
        $('#form-focal-x').disabled = !crop;
        $('#form-focal-y').disabled = !crop;
        $('#form-row-span-field').classList.toggle('is-disabled', !crop);
      }

      function updateHomeIntroControl(photo) {
        const control = $('#home-intro-control');
        const status = $('#home-intro-status');
        const isLandscape = photo?.orientation === 'landscape';
        control.hidden = !isLandscape;
        if (!isLandscape) return;

        const positions = (siteData.homeIntroImages || [])
          .map((image, index) => image === photo.image ? index + 1 : 0)
          .filter(Boolean);
        status.textContent = positions.length
          ? `当前位于首页第 ${positions.join('、')} 张`
          : '这张横图尚未设为首页封面';
      }

      function openHomeIntroDialog() {
        const photo = photoData.find((item) => item.id === $('#form-original-id').value);
        if (!photo || photo.orientation !== 'landscape') {
          window.alert('首页封面只允许选择横图。');
          return;
        }

        const images = Array.isArray(siteData.homeIntroImages) ? siteData.homeIntroImages : [];
        $('#home-intro-slots').innerHTML = Array.from({ length: 6 }, (_, index) => {
          const image = images[index] || '';
          return `
            <button class="home-intro-slot" type="button" data-intro-slot="${index}">
              <span>第 ${index + 1} 张</span>
              ${image ? `<img src="${escapeHtml(image)}" alt="" />` : '<i>空</i>'}
            </button>`;
        }).join('');
        $('#home-intro-dialog').dataset.photoId = photo.id;
        $('#home-intro-dialog').showModal();
      }

      function setHomeIntroSlot(slot) {
        const dialog = $('#home-intro-dialog');
        const photo = photoData.find((item) => item.id === dialog.dataset.photoId);
        if (!photo || photo.orientation !== 'landscape' || slot < 0 || slot > 5) return;

        const images = Array.isArray(siteData.homeIntroImages) ? [...siteData.homeIntroImages] : [];
        while (images.length < 6) images.push('');
        const previousSlot = images.indexOf(photo.image);
        const replacedImage = images[slot];
        images[slot] = photo.image;
        if (previousSlot >= 0 && previousSlot !== slot) images[previousSlot] = replacedImage;
        siteData.homeIntroImages = images.slice(0, 6);
        siteDirty = true;
        setDirty(true, `首页第 ${slot + 1} 张封面已更新，尚未保存`);
        dialog.close();
        updateHomeIntroControl(photo);
        showToast(`已设为首页第 ${slot + 1} 张封面，点击保存后生效`);
      }

      function openInspector(id) {
        const photo = photoData.find((item) => item.id === id);
        if (!photo) return;
        const layoutScope = getLayoutScope();
        const layoutLocked = !layoutScope;
        const collageMode = isCollageContext();
        const collageLayout = normalizeCollageLayout(photo);
        inspector.dataset.layoutScope = layoutScope || '';
        inspector.dataset.collageMode = collageMode ? 'true' : 'false';
        $('#form-original-id').value = photo.id;
        $('#form-id').value = photo.id;
        $('#form-title').value = photo.title || '';
        $('#form-category').value = photo.category;
        $('#form-orientation').value = photo.orientation;
        $('#form-layout-width').value = String(getLayoutWidth(photo, layoutScope));
        $('#form-detail-scale').value = String(Number.isFinite(Number(photo.detailScale)) ? Math.min(140, Math.max(60, Math.round(Number(photo.detailScale)))) : 100);
        $('#form-offset-x').value = String(getLayoutOffset(photo, 'x', layoutScope));
        $('#form-offset-y').value = String(getLayoutOffset(photo, 'y', layoutScope));
        $('#legacy-layout-fields').hidden = collageMode || layoutLocked;
        $('#collage-layout-fields').hidden = !collageMode;
        $('#form-col-span').value = String(collageLayout.colSpan);
        $('#form-crop').checked = collageLayout.crop;
        $('#form-row-span').value = String(collageLayout.rowSpan);
        $('#form-fit').value = collageLayout.fit;
        $('#form-focal-x').value = String(collageLayout.focalX);
        $('#form-focal-y').value = String(collageLayout.focalY);
        updateInspectorCropControls();
        $('#form-layout-width').disabled = layoutLocked;
        $('#form-offset-x').disabled = layoutLocked;
        $('#form-offset-y').disabled = layoutLocked;
        $('#form-location').value = photo.location || '';
        $('#form-date').value = photo.date || '';
        $('#form-series').value = photo.series || '';
        $('#form-image').value = photo.image;
        $('#form-home-title').value = photo.homeTitle || '';
        $('#form-home-caption').value = photo.homeCaption || '';
        $('#form-alt').value = photo.alt || '';
        $('#form-featured').checked = Boolean(photo.featured);
        $('#form-preview').src = photo.image;
        $('#form-preview').alt = photo.alt || '';
        updateHomeIntroControl(photo);
        formError.textContent = '';
        inspector.showModal();
      }

      function applyInspector() {
        const form = $('#photo-form');
        if (!form.reportValidity()) return;
        const oldId = $('#form-original-id').value;
        const newId = $('#form-id').value.trim();
        if (photoData.some((photo) => photo.id === newId && photo.id !== oldId)) {
          formError.textContent = `ID “${newId}” 已被另一张照片使用。`;
          return;
        }
        const index = photoData.findIndex((photo) => photo.id === oldId);
        if (index < 0) return;
        const previousCategory = photoData[index].category;
        const layoutScope = inspector.dataset.layoutScope || null;
        snapshot();
        photoData[index] = {
          ...photoData[index],
          id: newId,
          title: $('#form-title').value.trim(),
          category: $('#form-category').value,
          series: $('#form-series').value.trim(),
          location: $('#form-location').value.trim(),
          date: $('#form-date').value.trim(),
          image: $('#form-image').value.trim(),
          featured: $('#form-featured').checked,
          orientation: $('#form-orientation').value,
          detailScale: Math.min(140, Math.max(60, Math.round(Number($('#form-detail-scale').value) || 100))),
          homeTitle: $('#form-home-title').value.trim(),
          homeCaption: $('#form-home-caption').value.trim(),
          alt: $('#form-alt').value.trim(),
        };
        if (!photoData[index].homeTitle) delete photoData[index].homeTitle;
        if (!photoData[index].homeCaption) delete photoData[index].homeCaption;
        if (layoutScope) {
          setLayoutWidth(photoData[index], Number($('#form-layout-width').value), layoutScope);
          setLayoutOffset(photoData[index], 'x', Number($('#form-offset-x').value), layoutScope);
          setLayoutOffset(photoData[index], 'y', Number($('#form-offset-y').value), layoutScope);
        }
        if (inspector.dataset.collageMode === 'true') {
          setPhotoLayout(photoData[index], {
            colSpan: Number($('#form-col-span').value),
            crop: $('#form-crop').checked,
            rowSpan: Number($('#form-row-span').value),
            fit: $('#form-fit').value,
            focalX: Number($('#form-focal-x').value),
            focalY: Number($('#form-focal-y').value),
          });
        }
        if (photoData[index].category !== previousCategory) {
          if (photoCategories.includes(photoData[index].category)) {
            const nextCategory = photoData[index].category;
            photoData[index].portfolioStatus = 'archive';
            photoData[index].selectedOrder = null;
            photoData[index].archiveOrder = portfolioItems('archive', nextCategory).length + 1;
            normalizePortfolioOrders(previousCategory);
            normalizePortfolioOrders(nextCategory);
          } else {
            delete photoData[index].portfolioStatus;
            delete photoData[index].selectedOrder;
            delete photoData[index].archiveOrder;
            normalizePortfolioOrders(previousCategory);
          }
        }
        inspector.close();
        setDirty(true);
        render();
        showToast('照片设置已应用');
      }

      function deletePhoto(id) {
        const photo = photoData.find((item) => item.id === id);
        if (!photo) return;
        if (!window.confirm(`确定从网站中删除“${photo.title || photo.id}”吗？\n\n这会移除 photos.json 中的记录，但不会删除磁盘里的原图文件。`)) return;
        snapshot();
        photoData = photoData.filter((item) => item.id !== id);
        if (photo.category === 'portrait') {
          portraitBooksData = pruneInvalidPortraitBookItems(portraitBooksData).books;
        }
        if (inspector.open) inspector.close();
        setDirty(true, '照片已移除，保存后生效');
        render();
        showToast('照片已从网站记录中删除，可撤销');
      }

      function handlePortfolioCardAction(event) {
        const card = event.target.closest('.editor-card--portfolio');
        const button = event.target.closest('button');
        if (!card || !button) return false;
        const { id } = card.dataset;
        const portfolioAction = button.dataset.portfolioAction;
        if (portfolioAction) {
          movePortfolioPhotos([id], portfolioAction);
          return true;
        }
        const action = button.dataset.action;
        if (action === 'edit') openInspector(id);
        if (action === 'delete') deletePhoto(id);
        if (action === 'up') movePhoto(id, -1);
        if (action === 'down') movePhoto(id, 1);
        if (action === 'featured') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return true;
          snapshot();
          photo.featured = !photo.featured;
          setDirty(true);
          render();
        }
        if (action === 'fit-toggle') {
          const photo = photoData.find((item) => item.id === id);
          if (!photo) return true;
          snapshot();
          const layout = normalizeCollageLayout(photo);
          setPhotoLayout(photo, { fit: layout.fit === 'cover' ? 'contain' : 'cover', crop: true });
          setDirty(true);
          render();
          showToast(`Fit switched to ${normalizeCollageLayout(photo).fit} — click Save to write to photos.json`);
        }
        return true;
      }

      function adjustCategoryRow(rowIndex, action, status = 'selected') {
        if (!rowLayoutCategories.includes(viewFilter.value) || !portfolioUsesRows(viewFilter.value)) return;
        const visible = portfolioItems(status, viewFilter.value, true);
        const rows = buildOrientationRows(visible);
        const row = rows[rowIndex];
        if (!row || (!['increase', 'decrease'].includes(action) && !/^set-[1-4]$/.test(action))) return;
        const orientationRows = rows.filter((candidate) => candidate.orientation === row.orientation);
        const orientationIndex = rows.slice(0, rowIndex + 1).filter((candidate) => candidate.orientation === row.orientation).length - 1;
        const currentSizes = orientationRows.map((candidate) => candidate.items.length);
        const max = maxRowPhotos(row.orientation);
        const target = action.startsWith('set-')
          ? Number(action.slice(4))
          : currentSizes[orientationIndex] + (action === 'increase' ? 1 : -1);
        if (target < 1 || target > max) return;

        const orientationPhotos = visible.filter((photo) => (photo.orientation === 'portrait' ? 'portrait' : 'landscape') === row.orientation);
        const photosBeforeNextRow = currentSizes.slice(0, orientationIndex + 1).reduce((sum, size) => sum + size, 0);
        if (target > currentSizes[orientationIndex]
          && photosBeforeNextRow - currentSizes[orientationIndex] + target > orientationPhotos.length) return;

        snapshot();
        currentSizes[orientationIndex] = target;
        const nextSizes = [];
        let remaining = orientationPhotos.length;
        currentSizes.forEach((size) => {
          if (remaining <= 0) return;
          const nextSize = Math.min(max, Math.max(1, size), remaining);
          nextSizes.push(nextSize);
          remaining -= nextSize;
        });
        while (remaining > 0) {
          const nextSize = Math.min(row.orientation === 'portrait' ? 3 : 2, remaining);
          nextSizes.push(nextSize);
          remaining -= nextSize;
        }

        orientationPhotos.forEach((photo) => delete photo.categoryRowSize);
        let offset = 0;
        nextSizes.forEach((size) => {
          orientationPhotos[offset].categoryRowSize = size;
          offset += size;
        });
        setDirty(true);
        render();
        showToast(`本行已调整为 ${target} 张，点击保存写入 photos.json`);
      }

      function formatFileSize(bytes) {
        return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
      }

      function getImageDetails(file) {
        return new Promise((resolve, reject) => {
          const url = URL.createObjectURL(file);
          const image = new Image();
          image.onload = () => {
            URL.revokeObjectURL(url);
            resolve({
              orientation: image.naturalHeight > image.naturalWidth ? 'portrait' : 'landscape',
              aspect: image.naturalWidth / image.naturalHeight,
            });
          };
          image.onerror = () => {
            URL.revokeObjectURL(url);
            reject(new Error(`无法读取 ${file.name} 的图片尺寸。`));
          };
          image.src = url;
        });
      }

      async function getImageOrientation(file) {
        return (await getImageDetails(file)).orientation;
      }

      function confirmLargeFiles(files) {
        const largeFiles = files.filter((file) => file.size > maxRecommendedFileSize);
        if (!largeFiles.length) return Promise.resolve(true);
        $('#large-file-list').innerHTML = largeFiles
          .map((file) => `<li><span>${escapeHtml(file.name)}</span><strong>${formatFileSize(file.size)}</strong></li>`)
          .join('');
        largeFileWarning.showModal();
        return new Promise((resolve) => {
          largeFileWarning.addEventListener('close', () => resolve(largeFileWarning.returnValue === 'continue'), { once: true });
        });
      }

      async function importPhotos(files) {
        const category = viewFilter.value;
        if (!photoCategories.includes(category) || !files.length) return;
        if (dirty) {
          window.alert('请先保存当前照片修改，再上传新照片。');
          return;
        }

        addPhotosButton.disabled = true;
        addPhotosLabel.textContent = 'Optimizing image…';
        try {
          const metadata = await Promise.all(files.map(getImageDetails));
          const formData = new FormData();
          formData.append('category', category);
          formData.append('metadata', JSON.stringify(metadata));
          files.forEach((file) => formData.append('photos', file, file.name));

          const response = await fetch('/__editor/import-photos', { method: 'POST', body: formData });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || '本地导入接口没有响应，请通过 npm run editor 打开编辑器。');

          const archiveCount = portfolioItems('archive', category).length;
          const nextPhotoNumber = photoData
            .filter((photo) => photo.category === category)
            .reduce((highest, photo) => {
              const match = String(photo.title || '').match(/^No\.\s*(\d+)$/i);
              return Math.max(highest, match ? Number(match[1]) : 0);
            }, 0) + 1;
          const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
          const year = String(new Date().getFullYear());
          const fallbackAdditions = result.files.map((savedFile, index) => ({
            id: savedFile.id,
            title: `No. ${String(nextPhotoNumber + index).padStart(2, '0')}`,
            category,
            series: '',
            location: '',
            date: year,
            image: savedFile.image,
            featured: false,
            portfolioStatus: 'archive',
            selectedOrder: null,
            archiveOrder: archiveCount + index + 1,
            aspect: metadata[savedFile.index ?? index]?.aspect,
            orientation: metadata[savedFile.index ?? index]?.orientation,
            alt: `${categoryLabel} photograph by Bo David`,
          }));
          const additions = Array.isArray(result.photos) ? result.photos : fallbackAdditions;

          const duplicate = additions.find((photo) => photoData.some((existing) => existing.id === photo.id));
          if (duplicate) throw new Error(`照片 ID ${duplicate.id} 已存在，请检查对应图片目录。`);
          snapshot();
          if (Array.isArray(result.photoData)) photoData = migratePortfolioPhotos(result.photoData);
          else photoData.push(...additions);
          searchInput.value = '';
          setDirty(!Array.isArray(result.photoData), Array.isArray(result.photoData)
            ? `已添加 ${additions.length} 张照片到 ${categoryLabel} Archive`
            : `已添加 ${additions.length} 张照片，请保存 photos.json`);
          render();
          showToast(result.optimization?.failed?.length
            ? `${additions.length} 张照片已添加，部分图片优化失败，已保留原图`
            : `${additions.length} 张照片已添加到 Archive · Image ready`);
        } catch (error) {
          window.alert(`添加照片失败：${error.message}`);
        } finally {
          addPhotosButton.disabled = false;
          const label = viewFilter.options[viewFilter.selectedIndex]?.textContent || '';
          addPhotosLabel.textContent = `添加到 ${label}`;
        }
      }

      function ensureSeriesActionReady() {
        if (!dirty) return true;
        window.alert('请先保存当前照片排版修改，再管理 Series。创建、上传或调整 Series 会刷新本地数据。');
        return false;
      }

      function ensureLayoutSaved() {
        if (!layoutDirty) return true;
        window.alert('请先保存当前 Series 行布局，再执行其他 Series 操作。');
        return false;
      }

      function slugify(value) {
        return String(value || '')
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/&/g, ' and ')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .replace(/-{2,}/g, '-');
      }

      async function postJson(url, body) {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || '本地 Series 操作失败。');
        return result;
      }

      function openSeriesDialog() {
        if (!ensureSeriesActionReady()) return;
        $('#series-form').reset();
        $('#series-form-error').textContent = '';
        seriesDialog.dataset.slugTouched = 'false';
        seriesDialog.showModal();
        $('#series-title').focus();
      }

      async function createNewSeries() {
        const form = $('#series-form');
        if (!form.reportValidity() || !ensureSeriesActionReady()) return;
        const button = $('#create-series');
        button.disabled = true;
        $('#series-form-error').textContent = '';
        const title = $('#series-title').value.trim();
        const slug = $('#series-slug').value.trim();
        const year = $('#series-year').value.trim();
        const description = $('#series-description').value.trim();
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.setItem('editorSeriesSlug', slug);
        try {
          const result = await postJson('/__editor/series/create', { title, slug, year, description });
          seriesData.push(result.series);
          activeSeriesSlug = result.series.slug;
          seriesDialog.close();
          render();
          showToast(`Series “${result.series.title}” 已创建`);
        } catch (error) {
          sessionStorage.removeItem('editorSeriesSlug');
          $('#series-form-error').textContent = error.message;
        } finally {
          button.disabled = false;
        }
      }

      async function moveSeries(slug, direction) {
        if (!ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const ordered = orderedSeries();
        const index = ordered.findIndex((item) => item.slug === slug);
        const nextIndex = index + direction;
        if (index < 0 || nextIndex < 0 || nextIndex >= ordered.length) return;
        [ordered[index], ordered[nextIndex]] = [ordered[nextIndex], ordered[index]];
        sessionStorage.setItem('editorView', 'series');
        try {
          const result = await postJson('/__editor/series/reorder', { slugs: ordered.map((item) => item.slug) });
          seriesData = result.series;
          renderSeries();
          showToast('Series 顺序已保存');
        } catch (error) {
          window.alert(`调整顺序失败：${error.message}`);
        }
      }

      function openSeriesEdit(slug) {
        if (!ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const item = seriesData.find((entry) => entry.slug === slug);
        if (!item) return;
        $('#series-edit-original-slug').value = item.slug;
        $('#series-edit-title').value = item.title || '';
        $('#series-edit-slug').value = item.slug;
        $('#series-edit-year').value = item.year || '';
        $('#series-edit-order').value = String(Number(item.order) || orderedSeries().findIndex((entry) => entry.slug === slug) + 1);
        $('#series-edit-cover').value = item.coverImage || '';
        $('#series-edit-description').value = item.description || '';
        $('#series-edit-error').textContent = '';
        seriesEditDialog.showModal();
      }

      async function saveSeriesEdit() {
        const form = $('#series-edit-form');
        if (!form.reportValidity() || !ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const button = $('#save-series-edit');
        button.disabled = true;
        const slug = $('#series-edit-original-slug').value;
        sessionStorage.setItem('editorView', 'series');
        if (activeSeriesSlug) sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);
        try {
          const result = await postJson('/__editor/series/update', {
            slug,
            title: $('#series-edit-title').value.trim(),
            year: $('#series-edit-year').value.trim(),
            order: Number($('#series-edit-order').value),
            coverImage: $('#series-edit-cover').value.trim(),
            description: $('#series-edit-description').value.trim(),
          });
          seriesData = result.series;
          seriesEditDialog.close();
          renderSeries();
          showToast('Series 资料已保存');
        } catch (error) {
          $('#series-edit-error').textContent = error.message;
        } finally {
          button.disabled = false;
        }
      }

      function requestSeriesDelete(slug) {
        if (!ensureSeriesActionReady() || !ensureLayoutSaved()) return;
        const item = seriesData.find((entry) => entry.slug === slug);
        if (!item) return;
        if (seriesEditDialog.open) seriesEditDialog.close();
        seriesDeleteDialog.dataset.slug = slug;
