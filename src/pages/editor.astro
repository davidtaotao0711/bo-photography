        if (!image || !entry || coverImages.length !== 3) return;

        event.preventDefault();
        const index = Number(frame.dataset.portraitCategoryCoverPosition);
        const positions = portraitCategoryCoverPositions();
        const start = normalizePortraitCategoryCoverPosition(positions[index]);
        const bounds = frame.getBoundingClientRect();
        const startX = event.clientX;
        const startY = event.clientY;
        const pointerId = event.pointerId;
        let changed = false;
        frame.classList.add('is-repositioning');
        frame.setPointerCapture?.(pointerId);

        const onMove = (moveEvent) => {
          const x = Math.min(100, Math.max(0, start.x - ((moveEvent.clientX - startX) / bounds.width) * 100));
          const y = Math.min(100, Math.max(0, start.y - ((moveEvent.clientY - startY) / bounds.height) * 100));
          positions[index] = `${Number(x.toFixed(1))}% ${Number(y.toFixed(1))}%`;
          frame.style.setProperty('--cover-position', positions[index]);
          changed = true;
        };
        const onEnd = async () => {
          if (frame.hasPointerCapture?.(pointerId)) frame.releasePointerCapture(pointerId);
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onEnd);
          window.removeEventListener('pointercancel', onEnd);
          frame.classList.remove('is-repositioning');
          if (!changed) return;

          try {
            await persistPortraitCategoryCovers(coverImages, positions);
            showToast(`${index === 0 ? '左侧' : '右侧'}封面位置已保存`);
