      function reorderCollagePhoto(draggedId, targetId, placeAfter) {
        const items = currentCollagePhotos();
        const currentIds = items.map((photo) => photo.id);
        if (!currentIds.includes(draggedId) || !currentIds.includes(targetId) || draggedId === targetId) return;

        const orderedIds = currentIds.filter((id) => id !== draggedId);
        const targetIndex = orderedIds.indexOf(targetId);
        orderedIds.splice(targetIndex + (placeAfter ? 1 : 0), 0, draggedId);
        if (orderedIds.join('|') === currentIds.join('|')) return;

        snapshot();
        const orderById = new Map(orderedIds.map((id, index) => [id, index + 1]));
        photoData.forEach((photo) => {
          if (orderById.has(photo.id)) photo.order = orderById.get(photo.id);
        });
        selectedLayoutPhotoId = draggedId;
        setDirty(true);
        render();
        showToast('照片顺序已更新，其他照片已向后顺延');
      }

      function clearDropIndicators(container) {
        container.querySelectorAll('.is-drop-before, .is-drop-after').forEach((card) => {
          card.classList.remove('is-drop-before', 'is-drop-after');
        });
      }

      function bindCollageDrag(container) {
        container.addEventListener('pointerdown', (event) => {
          const handle = event.target.closest('[data-layout-select]');
          const card = event.target.closest('.editor-card--collage');
          if (!handle || !card || event.target.closest('button')) return;

          const pointerId = event.pointerId;
          const startX = event.clientX;
          const startY = event.clientY;
          let moved = false;
          let targetId = '';
          let placeAfter = false;
          draggedLayoutPhotoId = card.dataset.id;
          selectLayoutPhoto(draggedLayoutPhotoId);
          handle.setPointerCapture?.(pointerId);

          const onMove = (moveEvent) => {
            if (!moved && Math.hypot(moveEvent.clientX - startX, moveEvent.clientY - startY) < 8) return;
            moved = true;
            card.classList.add('is-dragging');
            clearDropIndicators(container);

            const target = document.elementFromPoint(moveEvent.clientX, moveEvent.clientY)?.closest('.editor-card--collage');
            if (!target || !container.contains(target) || target.dataset.id === draggedLayoutPhotoId) {
              targetId = '';
              return;
            }

            const rect = target.getBoundingClientRect();
            placeAfter = moveEvent.clientY > rect.top + rect.height / 2
              || (Math.abs(moveEvent.clientY - (rect.top + rect.height / 2)) < rect.height * .2
                && moveEvent.clientX > rect.left + rect.width / 2);
            targetId = target.dataset.id;
            target.classList.add(placeAfter ? 'is-drop-after' : 'is-drop-before');
          };

          const onEnd = () => {
            if (handle.hasPointerCapture?.(pointerId)) handle.releasePointerCapture(pointerId);
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onEnd);
            window.removeEventListener('pointercancel', onEnd);
            card.classList.remove('is-dragging');
            clearDropIndicators(container);
            if (moved && targetId) reorderCollagePhoto(draggedLayoutPhotoId, targetId, placeAfter);
            draggedLayoutPhotoId = '';
          };

          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onEnd);
          window.addEventListener('pointercancel', onEnd);
        });
      }

      function bindPortfolioDrag(container) {
        container.addEventListener('pointerdown', (event) => {
          const handle = event.target.closest('[data-layout-select]');
          const card = event.target.closest('.editor-card--portfolio');
          const photoGrid = card?.closest('[data-portfolio-grid], .editor-row');
          if (!handle || !card || !photoGrid || event.target.closest('button, input, label')) return;

          const draggedId = card.dataset.id;
          const status = photoGrid.dataset.portfolioGrid || photoGrid.dataset.portfolioRowGrid;
          const pointerId = event.pointerId;
          const startX = event.clientX;
          const startY = event.clientY;
          let moved = false;
          let targetId = '';
          let placeAfter = false;
          handle.setPointerCapture?.(pointerId);

          const onMove = (moveEvent) => {
            if (!moved && Math.hypot(moveEvent.clientX - startX, moveEvent.clientY - startY) < 8) return;
            moved = true;
            card.classList.add('is-dragging');
            clearDropIndicators(photoGrid);
            const target = document.elementFromPoint(moveEvent.clientX, moveEvent.clientY)?.closest('.editor-card--portfolio');
            if (!target || !photoGrid.contains(target) || target.dataset.id === draggedId) {
              targetId = '';
              return;
            }
            const rect = target.getBoundingClientRect();
            placeAfter = moveEvent.clientY > rect.top + rect.height / 2
              || (Math.abs(moveEvent.clientY - (rect.top + rect.height / 2)) < rect.height * .2
                && moveEvent.clientX > rect.left + rect.width / 2);
            targetId = target.dataset.id;
            target.classList.add(placeAfter ? 'is-drop-after' : 'is-drop-before');
          };

          const onEnd = () => {
            if (handle.hasPointerCapture?.(pointerId)) handle.releasePointerCapture(pointerId);
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onEnd);
            window.removeEventListener('pointercancel', onEnd);
            card.classList.remove('is-dragging');
            clearDropIndicators(photoGrid);
            if (moved && targetId) reorderPortfolioPhotos(status, draggedId, targetId, placeAfter);
          };

          event.preventDefault();
          event.stopPropagation();
          selectLayoutPhoto(draggedId);
          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onEnd);
          window.addEventListener('pointercancel', onEnd);
        });
      }

      function nearestCollageSpan(value) {
        return COLLAGE_WIDTH_SPANS.reduce((nearest, span) => (
          Math.abs(span - value) < Math.abs(nearest - value) ? span : nearest
        ), COLLAGE_WIDTH_SPANS[0]);
      }

      function applyCollageLayoutPreview(card, photo) {
        const layout = normalizeCollageLayout(photo);
        card.style.setProperty('--editor-col-span', String(layout.colSpan));
        card.style.setProperty('--editor-aspect', `${layout.colSpan}/${layout.rowSpan}`);
        card.classList.toggle('is-ratio-adjusted', layout.ratio !== null);
        if (layout.ratio !== null) {
          card.style.setProperty('--editor-display-aspect', `1/${layout.ratio}`);
        } else {
          card.style.removeProperty('--editor-display-aspect');
        }

        const summary = card.querySelector('[data-layout-summary-text]');
        const preset = presetName(layout) || `${layout.colSpan}×${layout.rowSpan}`;
        if (summary) {
          summary.textContent = `${preset} · ${layout.ratio ? `ratio ${layout.ratio.toFixed(2)}` : layout.crop ? `crop ${layout.fit}` : 'natural'}`;
        }
      }

      function bindCollageResize(container) {
        container.addEventListener('pointerdown', (event) => {
          const handle = event.target.closest('[data-collage-resize]');
          const card = event.target.closest('.editor-card--collage');
          if (!handle || !card) return;

          const photo = photoData.find((item) => item.id === card.dataset.id);
          if (!photo) return;

          event.preventDefault();
          event.stopPropagation();
          selectLayoutPhoto(photo.id);

          const pointerId = event.pointerId;
          const mode = handle.dataset.collageResize;
          const startX = event.clientX;
          const startY = event.clientY;
          const startLayout = normalizeCollageLayout(photo);
          const layoutContainer = handle.closest('.photo-grid--collage, .series-photo-grid, .editor-row') || container;
          const shouldPack = layoutContainer.matches?.('.photo-grid--collage, .series-photo-grid');
          const image = card.querySelector('img');
          const imageBounds = card.querySelector('.editor-card__image')?.getBoundingClientRect();
          const naturalRatio = image?.naturalWidth && image?.naturalHeight
            ? image.naturalHeight / image.naturalWidth
            : imageBounds?.height && imageBounds?.width ? imageBounds.height / imageBounds.width : 1;
          const startRatio = startLayout.ratio
            ?? Math.min(COLLAGE_RATIO_MAX, Math.max(COLLAGE_RATIO_MIN, naturalRatio));
          const cardWidth = Math.max(1, imageBounds?.width || card.getBoundingClientRect().width);
          const containerStyle = getComputedStyle(layoutContainer);
          const columnGap = Number.parseFloat(containerStyle.columnGap) || 12;
          const columnWidth = Math.max(1, (layoutContainer.clientWidth - columnGap * 11) / 12);
          const widthDirection = mode === 'width-left' ? -1 : 1;
          let changed = false;
          let didSnapshot = false;

          card.classList.add('is-layout-resizing');
          card.classList.toggle('is-height-resizing', mode === 'height');
          handle.setPointerCapture?.(pointerId);

          const updateLayout = (values) => {
            if (!didSnapshot) {
              snapshot();
              didSnapshot = true;
            }
            changed = true;
            setPhotoLayout(photo, values);
            applyCollageLayoutPreview(card, photo);
            if (shouldPack) scheduleEditorMasonry(layoutContainer);
          };

          const onMove = (moveEvent) => {
            if (mode === 'height') {
              const ratio = Math.min(
                COLLAGE_RATIO_MAX,
                Math.max(COLLAGE_RATIO_MIN, Math.round((startRatio + (moveEvent.clientY - startY) / cardWidth) * 100) / 100),
              );
              if (ratio !== normalizeCollageLayout(photo).ratio) updateLayout({ ratio, crop: startLayout.crop });
              return;
            }

            const desiredSpan = startLayout.colSpan
              + ((moveEvent.clientX - startX) * widthDirection) / (columnWidth + columnGap);
            const colSpan = nearestCollageSpan(desiredSpan);
            if (colSpan !== normalizeCollageLayout(photo).colSpan) updateLayout({ colSpan });
          };

          const onEnd = () => {
            if (handle.hasPointerCapture?.(pointerId)) handle.releasePointerCapture(pointerId);
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onEnd);
            window.removeEventListener('pointercancel', onEnd);
            card.classList.remove('is-layout-resizing', 'is-height-resizing');
            if (shouldPack) scheduleEditorMasonry(layoutContainer);

            if (!changed) return;
            setDirty(true);
            updateLayoutToolbar();
            const layout = normalizeCollageLayout(photo);
