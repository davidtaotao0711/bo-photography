          if (!photo) return;
          snapshot();
          const layout = normalizeCollageLayout(photo);
          const newFit = layout.fit === 'cover' ? 'contain' : 'cover';
          setPhotoLayout(photo, { fit: newFit, crop: true });
          setDirty(true);
          render();
          showToast('Fit switched to ' + newFit + ' - click Save to write to photos.json');
          return;
        }
        const coverButton = event.target.closest('[data-cover-image]');
        if (coverButton) setSeriesCover(coverButton.dataset.coverImage);
        const rowButton = event.target.closest('[data-row-action]');
        const row = event.target.closest('[data-row-index]');
        if (rowButton && row) adjustSeriesRow(Number(row.dataset.rowIndex), rowButton.dataset.rowAction);
      });
      $('#add-portrait-row').addEventListener('click', () => addSeriesRow('portrait'));
      $('#add-landscape-row').addEventListener('click', () => addSeriesRow('landscape'));
      $('#save-series-layout').addEventListener('click', saveSeriesLayout);
      $('#edit-active-series').addEventListener('click', () => openSeriesEdit(activeSeriesSlug));
      $('#save-series-edit').addEventListener('click', saveSeriesEdit);
      $('#request-delete-series').addEventListener('click', () => requestSeriesDelete($('#series-edit-original-slug').value));
      $('#series-delete-confirmation').addEventListener('input', (event) => {
        $('#confirm-delete-series').disabled = event.target.value.trim() !== seriesDeleteDialog.dataset.slug;
      });
      seriesDeleteDialog.querySelectorAll('[value="cancel"]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          seriesDeleteDialog.close('cancel');
        });
      });
      $('#confirm-delete-series').addEventListener('click', deleteSeries);
      $('#upload-series-photos').addEventListener('click', () => $('#series-photo-input').click());
      $('#series-photo-input').addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []);
        event.target.value = '';
        if (!files.length || !await confirmLargeFiles(files)) return;
        await importSeriesPhotos(files);
      });
      addPhotosButton.addEventListener('click', () => $('#photo-file-input').click());
      $('#photo-file-input').addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []);
        event.target.value = '';
        if (!files.length || !await confirmLargeFiles(files)) return;
        await importPhotos(files);
      });
      $('#clear-search').addEventListener('click', () => { searchInput.value = ''; render(); });
      $('#apply-photo').addEventListener('click', applyInspector);
      $('#delete-photo').addEventListener('click', () => deletePhoto($('#form-original-id').value));
      $('#set-home-intro').addEventListener('click', openHomeIntroDialog);
      $('#home-intro-slots').addEventListener('click', (event) => {
        const button = event.target.closest('[data-intro-slot]');
        if (button) setHomeIntroSlot(Number(button.dataset.introSlot));
      });
      $('#form-image').addEventListener('input', (event) => { $('#form-preview').src = event.target.value; });
      $('#open-file').addEventListener('click', async () => {
        const openPortraitLayout = viewFilter.value === 'portrait-layout';
        if ('showOpenFilePicker' in window) {
          try {
            const [handle] = await window.showOpenFilePicker({
              types: [{ description: 'JSON 文件', accept: { 'application/json': ['.json'] } }],
              multiple: false,
            });
            const file = await handle.getFile();
            if (openPortraitLayout) await loadPortraitBooksFile(file, handle);
            else await loadFile(file, handle);
          } catch (error) {
            if (error.name !== 'AbortError') window.alert(`打开失败：${error.message}`);
          }
        } else {
          $('#file-fallback').click();
        }
      });
      $('#file-fallback').addEventListener('change', (event) => {
        const [file] = event.target.files;
        if (file && viewFilter.value === 'portrait-layout') loadPortraitBooksFile(file);
        else if (file) loadFile(file);
        event.target.value = '';
      });
      $('#save-file').addEventListener('click', saveCurrentJson);
      $('#download').addEventListener('click', downloadCurrentJson);
      $('#undo').addEventListener('click', () => {
        if (viewFilter.value === 'portrait-layout') {
          if (!portraitBooksHistory.length) return;
          portraitBooksData = portraitBooksHistory.pop();
          setPortraitBooksDirty(true, '已撤销 Portrait Books 上一步');
          renderPortraitBooks();
          return;
        }
        if (!history.length) return;
        photoData = history.pop();
        $('#undo').disabled = history.length === 0;
        setDirty(true, '已撤销上一步');
        render();
      });
      $('#reset').addEventListener('click', () => {
        if (viewFilter.value === 'portrait-layout') {
          if (!window.confirm('确定恢复到页面最初载入的 Portrait Books 吗？')) return;
          snapshotPortraitBooks();
          portraitBooksData = structuredClone(initialPortraitBooks);
          activePortraitBookSlug = '';
          sessionStorage.removeItem('editorPortraitBookSlug');
          setPortraitBooksDirty(true, '已恢复初始 Portrait Books，尚未保存');
          renderPortraitBooks();
          return;
        }
        if (!window.confirm('确定恢复到页面最初载入的数据吗？当前修改会丢失。')) return;
        snapshot();
        photoData = migratePortfolioPhotos(initialPhotos);
        siteData = structuredClone(initialSite);
        siteDirty = false;
        setDirty(true, '已恢复初始数据，尚未保存');
        render();
      });
      window.addEventListener('beforeunload', (event) => {
        if (!dirty && !siteDirty && !layoutDirty && !portraitBooksDirty) return;
        event.preventDefault();
        event.returnValue = '';
      });
      window.addEventListener('resize', () => {
        syncCanvasScale();
        scheduleEditorMasonry(grid);
        scheduleEditorMasonry(seriesPhotoGrid);
        categorySections.querySelectorAll('.portfolio-photo-grid').forEach((container) => scheduleEditorMasonry(container));
      });
      editorMasonryMedia.addEventListener('change', () => {
        scheduleEditorMasonry(grid);
        scheduleEditorMasonry(seriesPhotoGrid);
        categorySections.querySelectorAll('.portfolio-photo-grid').forEach((container) => scheduleEditorMasonry(container));
      });

      render();
    </script>
  </body>
</html>

