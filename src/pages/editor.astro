      function bindPortraitGroupDrag() {
        portraitLayoutGroups.addEventListener('pointerdown', (event) => {
          const handle = event.target.closest('[data-portrait-drag-handle]');
          const card = event.target.closest('[data-portrait-group-id]');
          if (!handle || !card) return;

          const pointerId = event.pointerId;
          const startX = event.clientX;
          const startY = event.clientY;
          const draggedId = card.dataset.portraitGroupId;
          let moved = false;
          let targetId = '';
          let placeAfter = false;
          handle.setPointerCapture?.(pointerId);

          const clearIndicators = () => portraitLayoutGroups
            .querySelectorAll('.is-drop-before, .is-drop-after')
            .forEach((item) => item.classList.remove('is-drop-before', 'is-drop-after'));

          const onMove = (moveEvent) => {
            if (!moved && Math.hypot(moveEvent.clientX - startX, moveEvent.clientY - startY) < 8) return;
            moved = true;
            card.classList.add('is-dragging');
            clearIndicators();
            const target = document.elementFromPoint(moveEvent.clientX, moveEvent.clientY)?.closest('[data-portrait-group-id]');
            if (!target || !portraitLayoutGroups.contains(target) || target === card) {
              targetId = '';
              return;
            }
            const rect = target.getBoundingClientRect();
            placeAfter = moveEvent.clientY > rect.top + rect.height / 2;
            targetId = target.dataset.portraitGroupId;
            target.classList.add(placeAfter ? 'is-drop-after' : 'is-drop-before');
          };

          const onEnd = () => {
            if (handle.hasPointerCapture?.(pointerId)) handle.releasePointerCapture(pointerId);
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onEnd);
            window.removeEventListener('pointercancel', onEnd);
            card.classList.remove('is-dragging');
            clearIndicators();
            if (moved && targetId) reorderPortraitGroup(draggedId, targetId, placeAfter);
          };

          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onEnd);
          window.addEventListener('pointercancel', onEnd);
        });
      }

