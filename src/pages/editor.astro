        seriesDeleteDialog.showModal();
        $('#series-delete-confirmation').focus();
      }

      async function deleteSeries() {
        const slug = seriesDeleteDialog.dataset.slug || '';
        if ($('#series-delete-confirmation').value.trim() !== slug) return;
        const button = $('#confirm-delete-series');
        button.disabled = true;
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.removeItem('editorSeriesSlug');
        try {
          const result = await postJson('/__editor/series/delete', { slug });
          seriesData = result.series;
          photoData = photoData.filter((photo) => photo.series !== slug);
          activeSeriesSlug = '';
          layoutDraftSlug = '';
          layoutDraftRows = [];
          layoutDirty = false;
          seriesDeleteDialog.close();
          setDirty(false, `Series 已移至 ${result.trashPath || 'trash/series'}`);
          renderSeries();
          showToast(`Series 已移除，${result.removedPhotoCount} 条照片记录已清理`);
        } catch (error) {
          $('#series-delete-error').textContent = error.message;
          button.disabled = false;
        }
      }

      function addSeriesRow(orientation) {
        const donorIndex = layoutDraftRows.findLastIndex((row) => row.orientation === orientation && row.photoIds.length > 1);
        const photoIds = donorIndex >= 0 ? [layoutDraftRows[donorIndex].photoIds.pop()] : [];
        layoutDraftRows.push({ orientation, photoIds });
        markLayoutDirty();
        renderSeries();
      }

      function adjustSeriesRow(rowIndex, action) {
        const row = layoutDraftRows[rowIndex];
        if (!row) return;
        if (action === 'up' || action === 'down') {
          const nextIndex = rowIndex + (action === 'up' ? -1 : 1);
          if (nextIndex < 0 || nextIndex >= layoutDraftRows.length) return;
          [layoutDraftRows[rowIndex], layoutDraftRows[nextIndex]] = [layoutDraftRows[nextIndex], layoutDraftRows[rowIndex]];
        }
        if (action === 'increase') {
          if (row.photoIds.length >= maxRowPhotos(row.orientation)) return;
          let donorIndex = layoutDraftRows.findIndex((candidate, index) => index > rowIndex && candidate.orientation === row.orientation && candidate.photoIds.length > 1);
          if (donorIndex < 0) donorIndex = layoutDraftRows.findIndex((candidate, index) => index !== rowIndex && candidate.orientation === row.orientation && candidate.photoIds.length > 1);
          if (donorIndex < 0) {
            showToast('没有可移入本行的同方向照片');
            return;
          }
          const donor = layoutDraftRows[donorIndex];
          row.photoIds.push(donorIndex > rowIndex ? donor.photoIds.shift() : donor.photoIds.pop());
        }
        if (action === 'decrease') {
          if (row.photoIds.length <= 1) return;
          const photoId = row.photoIds.pop();
          let receiverIndex = layoutDraftRows.findIndex((candidate, index) => index > rowIndex && candidate.orientation === row.orientation && candidate.photoIds.length < maxRowPhotos(row.orientation));
          if (receiverIndex < 0) {
            layoutDraftRows.splice(rowIndex + 1, 0, { orientation: row.orientation, photoIds: [photoId] });
          } else {
            layoutDraftRows[receiverIndex].photoIds.unshift(photoId);
          }
        }
        layoutDraftRows = layoutDraftRows.filter((candidate) => candidate.photoIds.length > 0);
        markLayoutDirty();
        renderSeries();
      }

      async function saveSeriesLayout() {
        if (!activeSeriesSlug || !ensureSeriesActionReady()) return;
        const button = $('#save-series-layout');
        button.disabled = true;
        sessionStorage.setItem('editorView', 'series');
        sessionStorage.setItem('editorSeriesSlug', activeSeriesSlug);
        try {
          const result = await postJson('/__editor/series/layout', {
            slug: activeSeriesSlug,
            layoutRows: layoutDraftRows.filter((row) => row.photoIds.length > 0),
          });
          seriesData = seriesData.map((item) => item.slug === activeSeriesSlug ? result.series : item);
          layoutDraftRows = structuredClone(result.series.layoutRows || []);
          layoutDirty = false;
          renderSeries();
          showToast('Series 行布局已保存');
        } catch (error) {
          window.alert(`保存布局失败：${error.message}`);
          button.disabled = false;
        }
      }

