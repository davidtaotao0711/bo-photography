      function pruneInvalidPortraitBookItems(value) {
        const normalized = normalizePortraitBooks(value);
        const validPhotoIds = new Set(portraitBookPhotos().map((photo) => photo.id));
        let removed = 0;
        normalized.books.forEach((book) => {
          book.layout.groups.forEach((group) => {
            const before = group.items.length;
            group.items = group.items.filter((item) => validPhotoIds.has(item.photoId));
            removed += before - group.items.length;
          });
        });
        return { books: normalized, removed };
      }

      function validatePortraitBooks(value) {
        const { books: normalized } = pruneInvalidPortraitBookItems(value);
        const selected = portraitSelectedPhotos();
        const bookPhotoIds = new Set(portraitBookPhotos().map((photo) => photo.id));
        const selectedImages = new Set(selected.map((photo) => photo.image));
        const slugs = new Set();
        normalized.books.forEach((book) => {
          if (!book.title) throw new Error('每本 Portrait Book 都需要 title。');
          if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(book.slug) || book.slug === 'archive') throw new Error(`${book.title} 的 slug 无效。`);
          if (slugs.has(book.slug)) throw new Error(`Portrait Book slug 重复：${book.slug}`);
          if (!selectedImages.has(book.coverImage)) throw new Error(`${book.title} 的书封必须来自 Selected Portrait。`);
          slugs.add(book.slug);
          const used = new Set();
          book.layout.groups.forEach((group, index) => {
            if (!PORTRAIT_LAYOUT_PRESETS.includes(group.preset)) throw new Error(`${book.title} 的 Spread ${index + 1} preset 无效。`);
            const capacity = portraitPresetCapacity[group.preset] ?? 0;
            if (group.items.length > capacity) throw new Error(`${book.title} / ${group.title || group.id} 最多可放 ${capacity} 张照片。`);
            group.items.forEach((item) => {
              if (!bookPhotoIds.has(item.photoId)) throw new Error(`${item.photoId} 不是 Selected 或 Archive Portrait。`);
              if (used.has(item.photoId)) throw new Error(`${item.photoId} 不能在同一本书中重复出现。`);
              used.add(item.photoId);
            });
          });
        });
        return normalized;
      }

