      function validatePhotos(value) {
        if (!Array.isArray(value)) throw new Error('文件内容不是照片数组。');
        const ids = new Set();
        value.forEach((photo, index) => {
          if (!photo || typeof photo !== 'object') throw new Error(`第 ${index + 1} 项不是有效照片。`);
          if (!photo.id || !photo.image) throw new Error(`第 ${index + 1} 项缺少 id 或 image。`);
          if (ids.has(photo.id)) throw new Error(`发现重复 ID：${photo.id}`);
          if (![...photoCategories, 'series'].includes(photo.category)) throw new Error(`${photo.id} 的分类无效。`);
          if (!['portrait', 'landscape'].includes(photo.orientation)) throw new Error(`${photo.id} 的画面方向无效。`);
          if (photoCategories.includes(photo.category)) {
            if (photo.portfolioStatus !== undefined && !['selected', 'archive'].includes(photo.portfolioStatus)) throw new Error(`${photo.id} 的 portfolioStatus 无效。`);
            if (photo.layoutMode !== undefined && !['rows'].includes(photo.layoutMode)) throw new Error(`${photo.id} 的 layoutMode 无效。`);
            ['selectedOrder', 'archiveOrder'].forEach((field) => {
              if (photo[field] !== undefined && photo[field] !== null && (!Number.isFinite(Number(photo[field])) || Number(photo[field]) < 1)) {
                throw new Error(`${photo.id} 的 ${field} 必须是正数或空值。`);
              }
            });
          }
          if (photo.layoutWidth !== undefined && (!Number.isFinite(Number(photo.layoutWidth)) || Number(photo.layoutWidth) < 45 || Number(photo.layoutWidth) > 200)) throw new Error(`${photo.id} 的显示尺寸应在 45–200 之间。`);
          if (photo.layoutOffsetX !== undefined && (!Number.isFinite(Number(photo.layoutOffsetX)) || Math.abs(Number(photo.layoutOffsetX)) > 80)) throw new Error(`${photo.id} 的水平位置应在 -80–80 之间。`);
          if (photo.layoutOffsetY !== undefined && (!Number.isFinite(Number(photo.layoutOffsetY)) || Math.abs(Number(photo.layoutOffsetY)) > 80)) throw new Error(`${photo.id} 的垂直位置应在 -80–80 之间。`);
          if (photo.categoryLayoutWidth !== undefined && (!Number.isFinite(Number(photo.categoryLayoutWidth)) || Number(photo.categoryLayoutWidth) < 45 || Number(photo.categoryLayoutWidth) > 200)) throw new Error(`${photo.id} 的分类页显示尺寸应在 45–200 之间。`);
          if (photo.categoryLayoutOffsetX !== undefined && (!Number.isFinite(Number(photo.categoryLayoutOffsetX)) || Math.abs(Number(photo.categoryLayoutOffsetX)) > 80)) throw new Error(`${photo.id} 的分类页水平位置应在 -80–80 之间。`);
          if (photo.categoryLayoutOffsetY !== undefined && (!Number.isFinite(Number(photo.categoryLayoutOffsetY)) || Math.abs(Number(photo.categoryLayoutOffsetY)) > 80)) throw new Error(`${photo.id} 的分类页垂直位置应在 -80–80 之间。`);
          if (photo.layout !== undefined) {
            if (!photo.layout || typeof photo.layout !== 'object' || Array.isArray(photo.layout)) throw new Error(`${photo.id} 的 layout 必须是对象。`);
            const colSpan = Number(photo.layout.colSpan ?? 4);
            const rowSpan = Number(photo.layout.rowSpan ?? 4);
            const focalX = Number(photo.layout.focalX ?? 50);
            const focalY = Number(photo.layout.focalY ?? 50);
            const ratio = photo.layout.ratio === undefined ? null : Number(photo.layout.ratio);
            if (!Number.isFinite(colSpan) || colSpan < 3 || colSpan > 12) throw new Error(`${photo.id} 的 colSpan 应在 3–12 之间。`);
            if (!Number.isFinite(rowSpan) || rowSpan < 3 || rowSpan > 8) throw new Error(`${photo.id} 的 rowSpan 应在 3–8 之间。`);
            if (ratio !== null && (!Number.isFinite(ratio) || ratio < COLLAGE_RATIO_MIN || ratio > COLLAGE_RATIO_MAX)) throw new Error(`${photo.id} 的 ratio 应在 ${COLLAGE_RATIO_MIN}–${COLLAGE_RATIO_MAX} 之间。`);
            if (photo.layout.crop !== undefined && typeof photo.layout.crop !== 'boolean') throw new Error(`${photo.id} 的 crop 应为 true 或 false。`);
            if (!['cover', 'contain'].includes(photo.layout.fit || 'contain')) throw new Error(`${photo.id} 的 fit 应为 cover 或 contain。`);
            if (!Number.isFinite(focalX) || focalX < 0 || focalX > 100) throw new Error(`${photo.id} 的 focalX 应在 0–100 之间。`);
            if (!Number.isFinite(focalY) || focalY < 0 || focalY > 100) throw new Error(`${photo.id} 的 focalY 应在 0–100 之间。`);
          }
          ids.add(photo.id);
        });
        return value;
      }

