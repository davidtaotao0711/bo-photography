---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SocialLinks from '../components/SocialLinks.astro';
import site from '../data/site.json';
---

<BaseLayout title={`About — ${site.name}`} description={site.about}>
  <section class="about page-shell">
    <header>
      <p class="eyebrow">About</p>
      <h1>{site.name}</h1>
    </header>
    <div class="about__portrait">
      <ResponsiveImage src="/images/about-portrait.jpg" alt={`Portrait by ${site.name}`} sizes="(max-width: 720px) 78vw, 28vw" />
    </div>
    <div class="about__copy">
      <p class="about__lead">{site.about}</p>
      <div class="about__links">
        <div><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
        <SocialLinks social={site.social} />
      </div>
    </div>
  </section>
</BaseLayout>
