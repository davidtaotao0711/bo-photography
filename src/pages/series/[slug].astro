---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import photos from '../../data/photos.json';
import series from '../../data/series.json';
import site from '../../data/site.json';
import { buildOrientationRows } from '../../utils/photo-layout.js';

export function getStaticPaths() {
  return series.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const items = photos
  .map((photo, index) => ({ photo, index, order: Number.isFinite(Number(photo.order)) ? Number(photo.order) : index + 1 }))
  .filter(({ photo }) => photo.series === item.slug)
  .sort((a, b) => a.order - b.order || a.index - b.index)
  .map(({ photo }) => photo);
const itemById = new Map(items.map((photo) => [photo.id, photo]));
const usedPhotoIds = new Set();
const configuredRows = Array.isArray(item.layoutRows)
  ? item.layoutRows.flatMap((row) => {
      const orientation = row?.orientation === 'portrait' ? 'portrait' : 'landscape';
      const maxPhotos = orientation === 'portrait' ? 4 : 3;
      const rowItems = (Array.isArray(row?.photoIds) ? row.photoIds : [])
        .map((id) => itemById.get(id))
        .filter((photo) => {
          if (!photo || usedPhotoIds.has(photo.id)) return false;
          const photoOrientation = photo.orientation === 'portrait' ? 'portrait' : 'landscape';
          return photoOrientation === orientation;
        })
        .slice(0, maxPhotos);
      rowItems.forEach((photo) => usedPhotoIds.add(photo.id));
      return rowItems.length ? [{ orientation, items: rowItems }] : [];
    })
  : [];
const remainingRows = buildOrientationRows(items.filter((photo) => !usedPhotoIds.has(photo.id)));
const layoutRows = configuredRows.length ? [...configuredRows, ...remainingRows] : buildOrientationRows(items);
let photoNumber = 0;
const numberedRows = layoutRows.map((row) => ({
  ...row,
  items: row.items.map((photo) => ({ photo, number: ++photoNumber })),
}));
const layoutStyle = (photo) => {
  const explicitWidth = Number(photo.layoutWidth);
  const sizeWidth = Number(photo.size);
  const width = Number.isFinite(explicitWidth)
    ? Math.min(200, Math.max(45, explicitWidth))
    : Number.isFinite(sizeWidth) ? Math.min(200, Math.max(45, sizeWidth)) : null;
  const x = Number.isFinite(photo.layoutOffsetX) ? Math.min(80, Math.max(-80, Number(photo.layoutOffsetX))) : 0;
  const y = Number.isFinite(photo.layoutOffsetY) ? Math.min(80, Math.max(-80, Number(photo.layoutOffsetY))) : 0;
  return [width ? `width: ${width}%` : '', width ? 'justify-self: center' : '', x || y ? `transform: translate(${x}%, ${y}%)` : ''].filter(Boolean).join('; ');
};
const imageStyle = (photo) => {
  const aspect = Number(photo.aspect);
  return Number.isFinite(aspect) && aspect > 0 ? `aspect-ratio: ${aspect}; object-fit: cover;` : undefined;
};
---

<BaseLayout title={`${item.title} ${item.year} — ${site.name}`} description={item.description}>
  <article class="series-detail">
    <header class="series-detail__head page-shell">
      <a class="back-link" href="/series">← Series</a>
      <p class="eyebrow">Photo essay / {item.year || 'Ongoing'} / {items.length} photographs</p>
      <h1>{item.title}</h1>
      {item.description && <p class="series-detail__description">{item.description}</p>}
    </header>
    <div class="series-flow page-shell">
      {items.length ? numberedRows.map((row) => (
        <div
          class:list={['series-flow__row', `series-flow__row--${row.orientation}`, { 'series-flow__row--single': row.items.length === 1 }]}
          style={`--series-row-count: ${row.items.length}`}
        >
          {row.items.map(({ photo, number }) => (
            <figure
              class:list={['series-flow__item', `is-${photo.orientation === 'portrait' ? 'portrait' : 'landscape'}`]}
              style={layoutStyle(photo) || undefined}
            >
              <a href={`/photo/${photo.id}`}>
                <ResponsiveImage
                  src={photo.image}
                  alt={photo.alt}
                  sizes={photo.orientation === 'portrait' ? '(max-width: 720px) 78vw, 32vw' : '(max-width: 720px) 100vw, 48vw'}
                  style={imageStyle(photo)}
                />
              </a>
              <figcaption>{String(number).padStart(2, '0')}{photo.location ? ` / ${photo.location}` : ''}</figcaption>
            </figure>
          ))}
        </div>
      )) : <div class="series-detail__empty"><p>This series is waiting for its first photograph.</p></div>}
    </div>
    <footer class="series-detail__end page-shell">
      <p>End of series</p>
      <a class="text-link" href="/series">All series <span>↗</span></a>
    </footer>
  </article>
</BaseLayout>
