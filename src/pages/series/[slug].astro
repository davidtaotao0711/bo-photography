---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import photos from '../../data/photos.json';
import series from '../../data/series.json';
import site from '../../data/site.json';
import { normalizeCollageLayout, sortPhotosByOrder } from '../../utils/collage-layout.js';
import { buildOrientationRows } from '../../utils/photo-layout.js';

export function getStaticPaths() {
  return series.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const items = sortPhotosByOrder(photos.filter((photo) => photo.series === item.slug));
const photosById = new Map(items.map((photo) => [photo.id, photo]));
const usedRowIds = new Set();
const savedRows = Array.isArray(item.layoutRows)
  ? item.layoutRows.map((row) => {
      const orientation = row?.orientation === 'portrait' ? 'portrait' : 'landscape';
      return {
        orientation,
        items: (Array.isArray(row?.photoIds) ? row.photoIds : [])
          .map((id) => photosById.get(id))
          .filter((photo) => photo && !usedRowIds.has(photo.id) && (photo.orientation === 'portrait' ? 'portrait' : 'landscape') === orientation)
          .slice(0, 4),
      };
    }).filter((row) => row.items.length > 0)
  : [];
savedRows.forEach((row) => row.items.forEach((photo) => usedRowIds.add(photo.id)));
const missingRows = buildOrientationRows(items.filter((photo) => !usedRowIds.has(photo.id)));
const rows = [...savedRows, ...missingRows];
const useRows = savedRows.length > 0;
---

<BaseLayout title={`${item.title} ${item.year} — ${site.name}`} description={item.description}>
  <article class="series-detail">
    <header class="series-detail__head page-shell">
      <a class="back-link" href="/series">← Series</a>
      <p class="eyebrow">Photo essay / {item.year || 'Ongoing'} / {items.length} photographs</p>
      <h1>{item.title}</h1>
      {item.description && <p class="series-detail__description">{item.description}</p>}
    </header>
    <div class="series-flow page-shell">
      {items.length
        ? useRows
          ? <section class="gallery gallery--rows">
              {rows.map((row) => (
                <div class="gallery-row" class:list={[`gallery-row--${row.orientation}`]} style={`--gallery-row-count:${row.items.length}`}>
                  {row.items.map((photo, index) => <PhotoCard photo={photo} eager={index < 3} layoutScope="none" layout={normalizeCollageLayout(photo)} collage reveal />)}
                </div>
              ))}
            </section>
          : <GalleryGrid photos={items} class="series-collage" />
        : <div class="series-detail__empty"><p>This series is waiting for its first photograph.</p></div>}
    </div>
    <footer class="series-detail__end page-shell">
      <p>End of series</p>
      <a class="text-link" href="/series">All series <span>↗</span></a>
    </footer>
  </article>
  <ScrollReveal />
</BaseLayout>
