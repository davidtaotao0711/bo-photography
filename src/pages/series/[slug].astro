---
import BaseLayout from '../../layouts/BaseLayout.astro';
import photos from '../../data/photos.json';
import series from '../../data/series.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return series.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const items = photos.filter((photo) => photo.series === item.slug);
---

<BaseLayout title={`${item.title} ${item.year} — ${site.name}`} description={item.description}>
  <article class="series-detail">
    <header class="series-detail__head page-shell">
      <a class="back-link" href="/series">← Series</a>
      <p class="eyebrow">Photo essay / {item.year}</p>
      <h1>{item.title}</h1>
      <p class="series-detail__description">{item.description}</p>
    </header>
    <div class="series-flow page-shell">
      {items.map((photo, index) => (
        <figure class:list={["series-flow__item", `series-flow__item--${index % 4}`, `is-${photo.orientation}`]}>
          <a href={`/photo/${photo.id}`}><img src={photo.image} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} /></a>
          <figcaption>{String(index + 1).padStart(2, '0')} / {photo.location}</figcaption>
        </figure>
      ))}
    </div>
    <footer class="series-detail__end page-shell">
      <p>End of series</p>
      <a class="text-link" href="/series">All series <span>↗</span></a>
    </footer>
  </article>
</BaseLayout>
