---
import BaseLayout from '../../layouts/BaseLayout.astro';
import photos from '../../data/photos.json';
import series from '../../data/series.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return series.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const items = photos
  .map((photo, index) => ({ photo, index, order: Number.isFinite(Number(photo.order)) ? Number(photo.order) : index + 1 }))
  .filter(({ photo }) => photo.series === item.slug)
  .sort((a, b) => a.order - b.order || a.index - b.index)
  .map(({ photo }) => photo);
const layoutStyle = (photo) => {
  const explicitWidth = Number(photo.layoutWidth);
  const sizeWidth = Number(photo.size);
  const width = Number.isFinite(explicitWidth)
    ? Math.min(200, Math.max(45, explicitWidth))
    : Number.isFinite(sizeWidth) ? Math.min(200, Math.max(45, sizeWidth)) : null;
  const x = Number.isFinite(photo.layoutOffsetX) ? Math.min(80, Math.max(-80, Number(photo.layoutOffsetX))) : 0;
  const y = Number.isFinite(photo.layoutOffsetY) ? Math.min(80, Math.max(-80, Number(photo.layoutOffsetY))) : 0;
  return [width ? `width: ${width}%` : '', width ? 'justify-self: center' : '', x || y ? `transform: translate(${x}%, ${y}%)` : ''].filter(Boolean).join('; ');
};
const imageStyle = (photo) => {
  const aspect = Number(photo.aspect);
  return Number.isFinite(aspect) && aspect > 0 ? `aspect-ratio: ${aspect}; object-fit: cover;` : undefined;
};
---

<BaseLayout title={`${item.title} ${item.year} — ${site.name}`} description={item.description}>
  <article class="series-detail">
    <header class="series-detail__head page-shell">
      <a class="back-link" href="/series">← Series</a>
      <p class="eyebrow">Photo essay / {item.year || 'Ongoing'} / {items.length} photographs</p>
      <h1>{item.title}</h1>
      {item.description && <p class="series-detail__description">{item.description}</p>}
    </header>
    <div class="series-flow page-shell">
      {items.length ? items.map((photo, index) => (
        <figure
          class:list={["series-flow__item", `series-flow__item--${index % 4}`, `is-${photo.orientation}`]}
          style={layoutStyle(photo) || undefined}
        >
          <a href={`/photo/${photo.id}`}><img src={photo.image} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} style={imageStyle(photo)} /></a>
          <figcaption>{String(index + 1).padStart(2, '0')} / {photo.location}</figcaption>
        </figure>
      )) : <div class="series-detail__empty"><p>This series is waiting for its first photograph.</p></div>}
    </div>
    <footer class="series-detail__end page-shell">
      <p>End of series</p>
      <a class="text-link" href="/series">All series <span>↗</span></a>
    </footer>
  </article>
</BaseLayout>
