---
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Editor 登录</title></head>
  <body>
    <main>
      <h1>Editor 登录</h1>
      <form id="editor-login" method="post" action="/__editor/session">
        <label for="key">编辑口令</label>
        <input id="key" name="key" type="password" required autocomplete="current-password" />
        <p role="alert" id="login-error" hidden></p>
        <button type="submit">登录</button>
      </form>
    </main>
  </body>
</html>
<script>
  const form = document.querySelector<HTMLFormElement>('#editor-login');
  const feedback = document.querySelector<HTMLElement>('#login-error');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button');
    if (!button || !feedback) return;
    button.disabled = true;
    feedback.hidden = true;
    try {
      const response = await fetch('/__editor/session', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: new FormData(form).get('key') }),
      });
      if (response.ok) {
        const value = new URLSearchParams(window.location.search).get('next') ?? '';
        const next = URL.parse(value, window.location.origin);
        const destination = next?.origin === window.location.origin && next.pathname === '/editor/cloud-picker'
          ? `${next.pathname}${next.search}` : '/editor/';
        window.location.assign(destination);
        return;
      }
      const result = await response.json().catch(() => ({}));
      feedback.textContent = result.error || '登录失败，请重试。';
    } catch {
      feedback.textContent = '无法连接编辑器，请重试。';
    }
    feedback.hidden = false;
    button.disabled = false;
  });
</script>
<style>
  body { background: #f4f2ee; color: #171717; font-family: system-ui, sans-serif; margin: 0; }
  main { max-width: 24rem; margin: 12vh auto; padding: 1.5rem; }
  form { display: grid; gap: .8rem; }
  input, button { font: inherit; padding: .65rem; }
  button { background: #171717; color: white; border: 0; cursor: pointer; }
</style>
